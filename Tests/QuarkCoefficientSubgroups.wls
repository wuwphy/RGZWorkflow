   Copyright (C) 2026 Wan Wu and RGZWorkflow contributors. *)
project=DirectoryName[DirectoryName[$InputFileName]];
Get[FileNameJoin[{project,"RGZWorkflow.wl"}]];
RGZInitialize[FileNameJoin[{$TemporaryDirectory,"qq-subgroups-"<>CreateUUID[]}],"Display"->"Quiet"];
checks=<||>;record[n_,v_]:=(AssociateTo[checks,n->TrueQ[v]];Print[n," : ",TrueQ[v]]);
record["ExpandedEquivalentIsNotPropagated",RGZWorkflow`Private`qqCoefficientCompact[(x+y)^20,Expand[(x+y)^20]]===(x+y)^20];
record["ExactZeroAlwaysAccepted",RGZWorkflow`Private`qqCoefficientCompact[1/x-1/(x+1),0]===0];
dir=FileNameJoin[{$TemporaryDirectory,"qq-subnodes-"<>CreateUUID[]}];CreateDirectory[dir];
compactInput=(x+y)^20;compactKey=Hash[{"QQCoefficientChildren/1",compactInput},"SHA256"];
Export[FileNameJoin[{dir,"sub-"<>IntegerString[compactKey,16,64]<>".wxf"}],<|"Key"->compactKey,"Value"->Expand[compactInput]|>,"WXF"];
record["OldExpandedSubgroupCacheKeepsSmallerExactInput",RGZWorkflow`Private`qqCoefficientSubReduce[compactInput,dir]===compactInput];
pendingExpr=Total[Table[Unique["pending"],{5100}]];
Block[{RGZWorkflow`Private`$qqCoefficientBlockLeaves=10000,RGZWorkflow`Private`qqCoefficientRational},
 Clear[RGZWorkflow`Private`qqCoefficientRational];RGZWorkflow`Private`qqCoefficientRational[_]:=$TimedOut;
 pendingResult=RGZWorkflow`Private`qqCoefficientSubReduce[pendingExpr,dir]];
pendingFile=Lookup[RGZResult["QQProgress"],"PendingInputFile",""];
record["TimedOutMergeRetainsExactDiagnosticInput",pendingResult===$TimedOut&&FileExistsQ[pendingFile]&&Import[pendingFile,"WXF"]["Input"]===pendingExpr];
record["PendingInputCannotMasqueradeAsComplete",!FileExistsQ[StringDrop[pendingFile,-StringLength[".input.wxf"]]]];
fastDir=FileNameJoin[{dir,"fast"}];CreateDirectory[fastDir];
Block[{RGZWorkflow`Private`qqCoefficientSpectral,RGZWorkflow`Private`qqCoefficientRational},
 Clear[RGZWorkflow`Private`qqCoefficientSpectral,RGZWorkflow`Private`qqCoefficientRational];
 RGZWorkflow`Private`qqCoefficientSpectral[_]:=0;
 RGZWorkflow`Private`qqCoefficientRational[_]:=Failure["UnexpectedRecursiveDescent",<||>];
 fastResult=RGZWorkflow`Private`qqCoefficientSubReduce[pendingExpr,fastDir]];
record["SuccessfulDirectBlockSkipsRecursiveDescent",fastResult===0&&Length[Select[FileNames["sub-*.wxf",fastDir],!StringEndsQ[#,".input.wxf"]&]]===1];
Block[{RGZWorkflow`Private`qqCoefficientSpectral},Clear[RGZWorkflow`Private`qqCoefficientSpectral];
 RGZWorkflow`Private`qqCoefficientSpectral[_]:=Failure["MustReuse",<||>];
 record["DirectBlockCheckpointReused",RGZWorkflow`Private`qqCoefficientSubReduce[pendingExpr,fastDir]===0]];
continueDir=FileNameJoin[{dir,"continue"}];CreateDirectory[continueDir];attempt=0;
Block[{RGZWorkflow`Private`qqCoefficientSpectral,RGZWorkflow`Private`qqCoefficientRational},
 Clear[RGZWorkflow`Private`qqCoefficientSpectral,RGZWorkflow`Private`qqCoefficientRational];
 RGZWorkflow`Private`qqCoefficientSpectral[_]:=(attempt++;If[attempt===1,RGZWorkflow`Private`qqProgressUpdate[<|"NumeratorCoefficientTotal"->1|>];$TimedOut,0]);
 RGZWorkflow`Private`qqCoefficientRational[_]:=Failure["UnexpectedRecursiveDescent",<||>];
 continueResult=RGZWorkflow`Private`qqCoefficientSubReduce[pendingExpr,continueDir]];
record["CheckpointedNumeratorContinuesWithinOuterBudget",continueResult===0&&attempt===2];
expr=Total[Table[(x+y)^i/(x+i),{i,1,8}]];
Block[{RGZWorkflow`Private`$qqCoefficientBlockLeaves=15},
 leafDir=FileNameJoin[{dir,"leaf"}];CreateDirectory[leafDir];
 leafResult=RGZWorkflow`Private`qqCoefficientSubReduce[1/x+1/y,leafDir];
 record["TerminalSubgroupIsCheckpointed",Length[FileNames["sub-*.wxf",leafDir]]===1&&Cancel[Together[leafResult-1/x-1/y]]===0];
 record["TerminalSubgroupUpdatesOperation",StringStartsQ[Lookup[RGZResult["QQProgress"],"Operation",""],"Reduce coefficient subgroup"|"Reduce small rational coefficient"]];
 result=RGZWorkflow`Private`qqCoefficientSubReduce[expr,dir];
 record["SubgroupsPreserveRationalValue",Cancel[Together[result-expr]]===0];
 record["SubgroupsSaved",Length[FileNames["sub-*.wxf",dir]]>1];
 result2=RGZWorkflow`Private`qqCoefficientSubReduce[expr,dir];
 record["SubgroupsReused",result2===result&&Lookup[RGZResult["QQProgress"],"CoefficientSubReused",0]>0];
 radical=1/(x+I Sqrt[y])+1/(x-I Sqrt[y]);
 record["RadicalBranchesPreserved",Cancel[Together[RGZWorkflow`Private`qqCoefficientSubReduce[radical,dir]-radical]]===0];
 record["IntegerNegativePowersPreserved",Cancel[Together[RGZWorkflow`Private`qqCoefficientSubReduce[(1/x+1/y)^(-2),dir]-(1/x+1/y)^(-2)]]===0];
 restartDir=FileNameJoin[{dir,"restart"}];CreateDirectory[restartDir];
 DownValues[testAtomic]=DownValues[RGZWorkflow`Private`atomicWXF]/.RGZWorkflow`Private`atomicWXF->testAtomic;
 count=0;stop=Unique["testStop"];
 stopped=Block[{RGZWorkflow`Private`atomicWXF},Clear[RGZWorkflow`Private`atomicWXF];
 RGZWorkflow`Private`atomicWXF[f_,v_]:=Module[{r=testAtomic[f,v]},count++;If[count===2,Throw["Interrupted",stop]];r];
 Catch[RGZWorkflow`Private`qqCoefficientSubReduce[expr,restartDir],stop]];
 record["InterruptedInsideLargeGroup",stopped==="Interrupted"&&Length[FileNames["sub-*.wxf",restartDir]]===2];
 RGZWorkflow`Private`qqProgressUpdate[<|"CoefficientSubReused"->0|>];
 resumed=RGZWorkflow`Private`qqCoefficientSubReduce[expr,restartDir];
 record["InterruptedSubgroupsResumeExactly",resumed===result&&Lookup[RGZResult["QQProgress"],"CoefficientSubReused",0]>=1];
];
Print[<|"Passed"->Count[Values[checks],True],"Failed"->Count[Values[checks],False]|>];Exit[If[And@@Values[checks],0,1]];

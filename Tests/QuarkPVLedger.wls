project=DirectoryName[DirectoryName[$InputFileName]];Get[FileNameJoin[{project,"RGZWorkflow.wl"}]];
RGZInitialize[FileNameJoin[{$TemporaryDirectory,"rgz-loop-order-"<>CreateUUID[]}],"Display"->"Quiet"];
Quiet[RGZLoadFeynCalc[],FrontEndObject::notavail];
checks=<||>;record[n_,v_]:=(AssociateTo[checks,n->TrueQ[v]];Print[n," : ",TrueQ[v]]);
color=First[RGZWorkflow`Private`qqFFColors[]];
spin=FeynCalc`FCI[FeynCalc`SpinorUBarD[RGZWorkflow`Engine`qqK3,0].FeynCalc`GAD[testMu].FeynCalc`SpinorUD[RGZWorkflow`Engine`qqK1,0] FeynCalc`SpinorUBarD[RGZWorkflow`Engine`qqK4,0].FeynCalc`GAD[testMu].FeynCalc`SpinorUD[RGZWorkflow`Engine`qqK2,0]];
base=color spin;master=FeynCalc`C0[0,0,0,0,2,0];
RGZWorkflow`Private`storeResult["QQAmplitude",<|"Fingerprint"->"ledger-fixture","Amplitude"->base master,"OneLoop"->I base master,"Tree"->I base|>];
r=RGZQQFormFactors[120,"LoopOrder"->1,"ReduceTensorIntegrals"->True,"CoefficientSeconds"->10];ff=RGZResult["QQFormFactors"];
record["FormFactorsComplete",AssociationQ[r]&&ff["ReconstructionVerified"]];
groups=ff["PVReductionGroups"];record["BeforeIdentityRetained",MemberQ[groups[[1]]["Before"],{master,1}]];
record["AfterIdentityReduced",groups[[1]]["After"]==={{FeynCalc`A0[2],1/4}}];
r=RGZQQPVUVIRLedger[120,"CoefficientSeconds"->10];ledger=RGZResult["QQPVUVIRLedger"];
record["LedgerPublicComplete",AssociationQ[r]&&ledger["Status"]==="PVIdentityPoleLedger"];
record["RestoresUV",ledger["Rows"][[1]]["UVShift"]===-1/(2 FeynCalc`EpsilonUV)];
record["RestoresIR",ledger["Rows"][[1]]["IRShift"]===1/(2 FeynCalc`EpsilonIR)];
record["CombinedDRShiftZero",Expand[(ledger["Rows"][[1]]["UVShift"]+ledger["Rows"][[1]]["IRShift"])/.FeynCalc`EpsilonIR->FeynCalc`EpsilonUV]===0];
r=RGZQQPVUVIRLedger[120,"CoefficientSeconds"->10];record["CompletedGroupsReused",AssociationQ[r]&&RGZResult["QQPVUVIRLedger"]["Rows"]===ledger["Rows"]];
checkpoint=FileNameJoin[{StringDrop[ledger["File"],-4],"group-1.wxf"}];damaged=Import[checkpoint,"WXF"];damaged=Join[damaged,<|"Value"->Join[damaged["Value"],<|"UVShift"->TerminatedEvaluation[IterationLimit]|>]|>];Export[checkpoint,damaged,"WXF"];
r=RGZQQPVUVIRLedger[120,"CoefficientSeconds"->10];record["AbortedGroupCannotBeReused",AssociationQ[r]&&RGZResult["QQPVUVIRLedger"]["Rows"]===ledger["Rows"]];
record["NotFullCertification",ledger["ScalelessLedgerComplete"]===False&&ledger["UVIRSeparated"]===False&&ledger["AppliedToAmplitude"]===False];
RGZLoadFeynHelpers[];
RGZQQUVIRIntegral[FeynCalc`FAD[{q,0},{q,0},{q,Sqrt[2]}],q,120,"ImplicitPrefactor"->1/(I Pi^2)];raw=RGZResult["QQUVIRIntegral"];
record["IndependentRawIRAgrees",raw["IRPole"]===ledger["Rows"][[1]]["IRShift"]&&raw["UVPole"]===0];
RGZWorkflow`Private`storeResult["QQFormFactors",KeyDrop[ff,"PVReductionGroups"]];
record["OldProvenanceNotInvented",MatchQ[RGZQQPVUVIRLedger[30],Failure["QQPVProvenanceRequired",_]]];
RGZWorkflow`Private`storeResult["QQAmplitude",<|"Fingerprint"->"zero-reduced-ledger-fixture","Amplitude"->base (master-FeynCalc`A0[2]/4),"OneLoop"->I base (master-FeynCalc`A0[2]/4),"Tree"->I base|>];
r=RGZQQFormFactors[120,"LoopOrder"->1,"ReduceTensorIntegrals"->True,"CoefficientSeconds"->10];zeroFF=RGZResult["QQFormFactors"];
record["ZeroReducedGroupsRetained",zeroFF["Rows"]==={}&&Length[zeroFF["PVReductionGroups"]]===1];
r=RGZQQPVUVIRLedger[120,"CoefficientSeconds"->10];zeroLedger=RGZResult["QQPVUVIRLedger"];
record["ZeroDRStillHasSeparatePoles",AssociationQ[r]&&zeroLedger["Rows"][[1]]["UVShift"]===-1/(2 FeynCalc`EpsilonUV)&&zeroLedger["Rows"][[1]]["IRShift"]===1/(2 FeynCalc`EpsilonIR)];
Print[<|"Passed"->Count[Values[checks],True],"Failed"->Count[Values[checks],False]|>];Exit[If[And@@Values[checks],0,1]];

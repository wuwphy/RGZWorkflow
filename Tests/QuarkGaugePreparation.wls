project=DirectoryName[DirectoryName[$InputFileName]];Get[FileNameJoin[{project,"RGZWorkflow.wl"}]];
RGZInitialize[FileNameJoin[{$TemporaryDirectory,"qq-preparation-"<>CreateUUID[]}],"Display"->"Quiet"];
Quiet[RGZLoadFeynCalc[],FrontEndObject::notavail];
checks=<||>;record[n_,v_]:=(AssociateTo[checks,n->TrueQ[v]];Print[n," : ",TrueQ[v]]);
difference[x_]:=RGZWorkflow`Private`qqGaugeLinearDifference[x,alpha,1];
e=((1+alpha x)(z+alpha^2)/(y+alpha))+Sin[x]+(x+y)^100;
r=difference[e];
record["TelescopingDifferenceIsExact",Cancel[Together[r-(e-(e/.alpha->1))]]===0];
record["ReferenceDifferenceIsZero",Cancel[Together[r/.alpha->1]]===0];
record["DifferenceIsIdempotent",Cancel[Together[difference[r]-r]]===0];
record["GaugeIndependentLargeBlockIsRemoved",difference[(x+y)^10000]===0];
record["IndependentIntegralRemovedBeforeReduction",difference[FeynCalc`PaVe[1,1,{s,t,u},{a,b,c}]]===0];
record["TensorIndicesAreNotScalarPermuted",RGZWorkflow`Private`qqPVScalarCanonical[FeynCalc`PaVe[1,{s,t,u},{a,b,c}]]===FeynCalc`PaVe[1,{s,t,u},{a,b,c}]];
record["BubbleMassExchange",RGZWorkflow`Private`qqPVScalarCanonical[FeynCalc`B0[s,b,a]]===RGZWorkflow`Private`qqPVScalarCanonical[FeynCalc`B0[s,a,b]]];
Do[edges=RGZWorkflow`Private`qqPVEdges[n];mass=Reverse[Array[Symbol["ma"<>ToString[#]]&,n]];inv=Range[Length[edges]];mat=ConstantArray[0,{n,n}];
 Do[mat[[edges[[k,1]]+1,edges[[k,2]]+1]]=inv[[k]];mat[[edges[[k,2]]+1,edges[[k,1]]+1]]=inv[[k]],{k,Length[edges]}];
 make[per_]:=FeynCalc`PaVe[0,(mat[[per[[#[[1]]+1]],per[[#[[2]]+1]]]]& /@ edges),mass[[per]],FeynCalc`PaVeAutoOrder->False,FeynCalc`PaVeAutoReduce->False];
 canonical=RGZWorkflow`Private`qqPVScalarCanonical[make[Range[n]]];
 record["AllScalarPropagatorPermutationsN"<>ToString[n],AllTrue[Permutations[Range[n]],RGZWorkflow`Private`qqPVScalarCanonical[make[#]]===canonical&]];
 record["ScalarCanonicalizationIdempotentN"<>ToString[n],RGZWorkflow`Private`qqPVScalarCanonical[canonical]===canonical];,{n,{3,4,5}}];
Do[edges=RGZWorkflow`Private`qqPVEdges[n];inv=Range[Length[edges]];mass=Reverse[Range[n]+20];
 original=FeynCalc`PaVe[0,inv,mass,FeynCalc`PaVeAutoOrder->False,FeynCalc`PaVeAutoReduce->False];
 dest=RGZWorkflow`Private`qqPVParse[RGZWorkflow`Private`qqPVScalarCanonical[original]];xx=Array[Unique["parameter"]&,n];
 poly[kin_,masses_,xs_]:=Total[masses xs]-Total[MapThread[#1 xs[[#2[[1]]+1]] xs[[#2[[2]]+1]]&,{kin,edges}]];
 referencePoly=poly[inv,mass,xx];canonicalPoly=poly[dest[[2]],dest[[3]],xx];
 record["FeynmanParameterPolynomialPreservedN"<>ToString[n],AnyTrue[Permutations[Range[n]],Expand[referencePoly-(canonicalPoly/.Thread[xx->xx[[#]]])]===0&]],{n,{3,4,5}}];
called=0;Block[{RGZWorkflow`Private`qqFFBuild},Clear[RGZWorkflow`Private`qqFFBuild];RGZWorkflow`Private`qqFFBuild[___]:=(called++;Failure["MustSkipGaugeIndependentPV",<||>]);
 rr=RGZWorkflow`Private`qqGaugeDifferenceBuild[<|"Amplitude"->FeynCalc`PaVe[1,1,{s,t,u},{a,b,c}],"Gauge"->alpha|>,False,1,True,1]];
record["ZeroDifferenceSkipsTensorReduction",AssociationQ[rr]&&called===0&&RGZResult["QQFormFactors"]["Rows"]==={}];
record["GaugeDependentIntegralArgumentsCannotBeSampledAway",FailureQ[RGZWorkflow`Private`qqGaugeDifferenceBuild[<|"Amplitude"->FeynCalc`B0[s,alpha,b],"Gauge"->alpha|>,False,1,False,1]]];
basisPacket=<|"Amplitude"->alpha First[RGZWorkflow`Private`qqFFColors[]] FeynCalc`B0[s,a,b],"Gauge"->alpha,"RegulatorMass"->0|>;
firstBasis=RGZWorkflow`Private`qqGaugeDifferenceBuild[basisPacket,False,2,False,1];
record["CompletedScalarBasisCanBeIndexed",AssociationQ[firstBasis]&&RGZWorkflow`Private`qqGaugeScalarBasisQ[RGZResult["QQFormFactors"]]];
Block[{RGZWorkflow`Private`qqFFBuild},Clear[RGZWorkflow`Private`qqFFBuild];RGZWorkflow`Private`qqFFBuild[___]:=Failure["MustReuseAcrossBudgets",<||>];
 repeatedBasis=RGZWorkflow`Private`qqGaugeDifferenceBuild[basisPacket,False,5,False,1]];
record["CompletedScalarBasisReusedAcrossTimeLimits",AssociationQ[repeatedBasis]&&repeatedBasis["Status"]==="CompletedScalarBasisReused"];
record["UnreducedTensorBasisCannotUseTimeIndependentIndex",!RGZWorkflow`Private`qqGaugeScalarBasisQ[<|"Rows"->{<|"MasterCoefficients"->{{FeynCalc`PaVe[1,{s,t,u},{a,b,c}],1}}|>}|>]];
record["PreparationPatchInstalledOnce",Count[DownValues[RGZWorkflow`Private`qqGaugeCompare],HoldPattern[RGZWorkflow`Private`qqGaugeDifferenceBuild[___]],Infinity]===1];
Get[FileNameJoin[{project,"RGZWorkflow.wl"}]];
record["PreparationPatchRemainsIdempotentOnReload",Count[DownValues[RGZWorkflow`Private`qqGaugeCompare],HoldPattern[RGZWorkflow`Private`qqGaugeDifferenceBuild[___]],Infinity]===1];
Print[<|"Passed"->Count[Values[checks],True],"Failed"->Count[Values[checks],False]|>];Exit[If[And@@Values[checks],0,1]];

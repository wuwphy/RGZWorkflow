(* SPDX-License-Identifier: GPL-3.0-or-later *)
project=DirectoryName[DirectoryName[$InputFileName]];
Get[FileNameJoin[{project,"RGZWorkflow.wl"}]];
RGZInitialize[FileNameJoin[{$TemporaryDirectory,"rgz-weighted-identities-"<>CreateUUID[]}]];
RGZLoadFeynCalc[];
checks=<||>;rec[n_,v_]:=(AssociateTo[checks,n->TrueQ[v]];Print[n," ",TrueQ[v]]);
q=RGZWorkflow`Engine`q;p=RGZWorkflow`Engine`p;
P=FeynCalc`FCI[FeynCalc`SPD[p,q]];Q=FeynCalc`FCI[FeynCalc`SPD[q,q]];
Do[x=FeynCalc`FCI[FeynCalc`FAD[{q,masses[[1]]},{q-p,masses[[2]]}]] P^r Q^k;
 old=Block[{FeynCalc`$KeepLogDivergentScalelessIntegrals=False},FeynCalc`TID[x,q,FeynCalc`ToPaVe->True,FeynCalc`UsePaVeBasis->True,FeynCalc`ApartFF->False]];
 result=RGZWorkflow`Private`qqWeightedTryExactScalar[<|"Input"->x,"Result"->old|>];
 rec["BubbleIdentity"<>ToString[{masses,r,k},InputForm],AssociationQ[result]&&result["ExactSourceDifference"]===0],{masses,{{mA,mB},{0,mB},{mA,0},{0,0}}},{r,0,2},{k,0,2}];
Do[x=FeynCalc`FCI[FeynCalc`FAD[{q,mA}]] P^r Q^k;old=FeynCalc`TID[x,q,FeynCalc`ToPaVe->True,FeynCalc`UsePaVeBasis->True,FeynCalc`ApartFF->False];
 result=RGZWorkflow`Private`qqWeightedTryExactScalar[<|"Input"->x,"Result"->old|>];rec["TadpoleIdentity"<>ToString[{r,k},InputForm],AssociationQ[result]],{r,0,3},{k,0,2}];
x=FeynCalc`FCI[FeynCalc`FAD[{q,mA},{q+p,mB}]] P Q;
old=FeynCalc`TID[x,q,FeynCalc`ToPaVe->True,FeynCalc`UsePaVeBasis->True,FeynCalc`ApartFF->False];
rec["PositiveChordRouting",AssociationQ[RGZWorkflow`Private`qqWeightedTryExactScalar[<|"Input"->x,"Result"->old|>]]];
rec["DamagedSourceNotAccepted",MissingQ[RGZWorkflow`Private`qqWeightedTryExactScalar[<|"Input"->x,"Result"->old+1|>]]];
base=FeynCalc`FCI[FeynCalc`FAD[{q,mA},{q-p,mB}]];
rec["SquaredFDARejected",MissingQ[RGZWorkflow`Private`qqWeightedExactScalarInput[base^2]]];
rec["RepeatedPropagatorRejected",MissingQ[RGZWorkflow`Private`qqWeightedExactScalarInput[FeynCalc`FCI[FeynCalc`FAD[{q,mA},{q,mA},{q-p,mB}]]]]];
rec["InverseLoopNumeratorRejected",MissingQ[RGZWorkflow`Private`qqWeightedExactScalarInput[base/P]]];
rec["OpenLorentzNumeratorRejected",MissingQ[RGZWorkflow`Private`qqWeightedExactScalarInput[base FeynCalc`FCI[FeynCalc`FVD[q,mu]]]]];
FeynCalc`SPD[p,p]=0;
rec["ExceptionalInvariantRejected",MissingQ[RGZWorkflow`Private`qqWeightedExactScalarInput[base]]];FeynCalc`FCClearScalarProducts[];
rec["InvalidSourceRejected",MissingQ[RGZWorkflow`Private`qqWeightedTryExactScalar[<|"Input"->x,"Result"->$TimedOut|>]]];
Internal`InheritedBlock[{RGZWorkflow`Private`qqWeightedUnitShiftBeforeResume},Clear[RGZWorkflow`Private`qqWeightedUnitShiftBeforeResume];
 fallback=0;RGZWorkflow`Private`qqWeightedUnitShiftBeforeResume[_]:=(fallback++;Failure["FallbackUsed",<||>]);
 r=RGZWorkflow`Private`qqWeightedUnitShift[<|"Input"->base/P,"Result"->1|>];
 rec["UnsupportedCasesUseOriginalAudit",fallback===1&&MatchQ[r,Failure["FallbackUsed",_]]]];
Print[<|"Passed"->Count[Values[checks],True],"Failed"->Count[Values[checks],False]|>];Exit[If[AllTrue[Values[checks],TrueQ],0,1]];

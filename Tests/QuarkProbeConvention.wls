project=DirectoryName[DirectoryName[$InputFileName]];Get[FileNameJoin[{project,"RGZWorkflow.wl"}]];
RGZInitialize[FileNameJoin[{$TemporaryDirectory,"qq-probe-convention-test-"<>CreateUUID[]}],"Display"->"Quiet"];
checks=<||>;record[n_,v_]:=(AssociateTo[checks,n->TrueQ[v]];Print[n," : ",TrueQ[v]]);
Export[FileNameJoin[{RGZWorkflow`Private`dataDirectory[],"RGZ_all_raw.wxf"}],{testFixture},"WXF"];
a=Symbol["RGZWorkflow`Gauge`conventionTestAlpha"];
old=RGZWorkflow`Private`qqLegacyProbeFingerprint[a,0];
dir=FileNameJoin[{RGZWorkflow`Private`cacheDirectory[],"legacy"}];CreateDirectory[dir];
j=<|"Fingerprint"->old,"Gauge"->a,"RegulatorMass"->0,"Directory"->dir,"Tree"->2,"OnShellSigmaV"->3,"MixedSelfEnergy"->self[a],"SelfPrepared"->True,"Reduced"-><|"AV1"->5,"NAV1"->7|>|>;
Export[FileNameJoin[{dir,"AV2-reduced.wxf"}],<|"Fingerprint"->old,"Part"->"AV2","Expression"->11|>,"WXF"];
Export[FileNameJoin[{dir,"NAV2-reduced.wxf"}],<|"Fingerprint"->old,"Part"->"NAV2","Expression"->13|>,"WXF"];
RGZWorkflow`Private`storeResult["QQ",j];RGZWorkflow`Private`storeResult["QQGaugeEarly",<|"Old"->True|>];
r=RGZQQRepairProbeConvention[];p=RGZResult["QQ"];
record["KnownLegacyMigrated",AssociationQ[r]&&r["Status"]==="ProbeConventionRepaired"];
record["SelfEnergyUnchanged",p["MixedSelfEnergy"]===self[a]&&TrueQ[p["SelfPrepared"]]];
record["TreeAndResidueUnchanged",p["Tree"]===2&&p["OnShellSigmaV"]===3];
record["EvenVertexGraphsPreserved",p["Reduced"]["AV1"]===5&&p["Reduced"]["AV2"]===11];
record["OnlyOddVertexNAVReversed",p["Reduced"]["NAV1"]===-7&&p["Reduced"]["NAV2"]===-13];
record["OldSourcePreserved",Import[FileNameJoin[{dir,"NAV2-reduced.wxf"}],"WXF"]["Expression"]===13];
record["NewFingerprintInstalled",p["Fingerprint"]===RGZWorkflow`Private`qqJobFingerprint[a,0]&&p["Fingerprint"]=!=old];
record["DerivedComparisonsInvalidated",MissingQ[RGZResult["QQGaugeEarly"]]];
record["NoGaugeProofSet",p["GaugeIndependenceVerified"]===False];
r=RGZQQRepairProbeConvention[];
record["MigrationIdempotent",AssociationQ[r]&&RGZResult["QQ"]["Reduced"]["NAV1"]===-7];
RGZWorkflow`Private`storeResult["QQ",j];RGZWorkflow`Private`storeResult["QQGaugeEarly",oldProof];
r=RGZQQRepairProbeConvention[];
record["ExistingTargetReuseClearsStaleProof",AssociationQ[r]&&TrueQ[r["Reused"]]&&MissingQ[RGZResult["QQGaugeEarly"]]];
RGZWorkflow`Private`storeResult["QQ",Join[j,<|"Fingerprint"->123|>]];
record["UnknownFingerprintRejected",MatchQ[RGZQQRepairProbeConvention[],Failure["QQUnknownLegacyProbe",_]]];
RGZWorkflow`Private`storeResult["QQ",Join[j,<|"SelfPrepared"->False|>]];
record["IncompleteSelfNotMigrated",MatchQ[RGZQQRepairProbeConvention[],Failure["QQCompleteLegacySelfRequired",_]]];
Print[<|"Passed"->Count[Values[checks],True],"Failed"->Count[Values[checks],False]|>];Exit[If[And@@Values[checks],0,1]];

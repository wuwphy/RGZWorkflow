project=DirectoryName[DirectoryName[$InputFileName]];
Get[FileNameJoin[{project,"RGZWorkflow.wl"}]];
RGZInitialize[FileNameJoin[{$TemporaryDirectory,"rgz-diagnostics-"<>CreateUUID[]}]];
checks=<||>;rec[n_,v_]:=AssociateTo[checks,n->TrueQ[v]];
rec["RunnerInstalledWithoutEvaluatingNotebook",Length[DownValues[Global`rgzDiagnosticRun]]>0&&MemberQ[Attributes[Global`rgzDiagnosticRun],HoldRest]];
r=Global`rgzDiagnosticRun["StartupFixture",<|"Status"->"Complete"|>];
rec["RunnerWorksWithoutHelperCell",AssociationQ[r]&&TrueQ[Global`rgzDiagnosticState["StartupFixture"]]];
fp=RGZWorkflow`Private`workflowFingerprint[];
state=RGZWorkflow`Private`$results;
weighted=DownValues[RGZQQWeightedUVIRLedger];weightedSHA=RGZWorkflow`Private`$weightedLedgerSHA256;
Get[FileNameJoin[{project,"Tools","DiagnosticsCompatibility.wl"}]];
rec["PhysicalFingerprintUnchanged",fp===RGZWorkflow`Private`workflowFingerprint[]];
rec["LiveResultsUnchanged",state===RGZWorkflow`Private`$results];
rec["ReloadIsIdempotent",weighted===DownValues[RGZQQWeightedUVIRLedger]&&weightedSHA===RGZWorkflow`Private`$weightedLedgerSHA256];
a=<|"Record"-><|"a"-><|"Status"->"Complete"|>|>,"Fingerprint"->123|>;
b=RGZWorkflow`Private`qqDiagnosticsManifest[a];
rec["CanonicalFieldAliased",b["Records"]===a["Record"]&&KeyDrop[b,"Records"]===a];
rec["LegacyAliasRetained",RGZWorkflow`Private`qqDiagnosticsManifest[<|"Records"->a["Record"]|>]===(<|"Records"->a["Record"]|>)];
rec["ConflictingAliasesRejected",FailureQ[RGZWorkflow`Private`qqDiagnosticsManifest[Join[a,<|"Records"-><||>|>]]]];
src=FileNameJoin[{RGZWorkflow`Private`cacheDirectory[],"source.wxf"}];Export[src,<|"Original"->True|>,"WXF"];
file=FileNameJoin[{RGZWorkflow`Private`cacheDirectory[],"scalar.wxf"}];
p=<|"Schema"->"RGZQQFormFactors/1","Status"->"ScalarPVCollected","Key"->17,"File"->file,"InputSHA256"->31,"SourceFingerprint"->23,"LoopOrder"->1,"ReconstructionVerified"->True,"ColorBasis"->{color},"SpinStructures"->{spin},"Rows"->{<|"ColorID"->1,"SpinID"->1,"MasterCoefficients"->{{1,7}},"FormFactor"->7|>},"PVIdentities"->{1->{{1,1}}},"AlgorithmSHA256"->RGZWorkflow`Private`$scalarFFSourceSHA256,"SourceFormFactorsFile"->src,"SourceFormFactorsSHA256"->FileHash[src,"SHA256"]|>;
Export[file,p,"WXF"];
rec["ScalarStatusAcceptedWithPayloadChecks",TrueQ[RGZWorkflow`Private`qqDiagnosticsFFPacketQ[p]]];
rec["ScalarExplicitReaderAccepts",AssociationQ[RGZWorkflow`Private`qqUVIRReadFF[file]]];
rec["ScalarOriginalFileUnchanged",Import[file,"WXF"]===p];
rec["UnknownStatusRejected",!TrueQ[RGZWorkflow`Private`qqDiagnosticsFFPacketQ[Join[p,<|"Status"->"Stopped"|>]]]];
rec["MissingRowsRejected",!TrueQ[RGZWorkflow`Private`qqDiagnosticsFFPacketQ[KeyDrop[p,"Rows"]]]];
rec["FalseReconstructionRejected",!TrueQ[RGZWorkflow`Private`qqDiagnosticsFFPacketQ[Join[p,<|"ReconstructionVerified"->False|>]]]];
rec["StaleAlgorithmRejected",!TrueQ[RGZWorkflow`Private`qqDiagnosticsFFPacketQ[Join[p,<|"AlgorithmSHA256"->0|>]]]];
rec["DamagedCoefficientRejected",!TrueQ[RGZWorkflow`Private`qqDiagnosticsFFPacketQ[Join[p,<|"Rows"->{<|"ColorID"->1,"SpinID"->1,"MasterCoefficients"->{{1,7}},"FormFactor"->8|>}|>]]]];
rec["TerminationRejected",!TrueQ[RGZWorkflow`Private`qqDiagnosticsFFPacketQ[Join[p,<|"Rows"->{<|"ColorID"->1,"SpinID"->1,"MasterCoefficients"->{{1,$TimedOut}},"FormFactor"->$TimedOut|>}|>]]]];
Export[src,<|"Changed"->True|>,"WXF"];
rec["ChangedSourceDigestRejected",!TrueQ[RGZWorkflow`Private`qqDiagnosticsFFPacketQ[p]]];
manifest=FileNameJoin[{RGZWorkflow`Private`cacheDirectory[],"matrix_job.wl"}];
records=AssociationThread[ToString/@Range[256],ConstantArray[<|"Status"->"Complete","PerDiagramCache"->RGZWorkflow`Private`cacheDirectory[]|>,256]];
Put[<|"Record"->records|>,manifest];
Internal`InheritedBlock[{RGZWorkflow`Private`fcReady},Clear[RGZWorkflow`Private`fcReady];RGZWorkflow`Private`fcReady[]:=True;
 r=RGZQQMixedUVIRLedger[1,"MatrixManifest"->manifest];
 rec["Native256RecordManifestReachesPreTIDValidation",MatchQ[r,Failure["QQMixedPreTIDInputsRequired",_]]];
 Put[<|"Record"->KeyDrop[records,"1"]|>,manifest];
 rec["IncompleteManifestStillRejected",MatchQ[RGZQQMixedUVIRLedger[1,"MatrixManifest"->manifest],Failure["QQMixedManifestIncomplete",_]]];
];
printed={};Block[{Print=Function[x,AppendTo[printed,x]]},RGZReport[<|"Scheme"->"MSbar","ParameterCounterterms"-><|"g_s"->1|>|>]];
rec["CountertermsVisible",Length[printed]===1&&KeyExistsQ[First[printed],"ParameterCounterterms"]];
Print[checks];Exit[If[AllTrue[Values[checks],TrueQ],0,1]];

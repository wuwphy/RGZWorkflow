project=DirectoryName[DirectoryName[$InputFileName]];Get[FileNameJoin[{project,"RGZWorkflow.wl"}]];
RGZInitialize[FileNameJoin[{$TemporaryDirectory,"rgz-msbar-tests-"<>CreateUUID[]}],"Display"->"Quiet"];RGZLoadFeynCalc[];
checks=<||>;record[n_,v_]:=(AssociateTo[checks,n->TrueQ[v]];Print[n," : ",TrueQ[v]]);
q=RGZWorkflow`Engine`q;k=RGZWorkflow`Engine`qqK1;p=RGZWorkflow`Engine`qqK3-k;
record["VacuumDoublePoleDetected",RGZWorkflow`Private`qqMSbarZeroScaleQ[FeynCalc`FCI[FeynCalc`FAD[{q,0},{q,0}]]]];
record["LightlikeBubbleDetected",RGZWorkflow`Private`qqMSbarZeroScaleQ[FeynCalc`FCI[FeynCalc`FAD[{q,0},{q-k,0}]]]];
record["OppositeRouteSignsDetected",RGZWorkflow`Private`qqMSbarZeroScaleQ[FeynCalc`FCI[FeynCalc`FAD[{q,0},{-q+k,0}]]]];
record["OffshellBubbleExcluded",!RGZWorkflow`Private`qqMSbarZeroScaleQ[FeynCalc`FCI[FeynCalc`FAD[{q,0},{q+p,0}]]]];
record["MassiveTadpoleExcluded",!RGZWorkflow`Private`qqMSbarZeroScaleQ[FeynCalc`FCI[FeynCalc`FAD[{q,mm}]]]];
record["NoDenominatorExcluded",!RGZWorkflow`Private`qqMSbarZeroScaleQ[FeynCalc`FCI[FeynCalc`SPD[q,q]]]];
c=RGZQQMSbarCounterterms["ClosedQuarkFlavors"->0];a=FeynCalc`SUNN FeynCalc`SMP["g_s"]^2 FeynCalc`SMP["Delta_UV"]/(16Pi^2);
zG=-11a/6;zA=13a/6;zGam=-zG/2-zA/4;
record["HorizonMassMapping",Cancel[c["ParameterCounterterms"]["mG^4"]/(RGZWorkflow`Engine`mG^4)-(2zG+2zGam)]===0];
record["CondensateRelations",Cancel[c["ParameterCounterterms"]["m^2"]/RGZWorkflow`Engine`m^2-zG+zA/2]===0&&Cancel[c["ParameterCounterterms"]["mu^2"]/RGZWorkflow`Engine`\[Mu]^2-zG-zA/2]===0];
record["NoKinematicFit",FreeQ[c["ParameterCounterterms"],RGZWorkflow`Engine`qqT|RGZWorkflow`Engine`qqS|FeynCalc`EpsilonIR]&&c["DerivedByFitting"]===False];
record["FiniteMasslessBubble",RGZWorkflow`Private`qqMSbarFiniteMaster[FeynCalc`B0[-ss,0,0],scale]===2-Log[ss/scale]];
record["FiniteComplexTadpoleBranchPreserved",RGZWorkflow`Private`qqMSbarFiniteMaster[FeynCalc`A0[2+3I],scale]===(2+3I)(1-Log[(2+3I)/scale])];
record["MultiscaleMasterRetained",RGZWorkflow`Private`qqMSbarFiniteMaster[FeynCalc`C0[0,0,tt,0,0,zz],scale]===RGZPVFinite[FeynCalc`C0[0,0,tt,0,0,zz],scale]];
b=FeynCalc`B0[-ss,0,0];table=<|b-><|"UV"->-2/(D-4),"IR"->0|>|>;
f=RGZWorkflow`Private`qqMSbarFiniteRow[{{b,1/(D-1)}},table,scale,10];
record["EpsilonTimesPoleRationalTermRetained",f["DimensionalRationalPart"]===2/9];
record["FiniteCoefficientValue",Expand[f["FiniteFormFactor"]-((2-Log[ss/scale])/3+2/9)]===0];
f=RGZWorkflow`Private`qqMSbarFiniteRow[{{1,7},{b,3}},table,scale,10];record["LoopRationalTermNotTree",Expand[f["FiniteFormFactor"]-(13-3Log[ss/scale])]===0];
record["UnsupportedGaugeRejected",MatchQ[RGZWorkflow`Private`qqMSbarJob["absent.wxf"],_Failure]];
record["MissingInputsRejected",MatchQ[RGZQQMSbar[10],Failure["QQMSbarPrerequisites",_]]];
record["NonpositiveScaleRejected",MatchQ[RGZQQMSbar[10,"RenormalizationScaleSquared"->0],Failure["QQMSbarArguments",_]]];
(* Public fail-closed boundaries, before an arbitrary report can reach CT projection. *)
aa=<|"Gauge"->0,"RegulatorMass"->0,"AssemblyConvention"->"QQPhysicalLoopMeasure/1","Fingerprint"->1,"OneLoop"->1,"Tree"->1,"JacobianGhostIncluded"->True,"ClosedQuarkFlavors"->2,"ModelFingerprint"->RGZWorkflow`Private`modelKey[],"ModelContent"->RGZWorkflow`Private`modelContent[]|>;
uu=<|"CompleteRepresentedUV"->True,"CompleteRepresentedIR"->True,"MasterPoles"-><||>,"Rows"->{},"ColorBasis"->{},"SpinStructures"->{},"FormFactorsFile"->"absent.wxf","InputSHA256"->Hash[1/I,"SHA256"],"SourceFingerprint"->2,"Key"->1|>;
ledger=<|"CoreScanComplete"->True,"Parts"->{},"UVShiftFormFactors"-><||>,"SourceFingerprint"->1|>;
adir=RGZWorkflow`Private`dataDirectory[];af=FileNameJoin[{adir,"test-amplitude.wxf"}];uf=FileNameJoin[{adir,"test-uvir.wxf"}];lf=FileNameJoin[{adir,"test-ledger.wxf"}];Export[uf,uu,"WXF"];Export[lf,ledger,"WXF"];Export[af,aa,"WXF"];
record["DifferentSourceRefused",MatchQ[RGZQQMSbar[10,"AmplitudeFile"->af,"UVIRFile"->uf,"ScalelessLedgerFile"->lf],Failure["QQMSbarSourceMismatch",_]]];
Export[af,Join[aa,<|"Gauge"->1|>],"WXF"];record["GeneralGaugeNotPretendedImplemented",MatchQ[RGZQQMSbar[10,"AmplitudeFile"->af,"UVIRFile"->uf,"ScalelessLedgerFile"->lf],Failure["QQMSbarLandauM0Only",_]]];
Export[af,Join[aa,<|"JacobianGhostIncluded"->False|>],"WXF"];record["LegacyMissingJacobianRefused",MatchQ[RGZQQMSbar[10,"AmplitudeFile"->af,"UVIRFile"->uf,"ScalelessLedgerFile"->lf],Failure["QQCompletedModelRequired",_]]];
Export[af,aa,"WXF"];Export[uf,KeyDrop[uu,"MasterPoles"],"WXF"];record["IncompletePolePacketRefused",MatchQ[RGZQQMSbar[10,"AmplitudeFile"->af,"UVIRFile"->uf,"ScalelessLedgerFile"->lf],Failure["QQMSbarPrerequisites",_]]];
(* A subset can renumber colors: semantic keys must survive that change. *)
mapA=RGZWorkflow`Private`qqMSbarMap[<|"ColorBasis"->{ccA,ccB},"SpinStructures"->{sp},"Rows"->{<|"ColorID"->2,"SpinID"->1,"FormFactor"->7|>}|>];
mapB=RGZWorkflow`Private`qqMSbarMap[<|"ColorBasis"->{ccB},"SpinStructures"->{sp},"Rows"->{<|"ColorID"->1,"SpinID"->1,"FormFactor"->7|>}|>];
record["ColorSubsetRenumberingInvariant",mapA===mapB];
record["DifferentColorsNeverConflated",RGZWorkflow`Private`qqMSbarLookup[mapB,ccA,sp]===0&&RGZWorkflow`Private`qqMSbarLookup[mapB,ccB,sp]===7];
complete=<|"Key"->123,"ClosedQuarkFlavors"->2,"PostprocessingJacobianInsertions"->0,"MSbarUVClosed"->True,"IRPolesCancelled"->True,"FinitePartBuilt"->True,"JacobianGhostIncluded"->True,"Rows"->{<|"RemainingUVPole"->0,"RemainingIRPole"->0,"FiniteFormFactor"->xx|>},"TreeAmplitude"->tree,"OneLoopFiniteAmplitude"->loop,"Amplitude"->tree+loop|>;
record["CompleteFiniteCacheReusable",RGZWorkflow`Private`qqMSbarReusableQ[complete,123,True,1]];
record["ExtraJacobianInsertionNotReusable",!RGZWorkflow`Private`qqMSbarReusableQ[Join[complete,<|"PostprocessingJacobianInsertions"->1|>],123,True,1]];
record["ChangedSourceKeyNotReusable",!RGZWorkflow`Private`qqMSbarReusableQ[complete,124,True,1]];
record["IncompleteRowCountNotReusable",!RGZWorkflow`Private`qqMSbarReusableQ[complete,123,True,2]];
record["InterruptedFiniteCacheNotReusable",!RGZWorkflow`Private`qqMSbarReusableQ[Join[complete,<|"OneLoopFiniteAmplitude"->$Aborted|>],123,True,1]];
record["TreeDoubleCountNotReusable",!RGZWorkflow`Private`qqMSbarReusableQ[Join[complete,<|"Amplitude"->2tree+loop|>],123,True,1]];
record["MissingFiniteRowNotReusable",!RGZWorkflow`Private`qqMSbarReusableQ[Join[complete,<|"Rows"->{<|"RemainingUVPole"->0,"RemainingIRPole"->0|>}|>],123,True,1]];
two=RGZQQMSbarCounterterms[];base=FeynCalc`SMP["g_s"]^2 FeynCalc`SMP["Delta_UV"]/(16Pi^2);
record["DefaultTwoDynamicalFlavors",two["ClosedQuarkFlavors"]===2&&two["Quenched"]===False];
record["QuarkBetaFunctionShift",Cancel[(two["ParameterCounterterms"]["g_s"]-c["ParameterCounterterms"]["g_s"])/FeynCalc`SMP["g_s"]-2base/3]===0];
record["QuarkMassCountertermShift",Cancel[(two["ParameterCounterterms"]["m^2"]-c["ParameterCounterterms"]["m^2"])/RGZWorkflow`Engine`m^2-4base/3]===0];
record["AuxiliaryMassNoQuarkShift",Cancel[two["ParameterCounterterms"]["mu^2"]-c["ParameterCounterterms"]["mu^2"]]===0];
record["NoPostprocessingJacobianFunction",DownValues[RGZWorkflow`Private`qqMSbarJacobianTerm]==={}];
fBorn=(tt-RGZWorkflow`Engine`\[Mu]^2)/((tt-RGZWorkflow`Engine`m^2)(tt-RGZWorkflow`Engine`\[Mu]^2)+RGZWorkflow`Engine`mG^4);
ctDifference=AssociationMap[two["ParameterCounterterms"][#]-c["ParameterCounterterms"][#]&,Keys[c["ParameterCounterterms"]]];
quarkCT=RGZWorkflow`Private`qqLocalParameterCT[FeynCalc`SMP["g_s"]^2 fBorn,ctDifference];
quarkLoopUV=-FeynCalc`SMP["g_s"]^2 fBorn (4/3) base tt fBorn;
record["TwoFlavorNativeBubbleUVMatchesLocalCT",Cancel[Together[quarkCT+quarkLoopUV]]===0];
(* Independent tensor reduction of the derivative ghost loop; no fitted UV coefficient. *)
FeynCalc`SPD[pp,pp]=ss;
x=FeynCalc`FCI[FeynCalc`FVD[ll,mu] FeynCalc`FVD[ll+pp,nu] FeynCalc`FAD[{ll,0},{ll+pp,0}]];
t=FeynCalc`Contract[FeynCalc`TID[x,ll,FeynCalc`ToPaVe->True,FeynCalc`UsePaVeBasis->True] FeynCalc`FCI[FeynCalc`MTD[mu,nu]-FeynCalc`FVD[pp,mu] FeynCalc`FVD[pp,nu]/ss]]/(D-1);
t=RGZWorkflow`Private`qqFFPVNormalize[t,True,10];
record["IndependentGhostTensorProjection",Cancel[Together[t+I Pi^2 ss/(4(D-1)) FeynCalc`B0[ss,0,0]]]===0];
RGZLoadFeynHelpers[];
pv=FeynCalc`PaXEvaluate[FeynCalc`A0[2],FeynCalc`PaXImplicitPrefactor->1,FeynCalc`FCVerbose->0];
raw=FeynCalc`PaXEvaluate[FeynCalc`FAD[{ll,Sqrt[2]}],ll,FeynCalc`PaXImplicitPrefactor->1/(2Pi)^(4-2FeynCalc`Epsilon),FeynCalc`FCVerbose->0];
record["DimensionalMeasureFiniteShift",FullSimplify[16Pi^2 raw/I-pv-4Log[2Pi]]===0];
record["MSbarConstantFromPVConvention",FullSimplify[-EulerGamma-Log[Pi]+2Log[2Pi]-(-EulerGamma+Log[4Pi])]===0];
Print[<|"Passed"->Count[Values[checks],True],"Failed"->Count[Values[checks],False]|>];Exit[If[And@@Values[checks],0,1]];

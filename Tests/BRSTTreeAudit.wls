   Copyright (C) 2026 Wan Wu and RGZWorkflow contributors. *)
Begin["RGZBRSTAudit`"];
projectPath=DirectoryName[DirectoryName[$InputFileName]];
checks=<||>; record[n_,v_]:=(AssociateTo[checks,n->TrueQ[v]];Print[n," : ",checks[n]]);
z[x_]:=TrueQ[Cancel[Together[x]]===0];
s=q^2;t=s-u2;Q=s^2+alpha r4;delta=(s-m2)(s-u2)+4h^2;
KT={{m2-s,h,h,-h,-h},{h,0,t,0,0},{h,t,0,0,0},{-h,0,0,0,t},{-h,0,0,t,0}};
KL={{m2,I q,-I q,I m2 q,h,h,-h,-h},{-I q,alpha,0,0,0,0,0,0},{I q,0,0,-s,0,0,0,0},{-I m2 q,0,-s,m2 s-r4,-I h q,-I h q,I h q,I h q},{h,0,0,I h q,0,t,0,0},{h,0,0,I h q,t,0,0,0},{-h,0,0,-I h q,0,0,0,t},{-h,0,0,-I h q,0,0,t,0}};
DT=Map[Cancel,I Inverse[KT],{2}];DL=Map[Cancel,I Inverse[KL],{2}];
record["InverseT",And@@(z/@Flatten[KT.DT-I IdentityMatrix[5]])];
record["InverseL",And@@(z/@Flatten[KL.DL-I IdentityMatrix[8]])];
record["MomentumReversal",KL===Transpose[KL/.q->-q]];
expectedT=ConstantArray[0,{5,5}]; signs={1,1,-1,-1};
expectedT[[1,1]]=-I t/delta;
Do[expectedT[[1,j+1]]=expectedT[[j+1,1]]=I signs[[j]] h/delta,{j,4}];
Do[expectedT[[i+1,j+1]]=-I signs[[i]]signs[[j]]h^2/(t delta)+If[MemberQ[{{1,2},{2,1},{3,4},{4,3}},{i,j}],I/t,0],{i,4},{j,4}];
record["All25TransverseEntries",And@@(z/@Flatten[DT-expectedT])];
expectedL=ConstantArray[0,{8,8}];
expectedL[[1,1]]=-I alpha s/Q;
expectedL[[1,2]]=-s q/Q;expectedL[[2,1]]=s q/Q;
expectedL[[1,3]]=alpha r4 q/(s Q);expectedL[[3,1]]=-alpha r4 q/(s Q);
expectedL[[1,4]]=-alpha q/Q;expectedL[[4,1]]=alpha q/Q;
expectedL[[2,2]]=I r4/Q;
expectedL[[2,3]]=expectedL[[3,2]]=I r4/Q;
expectedL[[2,4]]=expectedL[[4,2]]=-I s/Q;
expectedL[[3,3]]=I(-m2/s+r4/Q+4h^2/(s t));
expectedL[[3,4]]=expectedL[[4,3]]=-I s/Q;
expectedL[[4,4]]=-I alpha/Q;
Do[expectedL[[j+4,3]]=-signs[[j]] h q/(s t);expectedL[[3,j+4]]=signs[[j]] h q/(s t),{j,4}];
expectedL[[5,6]]=expectedL[[6,5]]=expectedL[[7,8]]=expectedL[[8,7]]=I/t;
record["All64LongitudinalEntries",And@@(z/@Flatten[DL-expectedL])];
constraint={-I q,0,0,s,0,0,0,0};
record["MultiplierContact",And@@(z/@(constraint.DL+I UnitVector[8,3]))];
record["AhLongitudinalVariance",z[({1,0,0,I q,0,0,0,0}.DL.{1,0,0,-I q,0,0,0,0})]];
record["GaugeLimitM0",z[(DL[[1,1]]/.r4->0)+I alpha/s]];
euclideanFields=DiagonalMatrix[{I,I,-1,1,I,I,I,I}];
KE=-euclideanFields.(KL/.q->I qe).euclideanFields;
DE=Map[Cancel,Inverse[KE],{2}];
sE=qe^2; QE=sE^2+alpha r4;
correctE=-m2/sE-r4/QE-4h^2/(sE(sE+u2));
printedE=-(m2(sE^2-alpha r4)+r4 sE)/(sE QE)+4h^2/(sE(sE+u2));
record["EuclideanTauFromWickKernel",z[DE[[3,3]]-correctE]];
record["PaperA22NotInverse",!z[DE[[3,3]]-printedE]];
Print["CorrectEuclideanTauTau = ",InputForm[correctE]];
Print["PrintedA22MinusCorrect = ",InputForm[Cancel[Together[printedE-correctE]]]];
actual=Import[FileNameJoin[{projectPath,"Work","Data","Tree.wxf"}],"WXF"];
convert[expr_]:=expr/.a_Symbol /; Context[a]==="RGZWorkflow`Engine`" :> Switch[SymbolName[a],"s",q^2,"m02",m2,"mu2",u2,"mg2",2h,"M4",r4,"\[Alpha]",alpha,"Nc",nc,_,a];
redef=DiagonalMatrix[{1,1,-1,1,1,1,1,1}];
record["FRTransverseEqualsPDF",And@@(z/@Flatten[convert[actual["KT"]]-KT])];
record["FRLongitudinalEqualsPDFWithTauReversal",And@@(z/@Flatten[redef.(convert[actual["KL"]]/.Sqrt[q^2]->q).redef-KL])];
Print["ActualKT = ",InputForm[convert[actual["KT"]]]];
Print["ActualKL = ",InputForm[convert[actual["KL"]]]];
Print[<|"Passed"->Count[Values[checks],True],"Failed"->Count[Values[checks],False]|>];
End[];
Exit[If[And@@Values[RGZBRSTAudit`checks],0,1]];

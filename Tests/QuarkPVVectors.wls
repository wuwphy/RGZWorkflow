project=DirectoryName[DirectoryName[$InputFileName]];
Get[FileNameJoin[{project,"RGZWorkflow.wl"}]];
RGZInitialize[FileNameJoin[{$TemporaryDirectory,"qq-pv-vectors-"<>CreateUUID[]}],"Display"->"Quiet"];
Quiet[RGZLoadFeynCalc[],FrontEndObject::notavail];
checks=<||>;record[n_,v_]:=(AssociateTo[checks,n->TrueQ[v]];Print[n," : ",TrueQ[v]]);
expr=(u+v)^50 (FeynCalc`PaVe[0,0,{s},{a,b}]+FeynCalc`B1[s,a,b])+7 FeynCalc`B0[s,a,b]+3;
raw=RGZWorkflow`Private`qqFFCollectMasters[expr,False,5];
result=RGZWorkflow`Private`qqFFReduceMasterPairs[raw,True,False,5];
old=RGZWorkflow`Private`qqFFPrepareMasters[expr,True,5];
record["LinearVectorTransformationMatchesSubstitution",Expand[Total[Times@@@result]-old]===0];
record["LargeScalarBlockRemainsFactored",!FreeQ[result,Power[u+v,50]]];
record["ScalarRemainderPreserved",MemberQ[result,{1,3}]];
record["NoTensorCoefficients",FreeQ[result,FeynCalc`PaVe[0,0,___]|FeynCalc`B1]];
Block[{RGZWorkflow`Private`qqFFPVNormalize},Clear[RGZWorkflow`Private`qqFFPVNormalize];
 RGZWorkflow`Private`qqFFPVNormalize[___]:=Failure["ShouldNotRecompute",<||>];
 repeat=RGZWorkflow`Private`qqFFReduceMasterPairs[raw,True,False,5];
 record["CompletedIdentityVectorsReused",repeat===result]];
record["EmptyVector",RGZWorkflow`Private`qqFFReduceMasterPairs[{},True,False,5]==={}];
record["RationalOnlyVector",RGZWorkflow`Private`qqFFReduceMasterPairs[{{1,(u+v)^50}},False,False,5]==={{1,(u+v)^50}}];
record["ZeroCoefficientDropped",RGZWorkflow`Private`qqFFReduceMasterPairs[{{1,0}},False,False,5]==={}];
newMaster=FeynCalc`B0[newS,newA,newB];calls=0;
Block[{RGZWorkflow`Private`qqFFPVNormalize,RGZWorkflow`Private`qqFFPVCache=<||>},Clear[RGZWorkflow`Private`qqFFPVNormalize];
 RGZWorkflow`Private`qqFFPVNormalize[m_,___]:=(calls++;m);
 RGZWorkflow`Private`qqFFReduceMasterPairs[{{newMaster,1}},True,False,5];
 RGZWorkflow`Private`qqFFReduceMasterPairs[{{newMaster,1}},True,False,5];
 record["IncompleteNormalizationNotCheckpointedAsCompleted",calls===2]];
Block[{RGZWorkflow`Private`qqFFPVNormalize},Clear[RGZWorkflow`Private`qqFFPVNormalize];
 RGZWorkflow`Private`qqFFPVNormalize[___]:=$Aborted;
 record["InvalidTransformationRejected",FailureQ[RGZWorkflow`Private`qqFFReduceMasterPairs[{{newMaster,1}},True,False,5]]]];
record["PVProgressAvailable",KeyExistsQ[RGZResult["QQProgress"],"PVIndex"]];
colour=First[RGZWorkflow`Private`qqFFColors[]];
spin=FeynCalc`FCI[FeynCalc`SpinorUBarD[RGZWorkflow`Engine`qqK3,0].FeynCalc`GAD[testMu].FeynCalc`SpinorUD[RGZWorkflow`Engine`qqK1,0]
 FeynCalc`SpinorUBarD[RGZWorkflow`Engine`qqK4,0].FeynCalc`GAD[testMu].FeynCalc`SpinorUD[RGZWorkflow`Engine`qqK2,0]];
packet=<|"Amplitude"->colour spin FeynCalc`B0[s,a,b],"Fingerprint"->"vector-group-test"|>;
built=RGZWorkflow`Private`qqFFBuild[packet,False,5,False];savedFF=RGZResult["QQFormFactors"];
DeleteFile[savedFF["File"]];
Block[{RGZWorkflow`Private`qqFFIdentityVector},Clear[RGZWorkflow`Private`qqFFIdentityVector];
 RGZWorkflow`Private`qqFFIdentityVector[___]:=Failure["UnexpectedRecomputation",<||>];
 built=RGZWorkflow`Private`qqFFBuild[packet,False,5,False];
 record["CompletedColorSpinGroupsReused",!FailureQ[built]&&RGZResult["QQFormFactors"]["Rows"]===savedFF["Rows"]]];
DeleteFile[savedFF["File"]];groupFile=FileNameJoin[{DirectoryName[savedFF["File"]],"master-group-1.wxf"}];
groupPacket=Import[groupFile,"WXF"];Export[groupFile,Join[groupPacket,<|"Group"->{999,0}|>],"WXF"];
Block[{RGZWorkflow`Private`qqFFIdentityVector},Clear[RGZWorkflow`Private`qqFFIdentityVector];
 RGZWorkflow`Private`qqFFIdentityVector[___]:=Failure["ExpectedRecomputation",<||>];
 built=RGZWorkflow`Private`qqFFBuild[packet,False,5,False];
 record["MismatchedColorSpinGroupCannotBeReused",FailureQ[built]]];
Print[<|"Passed"->Count[Values[checks],True],"Failed"->Count[Values[checks],False]|>];Exit[If[And@@Values[checks],0,1]];

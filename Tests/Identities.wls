project=DirectoryName[DirectoryName[$InputFileName]];
Get[FileNameJoin[{project,"RGZWorkflow.wl"}]];
RGZInitialize[FileNameJoin[{$TemporaryDirectory,"RGZ-identities-"<>CreateUUID[]}],"Display"->"Quiet"];
r=RGZCheckIdentities[300];
Get[FileNameJoin[{project,"Kernel","Backend","RGZ_Residual39_M0_Diagnostic.wl"}]];
zeroFile=FileNameJoin[{$TemporaryDirectory,"RGZ-zero-residual-"<>CreateUUID[]<>".wxf"}];
Export[zeroFile,<|"\:53c2\:8003\:89c4\:8303"->1,"\:6b8b\:5dee\:5206\:9879"->Table[<|"\:7f16\:53f7"->j,"\:4e3b\:79ef\:5206"->FeynCalc`A0[j],"\:6b8b\:5dee\:7cfb\:6570"->0|>,{j,39}]|>,"WXF"];
zeroReport=RGZResidual39Diagnostic`RGZ39M0Check[zeroFile,60,"\:663e\:793a\:8fdb\:5ea6"->False];
DeleteFile[zeroFile];
RGZWorkflow`Private`storeResult["Propagators",Table[<|"\:6a21\:578b\:51cf\:95f5\:6c0f"->If[j===1,1,0],"\:6a21\:578b\:51cf\:4e8c\:6b21\:6838"->0|>,{j,69}]];
RGZWorkflow`Private`storeResult["PropagatorConnections",Association@Table[ToString[j]->0,{j,8}]];
RGZWorkflow`Private`storeResult["NAVPinch",<|"ConnectionCount"->2,"Connections"->{<|"ExactPolynomialReconstruction"->True|>}|>];
bad=RGZCheckIdentities[300];
report=TestReport[{
 VerificationTest[KeyTake[zeroReport,{"\:72b6\:6001","M^-4\:7cfb\:6570","M^-2\:7cfb\:6570","M0\:76841/epsilon\:7cfb\:6570","M0\:7ed3\:679c","M0\:4e3b\:79ef\:5206\:7cfb\:6570"}],
 <|"\:72b6\:6001"->"M0\:8bca\:65ad\:901a\:8fc7\:ff1a\:6b64\:53c2\:6570\:70b9\:6b8b\:5dee\:5b8c\:5168\:62b5\:6d88","M^-4\:7cfb\:6570"->0,"M^-2\:7cfb\:6570"->0,"M0\:76841/epsilon\:7cfb\:6570"->0,"M0\:7ed3\:679c"->0,"M0\:4e3b\:79ef\:5206\:7cfb\:6570"->{}|>,TestID->"CompleteZeroResidualPipeline"],
 VerificationTest[Lookup[Take[bad["Checks"],{3,4}],"Status"],{"Failed","Failed"},TestID->"RejectNonzeroPropagatorAndIncompleteNAV"],
 VerificationTest[bad["Status"],"IdentityCheckFailed",TestID->"FailedEvidenceOverridesPartialStatus"],
 VerificationTest[Length[RGZIdentityRequirements[]],9,TestID->"RequiredIdentityLedger"],
 VerificationTest[Lookup[Take[r["Checks"],2],"Status"],{"Passed","Passed"},TestID->"BRSTAndCliffordWard"],
 VerificationTest[Counts[Lookup[r["Checks"],"Status"]],<|"Passed"->2,"NotRun"->2,"NotImplemented"->5|>,TestID->"MissingKernelsNeverPass"],
 VerificationTest[r["Status"],"PartialVerification",TestID->"NoFullSTClaim"],
 VerificationTest[RGZResidual39Diagnostic`Private`m0DiagnosticStatus[0,0,0,0],"M0\:8bca\:65ad\:901a\:8fc7\:ff1a\:6b64\:53c2\:6570\:70b9\:6b8b\:5dee\:5b8c\:5168\:62b5\:6d88",TestID->"M0CompleteCancellation"],
 VerificationTest[RGZResidual39Diagnostic`Private`m0DiagnosticStatus[1,0,0,0],"M0\:8bca\:65ad\:ff1a\:5b58\:5728\:5c0f\:8d28\:91cf\:53d1\:6563",TestID->"M0MassDivergence"],
 VerificationTest[RGZResidual39Diagnostic`Private`m0DiagnosticStatus[0,0,1,0],"M0\:8bca\:65ad\:ff1a\:5b58\:5728\:7d2b\:5916\:6b8b\:5dee",TestID->"M0UVResidual"],
 VerificationTest[RGZResidual39Diagnostic`Private`m0DiagnosticStatus[0,0,0,1],"M0\:8bca\:65ad\:ff1a\:5b58\:5728\:6709\:9650\:6b8b\:5dee",TestID->"M0FiniteResidual"],
 VerificationTest[Length[Join[Names["Global`ward*"],Names["Global`ghostVector"]]],0,TestID->"PrivateIdentitySymbols"]
}];
Print[<|"Passed"->report["TestsSucceededCount"],"Failed"->report["TestsFailedCount"]|>];
If[report["TestsFailedCount"]>0,Print[report["TestsFailed"]]];
Exit[If[report["TestsFailedCount"]===0,0,1]];

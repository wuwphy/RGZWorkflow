project=DirectoryName[DirectoryName[$InputFileName]];
Get[FileNameJoin[{project,"RGZWorkflow.wl"}]];
RGZInitialize[FileNameJoin[{$TemporaryDirectory,"rgz-weighted-resume-"<>CreateUUID[]}]];
checks=<||>;rec[n_,v_]:=AssociateTo[checks,n->TrueQ[v]];
fp=RGZWorkflow`Private`workflowFingerprint[];alg=RGZWorkflow`Private`$weightedLedgerSHA256;
Get[FileNameJoin[{project,"Tools","WeightedAuditResume.wl"}]];
rec["PhysicalAndAuditIdentityPreserved",fp===RGZWorkflow`Private`workflowFingerprint[]&&alg===RGZWorkflow`Private`$weightedLedgerSHA256];
dir=FileNameJoin[{RGZWorkflow`Private`cacheDirectory[],"fixture"}];CreateDirectory[dir];
CreateDirectory[FileNameJoin[{dir,"tid_units_v1"}]];audit=FileNameJoin[{dir,"audit"}];CreateDirectory[audit];
units=Table[{1,RGZWorkflow`Engine`q^i},{i,20}];ctx=resumeContext;
files=Table[FileNameJoin[{dir,"tid_units_v1","unit_"<>IntegerString[Hash[{"AA-TID-unit-v1",units[[i,2]],ctx},"SHA256"],16]<>".wl"}],{i,20}];
Do[Put[<|"Status"->"Complete","Version"->1,"Environment"->ctx,"Input"->units[[i,2]],"Result"->0|>,files[[i]]],{i,20}];
tid=<|"Context"->ctx,"Digest"->Hash[FileHash[#,"SHA256"]&/@files],"Files"->AssociationThread[files,FileHash[#,"SHA256"]&/@files]|>;
pv=<|"Context"->ctx,"Digest"->0,"Files"-><||>|>;row=<|"DecomposeT"->fixtureSplit,"IntegrateT"->0,"ScalarT"->0|>;
Internal`InheritedBlock[{RGZWorkflow`Engine`RGZMXIntegralUnits,RGZWorkflow`Engine`RGZMXPVObjectQ,RGZWorkflow`Private`qqWeightedRead,RGZWorkflow`Private`qqWeightedUnitShift},
 Clear[RGZWorkflow`Engine`RGZMXIntegralUnits,RGZWorkflow`Engine`RGZMXPVObjectQ,RGZWorkflow`Private`qqWeightedRead,RGZWorkflow`Private`qqWeightedUnitShift];
 RGZWorkflow`Engine`RGZMXIntegralUnits[_]:=units;RGZWorkflow`Engine`RGZMXPVObjectQ[_]:=False;
 reads=0;fail=True;
 RGZWorkflow`Private`qqWeightedRead[f_]:=(reads++;Get[f]);
 RGZWorkflow`Private`qqWeightedUnitShift[u_]:=If[fail&&u["Input"]===RGZWorkflow`Engine`q^17,Failure["FixtureStopped",<||>],<|"Kind"->"Polynomial","UVTransferD"->0,"IRTransferD"->0,"UVTransferDFull"->0|>];
 a=RGZWorkflow`Private`qqWeightedComponent[row,"T",dir,tid,pv,audit,97,5];
 rec["FailureNotPromoted",FailureQ[a]&&!FileExistsQ[FileNameJoin[{audit,"T-complete.wxf"}]]];
 p=Import[FileNameJoin[{audit,"T-tid-prefix.wxf"}],"WXF"];rec["Completed16UnitPrefixSaved",p["Data"]["Completed"]===16&&Length[p["Data"]["Rows"]]===16];
 fail=False;reads=0;
 b=RGZWorkflow`Private`qqWeightedComponent[row,"T",dir,tid,pv,audit,97,5];
 rec["ResumeSkipsValidatedPrefix",AssociationQ[b]&&reads===4&&Length[b["TIDUnits"]]===20];
 rec["FullReconstructionStillRequired",TrueQ[b["TIDReconstructionVerified"]]&&TrueQ[b["PVReconstructionVerified"]]&&b["Scalar"]===0];
 reads=0;c=RGZWorkflow`Private`qqWeightedComponent[row,"T",dir,tid,pv,audit,97,5];
 rec["CompletedComponentSkipsAllReads",c===b&&reads===0];
 complete=FileNameJoin[{audit,"T-complete.wxf"}];bad=Import[complete,"WXF"];bad=Join[bad,<|"Data"->Join[bad["Data"],<|"Scalar"->123|>]|>];Export[complete,bad,"WXF"];
 rec["DamagedPayloadRejected",MissingQ[RGZWorkflow`Private`qqWeightedResumeRead[complete,bad["Key"]]]];
 c=RGZWorkflow`Private`qqWeightedComponent[row,"T",dir,tid,pv,audit,97,5];rec["DamagedComponentRecomputed",AssociationQ[c]&&c["Scalar"]===0];
 Put[<|"Status"->"Complete","Version"->1,"Environment"->ctx,"Input"->changed,"Result"->0|>,First[files]];
 changedTid=Join[tid,<|"Digest"->Hash[FileHash[#,"SHA256"]&/@files],"Files"->AssociationThread[files,FileHash[#,"SHA256"]&/@files]|>];
 reads=0;c=RGZWorkflow`Private`qqWeightedComponent[row,"T",dir,changedTid,pv,audit,97,5];
 rec["ChangedSourceInvalidatesPrefixAndComponent",MatchQ[c,Failure["QQWeightedTIDUnitMismatch",_]]&&reads===1];
 Put[<|"Status"->"Complete","Version"->1,"Environment"->ctx,"Input"->units[[1,2]],"Result"->0|>,First[files]];
 RGZWorkflow`Private`qqWeightedUnitShift[u_]:=<|"Kind"->"FixtureTransfer","UVTransferD"->2,"IRTransferD"->-2,"UVTransferDFull"->2|>;
 transfer=RGZWorkflow`Private`qqWeightedComponent[row,"T",dir,tid,pv,audit,98,5];
 rec["NonzeroWeightedTransfersArePreserved",AssociationQ[transfer]&&transfer["WeightedUVTransferD"]===40&&transfer["WeightedIRTransferD"]===-40];
 mismatch=RGZWorkflow`Private`qqWeightedComponent[Join[row,<|"IntegrateT"->1|>],"T",dir,tid,pv,audit,99,5];
 rec["WrongGraphReconstructionStillRejected",MatchQ[mismatch,Failure["QQWeightedGraphTIDReconstruction",_]]];
];
Print[checks];Exit[If[AllTrue[Values[checks],TrueQ],0,1]];

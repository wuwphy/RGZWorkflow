(* Finite-mass RGZ: bosonic mixed amputated one-loop insertions.
+   Full open auxiliary colour tensors are retained. No PT proof assumed.
   Prerequisites: FeynCalc/FeynArts loaded; modelRGZ is the model basename.
   Uses the same dummy V/S propagators + full two-leg insertions as W2.6.
   Keep parameters symbolic. PreFactor -> 1; no loop measure included.
   Place beside RGZ_OneLoop_AA_PT_Check.wl. Loading defines functions only.
   Initialization saves audited raw FA amplitudes. FCFAConvert runs only
   in the separately timed and cached conversion stage of EACH graph.
   Scalar coefficients retain the external colour delta and the i factor.
   Cache files are trusted Wolfram Language files generated by this code. *)

With[{f=FileNameJoin[{DirectoryName[$InputFileName],
    "RGZ_OneLoop_AA_PT_Check.wl"}]},
  If[!FileExistsQ[f],Print["\:7f3a\:5c11\:8f85\:52a9\:6587\:4ef6\:ff1a",f];Abort[]];
  Block[{$Output={}},Get[f]]];

ClearAll[RGZMXObjects,RGZMXIndexKind,RGZMXTerms,RGZMXAuditSums,

rgzMXProgress=<|"\:90e8\:95e8"->"", "\:56fe\:53f7"->0,"\:56fe\:6570"->0,"\:9636\:6bb5"->"\:7b49\:5f85",
  "\:5b50\:6b65\:9aa4"->"", "\:9879\:53f7"->0,"\:603b\:9879\:6570"->0,"\:5b8c\:6210\:9879\:6570"->0,

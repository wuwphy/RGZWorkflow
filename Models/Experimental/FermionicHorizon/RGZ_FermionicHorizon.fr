  },

  (* Bosonic localizing field \[Phi]_\[Mu]^{ac}  *)
  V[2] == {
    ClassName       -> \[Phi],
    SelfConjugate   -> False,
    Indices         -> {Index[Gluon],Index[Gribov]},
    Mass            -> 0,
    Width           -> 0,
    ParticleName    -> "phi",
    PDG             -> 21,
    PropagatorLabel -> "\[Phi]",
    PropagatorType  -> Sine,
    PropagatorArrow -> None,
    FullName        -> "phi",
    TeX             -> "phi"
  },

  (* Bosonic localizing field \[Beta]_\[Mu]^{ac} *)
  V[3] == {
    ClassName       -> \[Beta],
    SelfConjugate   -> False,
    Indices         -> {Index[Gluon],Index[Gribov]},
    Mass            -> 0,
    Width           -> 0,
    ParticleName    -> "beta",
    PDG             -> 21,
    PropagatorLabel -> "\[Beta]",
    PropagatorType  -> Sine,
    PropagatorArrow -> None,
    FullName        -> "beta",
    TeX             -> "beta"
  },

  (* Fermionic localizing field \[Omega]_\[Mu]^{ac} *)
  U[2] == {
    ClassName       -> \[Omega],
    SelfConjugate   -> False,
    Indices         -> {Index[Lorentz], Index[Gluon], Index[Gribov]},
    Ghost           -> A,
    QuantumNumbers  -> {GhostNumber -> 1},
    Mass            -> 0,
    Width           -> 0,
    ParticleName    -> "omega",

(* Independent fermionic-horizon extension of arXiv:2107.08569v2.
   Minkowski (+---); new horizon parameters hF1,hF2 (dimension 3/2)
   satisfy hF is explicit: Eq.(28) uses hF=sigmaF^(3/2), whereas
   Eq.(174) writes hF^2=gs^2 sigmaF^3. See the normalization note.
   This is a finite Stueckelberg expansion, NOT the all-order source action.
   Use a fresh kernel; do not load together with the original model.
   New commuting spinors are represented by scalar components with a
   spectator FHSpin index; they must never be assigned fermion loop signs. *)
(* RGZ-BASE-CONTENT {"Schema":"RGZModelContent/1","JacobianGhostIncluded":true,"ClosedQuarkFlavors":2,"GhostClasses":[1,2,3,4],"ScalarGhostClasses":[1,4],"QuarkClasses":[1,2]} *)
(* Namespace boundary: FeynRules may load this file from Global on workers. *)
Begin["RGZWorkflow`Engine`"];
$RGZModelPreviousContextPath = $ContextPath;
Block[{$ContextPath={"System`"}},
 Scan[Symbol["RGZWorkflow`Engine`"<>#]&, {"m","mG","M","s","p","q","p$",
 "mQ1","mQ2","hF1","hF2","wF1","wF2","LamF1","LamF1bar","LamF2","LamF2bar","BosF1","BosF1bar","BosF2","BosF2bar","FHSpin","eta","etabar","Q1","Q1bar","Q2","Q2bar","\[Mu]","\[Alpha]","\[Xi]","\[Tau]","\[Phi]","\[Beta]","\[Omega]","\[Zeta]",
 "\:03d5","\:03d5bar","\:03b2bar","A","b","c","gs","aS","m02","mu2","mg2","M4","gamma2","Nc","rho",
 "a","d","e","f","g","i","j","u","v","g1","g2","h1","h2","QCD","xiGauge","Ah","LTotal",
 "Gluon","Gribov","Colour","Generation","Fadj","dSUN","SU3C","RGZAuxiliaryMass"}]];
$ContextPath = {"RGZWorkflow`Engine`", "FeynRules`", "System`"};
(*************************************************************)
(*  QCD-RGZ Model - FeynRules working draft                 *)
(*                                                           *)
(*  Version 2.7: eta and two massless quark flavors.            *)
(*  Target convention: Minkowski metric (+,-,-,-).            *)
(*  Reference: BRST-invariant RGZ action, Eqs. (A1)-(A3).    *)
(*                                                           *)
(*  Implemented sectors:                                      *)
(*    Yang-Mills, gauge fixing and FP ghosts;                 *)
(*    truncated Stueckelberg expansion of A^h;                *)
(*    localizing fields and horizon mixing;                   *)
(*    dimension-two condensates and IR regulator.             *)
(*                                                           *)
(*  Check before using generated vertices:                   *)
(*    Wick-rotation signs and Grassmann field classes;        *)
(*    Lorentz/color index contractions and horizon signs;    *)
(*    quadratic mixing kernel and propagator identities.      *)
(*************************************************************)

M$ModelName = "RGZ Fermionic Horizon";

M$Information = {
  Authors      -> {"Wan Wu"},
  Version      -> "0.1-FH",
  Date         -> "23. 10. 2026",
  Institutions -> {"Tsinghua University"},
  Emails       -> {"wuw20@mails.tsinghua.edu.cn"},
  Description  -> "Independent two-flavor fermionic-horizon RGZ; finite field expansion"
};

(* ============================= *)
(* Indices                       *)
(* ============================= *)

IndexRange[Index[Lorentz]] = Range[4];
IndexRange[Index[Gluon]]   = NoUnfold[Range[8]];
IndexRange[Index[Gribov]]  = NoUnfold[Range[8]];
IndexRange[Index[Colour]]  = NoUnfold[Range[3]];
IndexRange[Index[Generation]] = Range[6];
IndexRange[Index[FHSpin]] = NoUnfold[Range[4]];
IndexStyle[FHSpin, fhsp];

IndexStyle[Lorentz, \[Mu]];
IndexStyle[Gluon,   a];
IndexStyle[Gribov,  m];
IndexStyle[Colour,  i];
IndexStyle[Generation, fn];

(* ============================= *)
(* Gauge Group SU(3)c            *)
(* ============================= *)

M$GaugeGroups = {
  SU3C == {
    Abelian           -> False,
    CouplingConstant  -> gs,
    GaugeBoson        -> A,
    StructureConstant -> f,
    Representations   -> {{T, Colour}, {Fadj, Gluon}},
    SymmetricTensor   -> dSUN
  }
};

(* ============================= *)
(* Particle Classes              *)
(* ============================= *)

M$ClassesDescription = {
  F[3] == {ClassName -> LamF1, SelfConjugate -> False,
    Indices -> {Index[Gluon], Index[Colour]}, Mass -> wF1, Width -> 0,
    QuantumNumbers -> {QFlavor1 -> 1},
    ParticleName -> "lamF1", AntiParticleName -> "lamF1~",
    PDG -> 9100001, PropagatorLabel -> "lamF1",
    PropagatorType -> Straight, PropagatorArrow -> Forward},
  S[4] == {ClassName -> BosF1, SelfConjugate -> False,
    Indices -> {Index[FHSpin], Index[Gluon], Index[Colour]},
    Mass -> wF1, Width -> 0, QuantumNumbers -> {QFlavor1 -> 1},
    ParticleName -> "bosF1", AntiParticleName -> "bosF1~",
    PDG -> 9200001, PropagatorLabel -> "bosF1",
    PropagatorType -> ScalarDash, PropagatorArrow -> Forward},
  F[4] == {ClassName -> LamF2, SelfConjugate -> False,
    Indices -> {Index[Gluon], Index[Colour]}, Mass -> wF2, Width -> 0,
    QuantumNumbers -> {QFlavor2 -> 1},
    ParticleName -> "lamF2", AntiParticleName -> "lamF2~",
    PDG -> 9100002, PropagatorLabel -> "lamF2",
    PropagatorType -> Straight, PropagatorArrow -> Forward},
  S[5] == {ClassName -> BosF2, SelfConjugate -> False,
    Indices -> {Index[FHSpin], Index[Gluon], Index[Colour]},
    Mass -> wF2, Width -> 0, QuantumNumbers -> {QFlavor2 -> 1},
    ParticleName -> "bosF2", AntiParticleName -> "bosF2~",
    PDG -> 9200002, PropagatorLabel -> "bosF2",
    PropagatorType -> ScalarDash, PropagatorArrow -> Forward},


  (* Two distinct Dirac quarks with optional masses; both are dynamical. *)
  F[1] == {ClassName -> Q1, SelfConjugate -> False,
    Indices -> {Index[Colour]}, Mass -> RGZWorkflow`Engine`mQ1, Width -> 0,
    QuantumNumbers -> {QFlavor1 -> 1}, ParticleName -> "q1",
    AntiParticleName -> "q1~", PDG -> 1, PropagatorLabel -> "q1",
    PropagatorType -> Straight, PropagatorArrow -> Forward},
  F[2] == {ClassName -> Q2, SelfConjugate -> False,
    Indices -> {Index[Colour]}, Mass -> RGZWorkflow`Engine`mQ2, Width -> 0,
    QuantumNumbers -> {QFlavor2 -> 1}, ParticleName -> "q2",
    AntiParticleName -> "q2~", PDG -> 2, PropagatorLabel -> "q2",
    PropagatorType -> Straight, PropagatorArrow -> Forward},
  (* BRST-singlet adjoint scalar ghosts for det[-partial.D(Ah)]. *)
  U[4] == {ClassName -> eta, SelfConjugate -> False,
    Indices -> {Index[Gluon]}, Ghost -> A,
    QuantumNumbers -> {GhostNumber -> 1}, Mass -> 0, Width -> 0,
    ParticleName -> "eta", AntiParticleName -> "eta~", PDG -> 9000008,
    PropagatorLabel -> "eta", PropagatorType -> GhostDash,
    PropagatorArrow -> Forward},

  (* Gluon A_\[Mu]^a *)
  V[1] == {
    ClassName       -> A,
    SelfConjugate   -> True,
    Indices         -> {Index[Gluon]},
    Mass            -> 0,
    Width           -> 0,
    ParticleName    -> "g",
    PDG             -> 21,
    PropagatorLabel -> "g",
    PropagatorType  -> Cycles,
    PropagatorArrow -> None,
    FullName        -> "Gluon A_\[Mu]^a",
    TeX             -> "A"
  },

  (* Faddeev-Popov ghost c^a *)
  U[1] == {
    ClassName       -> c,
    SelfConjugate   -> False,
    Indices         -> {Index[Gluon]},
    Ghost           -> A,
    QuantumNumbers  -> {GhostNumber -> 1},
    Mass            -> 0,
    Width           -> 0,
    ParticleName    -> "c",
    AntiParticleName -> "c~",
    PDG             -> 9000001,
    PropagatorLabel -> "c",
    PropagatorType  -> GhostDash,
    PropagatorArrow -> Forward,
    FullName        -> "Faddeev-Popov ghost c^a",
    TeX             -> "c"
  },

  (* Stueckelberg scalar \[Xi]^a *)
  S[1] == {
    ClassName       -> \[Xi],
    SelfConjugate   -> True,
    Indices         -> {Index[Gluon]},
    Mass            -> 0,
    Width           -> 0,
    ParticleName    -> "xi",
    PDG             -> 22,
    PropagatorLabel -> "\[Xi]",
    PropagatorType  -> Sine,
    PropagatorArrow -> None,
    FullName        -> "Xi",
    TeX             -> "xi"
  },

  (* Lagrange multiplier \[Tau]^a *)
  S[2] == {
    ClassName       -> \[Tau],
    SelfConjugate   -> True,
    Indices         -> {Index[Gluon]},
    Mass            -> 0,
    Width           -> 0,
    ParticleName    -> "tau",
    PDG             -> 23,
    PropagatorLabel -> "\[Tau]",
    PropagatorType  -> Sine,
    PropagatorArrow -> None,
    FullName        -> "Tau",
    TeX             -> "tau"
  },

  (* Lagrange multiplier b^a *)
  S[3] == {
    ClassName       -> b,
    SelfConjugate   -> True,
    Indices         -> {Index[Gluon]},
    Mass            -> 0,
    Width           -> 0,
    ParticleName    -> "b",

(* ============================= *)
(* Parameters                    *)
(* ============================= *)

M$Parameters = {
  hF1 == {ParameterType -> External, Value -> 0,
    Description -> "Fermionic horizon mixing, dimension 3/2, flavor 1"},
  wF1 == {ParameterType -> External, Value -> 1,
    Description -> "Auxiliary spinor refinement mass, flavor 1"},
  hF2 == {ParameterType -> External, Value -> 0,
    Description -> "Fermionic horizon mixing, dimension 3/2, flavor 2"},
  wF2 == {ParameterType -> External, Value -> 1,
    Description -> "Auxiliary spinor refinement mass, flavor 2"},

  mQ1 == {ParameterType -> External, Value -> 0, Description -> "First quark mass"},
  mQ2 == {ParameterType -> External, Value -> 0, Description -> "Second quark mass"},

  aS == {
    ParameterType    -> External,
    Value            -> 0.1184,
    InteractionOrder -> {QCD, 2},
    TeX              -> Subscript[\[Alpha], s],
    Description      -> "Strong coupling \[Alpha]s"
  },

  gs == {
    ParameterType    -> Internal,
    Value            -> Sqrt[4 Pi aS],
    InteractionOrder -> {QCD, 1},
    TeX              -> Subscript[g, s],
    Description      -> "Strong coupling gs"
  },

  \[Alpha] == {
    ParameterType -> External,
    Value         -> 1.0,
    TeX           -> "\[Alpha]",
    Description   -> "Linear covariant gauge parameter \[Alpha]"
  },

  m02 == {
    ParameterType    -> External,
    Value            -> 1.0,
    InteractionOrder -> {QCD, 0},
    TeX              -> Superscript[m, 2],
    Description      -> "Dimension-two condensate mass parameter m^2"
  },

  mu2 == {
    ParameterType    -> External,
    Value            -> 1.0,
    InteractionOrder -> {QCD, 0},
    TeX              -> Superscript[\[Mu], 2],
    Description      -> "Auxiliary-field mass parameter \[Mu]^2"
  },

  M4 == {
    ParameterType    -> External,
    Value            -> 1.0,
    InteractionOrder -> {QCD, 0},
    TeX              -> Superscript[M, 4],
    Description      -> "Stueckelberg infrared regulator M^4"
  },

  gamma2 == {
    ParameterType    -> External,
    Value            -> 1.0,
    InteractionOrder -> {QCD, 0},
    TeX              -> Superscript[\[Gamma], 2],
    Description      -> "Gribov horizon parameter \[Gamma]^2"
  },

  Nc == {
    ParameterType    -> External,
    Value            -> 3.0,
    InteractionOrder -> {QCD, 0},
    TeX              -> Subscript[N, c],
    Description      -> "number of color Nc"
  },

  mg2 == {
    ParameterType    -> Internal,
    Value            -> Sqrt[2 Nc] gs gamma2,
    InteractionOrder -> {QCD, 1},
    TeX              -> Superscript[Subscript[m, G], 2],
    Description      -> "mG^2 = Sqrt[2 Nc] gs gamma2"
  },

  rho == {
    ParameterType    -> External,
    Value            -> 1.0,
    InteractionOrder -> {QCD, 0},
    TeX              -> "\[Rho]",
    Description      -> "BRST source \[Rho] for the infrared regulator"
  }
};

(* ============================= *)
(* Lagrangian                    *)
(* ============================= *)
Ah[\[Mu]_, a_] := Module[{rgzAhIndexB, rgzAhIndexC, rgzAhIndexD, rgzAhIndexE},
    A[\[Mu], a] - del[\[Xi][a], \[Mu]]
  - gs f[a, rgzAhIndexB, rgzAhIndexC] A[\[Mu], rgzAhIndexB] \[Xi][rgzAhIndexC]
  - gs/2 f[a, rgzAhIndexB, rgzAhIndexC] \[Xi][rgzAhIndexB] del[\[Xi][rgzAhIndexC], \[Mu]]
  + gs^2/2 f[a, rgzAhIndexB, rgzAhIndexC] f[rgzAhIndexC, rgzAhIndexD, rgzAhIndexE]
      \[Xi][rgzAhIndexB] \[Xi][rgzAhIndexD] A[\[Mu], rgzAhIndexE]
  - gs^2/6 f[a, rgzAhIndexB, rgzAhIndexC] f[rgzAhIndexC, rgzAhIndexD, rgzAhIndexE]
      \[Xi][rgzAhIndexB] \[Xi][rgzAhIndexD] del[\[Xi][rgzAhIndexE], \[Mu]]
];

(* Pure Yang-Mills *)

(* checked  *)

Lgluon := - 1/4 FS[A, \[Mu], \[Nu], a] FS[A, \[Mu], \[Nu], a];

(* Gauge-Fixing sector *)

(* checked  *)

Lghost = b[a]del[A[\[Mu], a], \[Mu]]+\[Alpha]/2*b[a]b[a]+del[anti[c][a], \[Mu]] (del[c[a], \[Mu]] + 
     gs f[a, b, c] A[\[Mu], b] c[c]);

(* Stueckelberg infrared regulator, PDF Eq.19. *)

(* checked  *)

LIRR =
  -(M4/2) \[Xi][a] \[Xi][a]+rho \[Xi][a] c[a];

(* ================================================================= *)
(* Sector 2.3: Lagrange multiplier \[Tau] sector, PDF Eq.46-Eq.49    *)
(* ================================================================= *)

(* checked  *)

Ltau = -del[\[Tau][a], \[Mu]] Ah[\[Mu],a];

(* ================================================================= *)
(* Sector 2.4: Auxiliary fields \[CapitalPhi] = {\[Phi],\[Beta],\[Omega],\[Zeta]} *)
(* PDF convention: eta = -1 for \[Phi], \[Beta]; eta = +1 for \[Omega], \[Zeta]. *)
(* Kinetic terms are purely free. Interactions Eq.50-Eq.53 are explicit. *)
(* ================================================================= *)

(* checked  *)

Lphi =del[anti[\[Phi]][\[Mu],a, c], \[Nu]] ( del[\[Phi][\[Mu],a, c], \[Nu]] +gs f[a, b, d]Ah[\[Nu],b] \[Phi] [\[Mu],d, c]) ;

Lomega =-del[anti[\[Omega]][\[Mu],a, c], \[Nu]] ( del[\[Omega][\[Mu],a, c], \[Nu]] +gs f[a, b, d]Ah[\[Nu],b] \[Omega] [\[Mu],d, c]) ;

Lbeta =del[anti[\[Beta]][\[Mu],a, c], \[Nu]] ( del[\[Beta][\[Mu],a, c], \[Nu]] +gs f[a, b, d]Ah[\[Nu],b] \[Beta] [\[Mu],d, c]) ;

Lzeta =-del[anti[\[Zeta]][\[Mu],a, c], \[Nu]] ( del[\[Zeta][\[Mu],a, c], \[Nu]] +gs f[a, b, d]Ah[\[Nu],b] \[Zeta] [\[Mu],d, c]) ;


(* ================================================================= *)
(* Sector 2.5: Gribov horizon mixing sector, PDF Eq.54-Eq.57         *)
(* \[Chi]_\[Mu]^{bc} = \[Phi] + \[Phi]bar - \[Beta] - \[Beta]bar.    *)
(* ================================================================= *)

(* checked  *)

Lhor = 1/(2 Sqrt[Nc]) * mg2 * f[a, b, c]  Ah[\[Mu],a] (\[Phi][\[Mu],b, c]+anti[\[Phi]][\[Mu],b, c]-\[Beta][\[Mu],b, c]-anti[\[Beta]][\[Mu],b, c]);

Laux = Lphi + Lomega + Lbeta + Lzeta + Lhor;

(* ================================================================= *)
(* Sector 2.6: Dimension-two condensate mass sector, PDF Eq.58-Eq.63 *)
(* The AA\[Xi]\[Xi] term is zero in the PDF and is intentionally absent. *)
(* ================================================================= *)

Lcon = m02/2 *Ah[\[Mu],a] Ah[\[Mu],a] +mu2 (anti[\[Omega]][\[Mu],a, b]\[Omega][\[Mu],a, b]+anti[\[Zeta]][\[Mu],a, b]\[Zeta][\[Mu],a, b]-anti[\[Phi]][\[Mu],a, b]\[Phi][\[Mu],a, b]-anti[\[Beta]][\[Mu],a, b]\[Beta][\[Mu],a, b]);


(* ============================= *)
(* Total Lagrangian              *)
(* ============================= *)

(* Same derivative convention as the ordinary FP scalar ghost. *)
Leta = del[anti[eta][a], \[Mu]] (del[eta[a], \[Mu]] +
  gs f[a,b,d] Ah[\[Mu],b] eta[d]);
(* FR$DSign=+1: D=partial-I gs A; the quark vertex is +I gs gamma T. *)
Lquark := I Q1bar.Ga[\[Mu]].DC[Q1,\[Mu]] +
  I Q2bar.Ga[\[Mu]].DC[Q2,\[Mu]] - mQ1 Q1bar.Q1 - mQ2 Q2bar.Q2;
(* The mixing uses hF rather than a fractional power of sigma.
   Formal all-order fields are exp[-I gs xi.T] Q and Qbar exp[I gs xi.T].
   The executable psi dressing below is through xi^2; Ah is inherited
   through total field degree three. The companion FA model retains interactions through four particles. *)
FHQDressed[field_,sp_,ii_] := Module[{bb,jj,cc,kk},
 field[sp,ii] - I gs \[Xi][bb] T[bb,ii,jj] field[sp,jj]
 - gs^2/2 \[Xi][bb] \[Xi][cc] T[bb,ii,jj] T[cc,jj,kk] field[sp,kk]];
FHQBarDressed[field_,sp_,ii_] := Module[{bb,jj,cc,kk},
 field[sp,ii] + I gs field[sp,jj] T[bb,jj,ii] \[Xi][bb]
 - gs^2/2 field[sp,kk] T[cc,kk,jj] T[bb,jj,ii] \[Xi][bb] \[Xi][cc]];
LFHFlavor[qq_,qb_,lam_,lb_,bos_,bb_,hh_,ww_] := Module[
 {sp,aa,ii,mu,ab,ac,jj},
 -del[lb[sp,aa,ii],mu] (del[lam[sp,aa,ii],mu]+gs f[aa,ab,ac] Ah[mu,ab] lam[sp,ac,ii])
 +ww^2 lb[sp,aa,ii] lam[sp,aa,ii]
 -del[bb[sp,aa,ii],mu] (del[bos[sp,aa,ii],mu]+gs f[aa,ab,ac] Ah[mu,ab] bos[sp,ac,ii])
 +ww^2 bb[sp,aa,ii] bos[sp,aa,ii]
 +hh (lb[sp,aa,ii] T[aa,ii,jj] FHQDressed[qq,sp,jj]
     +FHQBarDressed[qb,sp,ii] T[aa,ii,jj] lam[sp,aa,jj])];
LFermionicHorizon := LFHFlavor[Q1,Q1bar,LamF1,LamF1bar,BosF1,BosF1bar,hF1,wF1] +
 LFHFlavor[Q2,Q2bar,LamF2,LamF2bar,BosF2,BosF2bar,hF2,wF2];

LTotal := Lgluon + Lghost + LIRR + Ltau + Laux + Lcon + Leta + Lquark + LFermionicHorizon;

(* Gauge-fixing parameter declarations. *)
GaugeXi[A]  = xiGauge;
GaugeXi[c] = xiGauge;



$ContextPath = $RGZModelPreviousContextPath;
End[];

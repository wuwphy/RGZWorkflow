(* RGZ_W2.6.gen: direct Minkowski two-point rational functions. *)
KinematicIndices[F]  = {};
KinematicIndices[V]  = {Global`Lorentz};
KinematicIndices[S]  = {};
KinematicIndices[SV] = {Global`Lorentz};
KinematicIndices[U]  = {Global`Lorentz};

$FermionLines = True;

P$NonCommuting = F | U;
P$ChainBuildOrder = {F, U};

Attributes[Global`FAMetricTensor] = {Orderless};
Attributes[Global`FAScalarProduct] = {Orderless};

Global`FAFourVector /:
  -Global`FAFourVector[mom_, mu___] :=
    Global`FAFourVector[Expand[-mom], mu];

Global`FAFourVector[0, ___] = 0;

SpinorType[j_Integer, ___] :=
  Global`MajoranaSpinor /; SelfConjugate[F[j]];

SpinorType[_Integer, __] = Global`FADiracSpinor;

Clear[RGZWorkflow`Engine`RGZUPropagator];

RGZWorkflow`Engine`RGZUPropagator[0, p_, a_, b_] :=
  I*FAPropagatorDenominator[p, 0];

RGZWorkflow`Engine`RGZUPropagator[
    tag : (
      RGZWorkflow`Engine`RGZAuxiliaryMass |
      RGZWorkflow`Engine`RGZAuxiliaryMass[___]
    ),
    p_, a_, b_
  ] :=
  -I*Global`FAMetricTensor[a, b]*
    FAPropagatorDenominator[p, \[Mu]];

M$GenericPropagators = {

  AnalyticalPropagator[External][
    s1 F[j1, mom]
  ] ==
    FANonCommutative[
      SpinorType[j1][-mom, Mass[F[j1]]]
    ],

  AnalyticalPropagator[Internal][
    s1 F[j1, mom]
  ] ==
    FANonCommutative[
      Global`FADiracSlash[-mom] + Mass[F[j1]]
    ] *
    I*FAPropagatorDenominator[mom, Mass[F[j1]]],

  AnalyticalPropagator[External][
    s1 V[j1, mom, {li1}]
  ] == 1,

  AnalyticalPropagator[Internal][
    s1 V[j1, mom, {li1} -> {li2}]
  ] ==
    Global`FAMetricTensor[li1, li2],

  AnalyticalPropagator[External][
    s1 SV[j1, mom, {li1}]
  ] == 1,

  AnalyticalPropagator[Internal][
    s1 SV[j1, mom, {li1} -> {li2}]
  ] ==
    Global`FAMetricTensor[li1, li2],

  AnalyticalPropagator[External][
    s1 S[j1, mom]
  ] == 1,

  AnalyticalPropagator[Internal][
    s1 S[j1, mom]
  ] == 1,

  AnalyticalPropagator[External][
    s1 U[j1, mom, {li1}]
  ] == 1,

  AnalyticalPropagator[Internal][
    s1 U[j1, mom, {li1} -> {li2}]
  ] ==
    RGZWorkflow`Engine`RGZUPropagator[
      Mass[U[j1]], mom, li1, li2
    ]

};

M$GenericCouplings = {

  (* VV *)
  AnalyticalCoupling[ s1 V[j1, mom1, {li1}], s2 V[j2, mom2, {li2}] ] ==
    G[1][s1 V[j1], s2 V[j2]] . {
      (Global`FAMetricTensor[li1, li2] - Global`FAFourVector[mom1, li1]*Global`FAFourVector[mom2, li2]/Global`FAScalarProduct[mom1, mom2])*((-Global`FAScalarProduct[mom1, mom2]) - \[Mu]^2)/(((-Global`FAScalarProduct[mom1, mom2]) - m^2)*((-Global`FAScalarProduct[mom1, mom2]) - \[Mu]^2) + mG^4),
      (Global`FAFourVector[mom1, li1]*Global`FAFourVector[mom2, li2]/Global`FAScalarProduct[mom1, mom2])*\[Alpha]*(-Global`FAScalarProduct[mom1, mom2])/((-Global`FAScalarProduct[mom1, mom2])^2 + \[Alpha]*M^4),
      (Global`FAMetricTensor[li1, li2] - Global`FAFourVector[mom1, li1]*Global`FAFourVector[mom2, li2]/Global`FAScalarProduct[mom1, mom2])/(((-Global`FAScalarProduct[mom1, mom2]) - m^2)*((-Global`FAScalarProduct[mom1, mom2]) - \[Mu]^2) + mG^4),
      (Global`FAMetricTensor[li1, li2] - Global`FAFourVector[mom1, li1]*Global`FAFourVector[mom2, li2]/Global`FAScalarProduct[mom1, mom2])/(((-Global`FAScalarProduct[mom1, mom2]) - \[Mu]^2)*(((-Global`FAScalarProduct[mom1, mom2]) - m^2)*((-Global`FAScalarProduct[mom1, mom2]) - \[Mu]^2) + mG^4)),
      Global`FAMetricTensor[li1, li2]/((-Global`FAScalarProduct[mom1, mom2]) - \[Mu]^2)
    },

  (* Two-point insertion momenta enter the insertion vertex, opposite to
     the adjacent interaction-vertex field momenta. Its covariance is
     D_ij(-p)=D_ji(p) in the bosonic sector, with del -> -I p.
     Reverse the one-momentum bases
     here, including the rho-dependent ghost-vector source insertion;
     keep the class coefficients and interaction vertices unchanged. *)
  (* SV *)
  AnalyticalCoupling[ s1 S[j1, mom1], s2 V[j2, mom2, {li2}] ] ==
    G[1][s1 S[j1], s2 V[j2]] . {
      -Global`FAFourVector[mom2, li2]*(-Global`FAScalarProduct[mom1, mom2])/((-Global`FAScalarProduct[mom1, mom2])^2 + \[Alpha]*M^4),
      -Global`FAFourVector[mom2, li2]/((-Global`FAScalarProduct[mom1, mom2])^2 + \[Alpha]*M^4),
      -Global`FAFourVector[mom2, li2]/((-Global`FAScalarProduct[mom1, mom2])*((-Global`FAScalarProduct[mom1, mom2])^2 + \[Alpha]*M^4)),
      -Global`FAFourVector[mom2, li2]/((-Global`FAScalarProduct[mom1, mom2])*((-Global`FAScalarProduct[mom1, mom2]) - \[Mu]^2))
    },

  (* VS *)
  AnalyticalCoupling[ s1 V[j1, mom1, {li1}], s2 S[j2, mom2] ] ==
    G[1][s1 V[j1], s2 S[j2]] . {
      -Global`FAFourVector[mom1, li1]*(-Global`FAScalarProduct[mom1, mom2])/((-Global`FAScalarProduct[mom1, mom2])^2 + \[Alpha]*M^4),
      -Global`FAFourVector[mom1, li1]/((-Global`FAScalarProduct[mom1, mom2])^2 + \[Alpha]*M^4),
      -Global`FAFourVector[mom1, li1]/((-Global`FAScalarProduct[mom1, mom2])*((-Global`FAScalarProduct[mom1, mom2])^2 + \[Alpha]*M^4)),
      -Global`FAFourVector[mom1, li1]/((-Global`FAScalarProduct[mom1, mom2])*((-Global`FAScalarProduct[mom1, mom2]) - \[Mu]^2))
    },

  (* UV *)
  AnalyticalCoupling[ s1 U[j1, mom1, {li1}], s2 V[j2, mom2, {li2}] ] ==
    G[1][s1 U[j1], s2 V[j2]] . {
      -Global`FAFourVector[mom2, li2]*(-Global`FAScalarProduct[mom1, mom2])/((-Global`FAScalarProduct[mom1, mom2])^2 + \[Alpha]*M^4),
      -Global`FAFourVector[mom2, li2]/((-Global`FAScalarProduct[mom1, mom2])^2 + \[Alpha]*M^4),
      -Global`FAFourVector[mom2, li2]/((-Global`FAScalarProduct[mom1, mom2])*((-Global`FAScalarProduct[mom1, mom2])^2 + \[Alpha]*M^4)),
      -Global`FAFourVector[mom2, li2]/((-Global`FAScalarProduct[mom1, mom2])*((-Global`FAScalarProduct[mom1, mom2]) - \[Mu]^2))
    },

  (* VU *)
  AnalyticalCoupling[ s1 V[j1, mom1, {li1}], s2 U[j2, mom2, {li2}] ] ==
    G[1][s1 V[j1], s2 U[j2]] . {
      -Global`FAFourVector[mom1, li1]*(-Global`FAScalarProduct[mom1, mom2])/((-Global`FAScalarProduct[mom1, mom2])^2 + \[Alpha]*M^4),
      -Global`FAFourVector[mom1, li1]/((-Global`FAScalarProduct[mom1, mom2])^2 + \[Alpha]*M^4),
      -Global`FAFourVector[mom1, li1]/((-Global`FAScalarProduct[mom1, mom2])*((-Global`FAScalarProduct[mom1, mom2])^2 + \[Alpha]*M^4)),
      -Global`FAFourVector[mom1, li1]/((-Global`FAScalarProduct[mom1, mom2])*((-Global`FAScalarProduct[mom1, mom2]) - \[Mu]^2))
    },

  (* US *)
  AnalyticalCoupling[ s1 U[j1, mom1, {li1}], s2 S[j2, mom2] ] ==
    G[1][s1 U[j1], s2 S[j2]] . {
      1/((-Global`FAScalarProduct[mom1, mom2])^2 + \[Alpha]*M^4),
      (-Global`FAScalarProduct[mom1, mom2])/((-Global`FAScalarProduct[mom1, mom2])^2 + \[Alpha]*M^4),
      1/((-Global`FAScalarProduct[mom1, mom2])*((-Global`FAScalarProduct[mom1, mom2])^2 + \[Alpha]*M^4)),
      1/((-Global`FAScalarProduct[mom1, mom2])*((-Global`FAScalarProduct[mom1, mom2]) - \[Mu]^2))
    },

  (* SU *)
  AnalyticalCoupling[ s1 S[j1, mom1], s2 U[j2, mom2, {li2}] ] ==
    G[1][s1 S[j1], s2 U[j2]] . {
      1/((-Global`FAScalarProduct[mom1, mom2])^2 + \[Alpha]*M^4),
      (-Global`FAScalarProduct[mom1, mom2])/((-Global`FAScalarProduct[mom1, mom2])^2 + \[Alpha]*M^4),
      1/((-Global`FAScalarProduct[mom1, mom2])*((-Global`FAScalarProduct[mom1, mom2])^2 + \[Alpha]*M^4)),
      1/((-Global`FAScalarProduct[mom1, mom2])*((-Global`FAScalarProduct[mom1, mom2]) - \[Mu]^2))
    },

  (* SS *)
  AnalyticalCoupling[ s1 S[j1, mom1], s2 S[j2, mom2] ] ==
    G[1][s1 S[j1], s2 S[j2]] . {
      1/((-Global`FAScalarProduct[mom1, mom2])^2 + \[Alpha]*M^4),
      (-Global`FAScalarProduct[mom1, mom2])/((-Global`FAScalarProduct[mom1, mom2])^2 + \[Alpha]*M^4),
      1/(-Global`FAScalarProduct[mom1, mom2]),
      1/((-Global`FAScalarProduct[mom1, mom2])*((-Global`FAScalarProduct[mom1, mom2]) - \[Mu]^2))
    },

  (* UU *)
  AnalyticalCoupling[ s1 U[j1, mom1, {li1}], s2 U[j2, mom2, {li2}] ] ==
    G[-1][s1 U[j1], s2 U[j2]] . {
      Global`FAScalarProduct[mom1, mom2],
      1/(-Global`FAScalarProduct[mom1, mom2])
    },

  (* FF *)
  AnalyticalCoupling[ s1 F[j1, mom1], s2 F[j2, mom2] ] ==
    G[-1][s1 F[j1], s2 F[j2]] . {
      FANonCommutative[ Global`FADiracSlash[mom1], Global`FAChiralityProjector[-1] ],
      FANonCommutative[ Global`FADiracSlash[mom2], Global`FAChiralityProjector[+1] ],
      FANonCommutative[Global`FAChiralityProjector[-1]],
      FANonCommutative[Global`FAChiralityProjector[+1]]
    },

  (* VVV *)
  AnalyticalCoupling[ s1 V[j1, mom1, {li1}], s2 V[j2, mom2, {li2}], s3 V[j3, mom3, {li3}] ] ==
    G[-1][s1 V[j1], s2 V[j2], s3 V[j3]] . {
      Global`FAMetricTensor[li1, li2] * Global`FAFourVector[mom2 - mom1, li3] + Global`FAMetricTensor[li2, li3] * Global`FAFourVector[mom3 - mom2, li1] + Global`FAMetricTensor[li3, li1] * Global`FAFourVector[mom1 - mom3, li2],
      Global`FAFourVector[mom3, li1] * Global`FAMetricTensor[li2, li3],
      Global`FAFourVector[mom2, li1] * Global`FAMetricTensor[li2, li3],
      Global`FAFourVector[mom1, li2] * Global`FAMetricTensor[li1, li3],
      Global`FAFourVector[mom3, li2] * Global`FAMetricTensor[li1, li3],
      Global`FAFourVector[mom2, li3] * Global`FAMetricTensor[li1, li2],
      Global`FAFourVector[mom1, li3] * Global`FAMetricTensor[li1, li2]
    },

  (* VSVSV *)
  AnalyticalCoupling[ s1 V[j1, mom1, {li1}], s2 SV[j2, mom2, {li2}], s3 SV[j3, mom3, {li3}] ] ==
    G[1][s1 V[j1], s2 SV[j2], s3 SV[j3]] . {
      Global`FAMetricTensor[li1, li2]* Global`FAFourVector[mom2 - mom1, li3] + Global`FAMetricTensor[li2, li3]* Global`FAFourVector[mom3 - mom2, li1] + Global`FAMetricTensor[li3, li1]* Global`FAFourVector[mom1 - mom3, li2],
      Global`FAFourVector[mom3, li1]*Global`FAMetricTensor[li2, li3],
      Global`FAFourVector[mom2, li1]*Global`FAMetricTensor[li2, li3],
      Global`FAFourVector[mom1, li2]*Global`FAMetricTensor[li1, li3],
      Global`FAFourVector[mom3, li2]*Global`FAMetricTensor[li1, li3],
      Global`FAFourVector[mom2, li3]*Global`FAMetricTensor[li1, li2],
      Global`FAFourVector[mom1, li3]*Global`FAMetricTensor[li1, li2]
    },

  (* SVS *)
  AnalyticalCoupling[ s1 S[j1, mom1], s2 V[j2, mom2, {li2}], s3 S[j3, mom3] ] ==
    G[1][s1 S[j1], s2 V[j2], s3 S[j3]] . {
      Global`FAFourVector[mom1, li2],
      Global`FAFourVector[mom3, li2]
    },

  (* VSS *)
  AnalyticalCoupling[ s1 V[j1, mom1, {li1}], s2 S[j2, mom2], s3 S[j3, mom3] ] ==
    G[1][s1 V[j1], s2 S[j2], s3 S[j3]] . {
      Global`FAFourVector[mom2, li1],
      Global`FAFourVector[mom3, li1]
    },

  (* SSV *)
  AnalyticalCoupling[ s1 S[j1, mom1], s2 S[j2, mom2], s3 V[j3, mom3, {li3}] ] ==
    G[1][s1 S[j1], s2 S[j2], s3 V[j3]] . {
      Global`FAFourVector[mom1, li3],
      Global`FAFourVector[mom2, li3]
    },

  (* SSS *)
  AnalyticalCoupling[ s1 S[j1, mom1], s2 S[j2, mom2], s3 S[j3, mom3] ] ==
    G[1][s1 S[j1], s2 S[j2], s3 S[j3]] . {
      Global`FAScalarProduct[mom1, mom2],
      Global`FAScalarProduct[mom1, mom3],
      Global`FAScalarProduct[mom2, mom3]
    },

  (* SVV *)
  AnalyticalCoupling[ s1 S[j1, mom1], s2 V[j2, mom2, {li2}], s3 V[j3, mom3, {li3}] ] ==
    G[1][s1 S[j1], s2 V[j2], s3 V[j3]] . {
      Global`FAMetricTensor[li2, li3],
      Global`FAMetricTensor[li2, li3]*Global`FAScalarProduct[mom1, mom2],
      Global`FAMetricTensor[li3, li2]*Global`FAScalarProduct[mom1, mom3]
    },

  (* VSV *)
  AnalyticalCoupling[ s1 V[j1, mom1, {li1}], s2 S[j2, mom2], s3 V[j3, mom3, {li3}] ] ==
    G[1][s1 V[j1], s2 S[j2], s3 V[j3]] . {
      Global`FAMetricTensor[li1, li3],
      Global`FAMetricTensor[li1, li3]*Global`FAScalarProduct[mom2, mom1],
      Global`FAMetricTensor[li3, li1]*Global`FAScalarProduct[mom2, mom3]
    },

  (* VVS *)
  AnalyticalCoupling[ s1 V[j1, mom1, {li1}], s2 V[j2, mom2, {li2}], s3 S[j3, mom3] ] ==
    G[1][s1 V[j1], s2 V[j2], s3 S[j3]] . {
      Global`FAMetricTensor[li1, li2],
      Global`FAMetricTensor[li1, li2]*Global`FAScalarProduct[mom3, mom1],
      Global`FAMetricTensor[li2, li1]*Global`FAScalarProduct[mom3, mom2]
    },

  (* UUV *)
  AnalyticalCoupling[ s1 U[j1, mom1, {li1}], s2 U[j2, mom2, {li2}], s3 V[j3, mom3, {li3}] ] ==
    G[1][s1 U[j1], s2 U[j2], s3 V[j3]] . {
      Global`FAFourVector[mom1, li3],
      Global`FAFourVector[mom2, li3],
      Global`FAFourVector[mom1, li3]*Global`FAMetricTensor[li1, li2],
      Global`FAFourVector[mom2, li3]*Global`FAMetricTensor[li1, li2]
    },

  (* UUS *)
  AnalyticalCoupling[ s1 U[j1, mom1, {li1}], s2 U[j2, mom2, {li2}], s3 S[j3, mom3] ] ==
    G[1][s1 U[j1], s2 U[j2], s3 S[j3]] . {
      Global`FAMetricTensor[li2, li1]*Global`FAScalarProduct[mom1, mom3],
      Global`FAMetricTensor[li1, li2]*Global`FAScalarProduct[mom2, mom3],
      Global`FAScalarProduct[mom1, mom3],
      Global`FAScalarProduct[mom2, mom3]
    },

  (* FFV *)
  AnalyticalCoupling[ s1 F[j1, mom1], s2 F[j2, mom2], s3 V[j3, mom3, {li3}] ] ==
    G[-1][s1 F[j1], s2 F[j2], s3 V[j3]] . {
      FANonCommutative[ Global`FADiracMatrix[li3], Global`FAChiralityProjector[-1] ],
      FANonCommutative[ Global`FADiracMatrix[li3], Global`FAChiralityProjector[+1] ]
    },

  (* FFS *)
  AnalyticalCoupling[ s1 F[j1, mom1], s2 F[j2, mom2], s3 S[j3, mom3] ] ==
    G[1][s1 F[j1], s2 F[j2], s3 S[j3]] . {
      FANonCommutative[Global`FAChiralityProjector[-1]],
      FANonCommutative[Global`FAChiralityProjector[+1]]
    },

  (* VVVV *)
  AnalyticalCoupling[ s1 V[j1, mom1, {li1}], s2 V[j2, mom2, {li2}], s3 V[j3, mom3, {li3}], s4 V[j4, mom4, {li4}] ] ==
    G[1][s1 V[j1], s2 V[j2], s3 V[j3], s4 V[j4]] . {
      Global`FAMetricTensor[li1, li2]*Global`FAMetricTensor[li3, li4],
      Global`FAMetricTensor[li1, li3]*Global`FAMetricTensor[li2, li4],
      Global`FAMetricTensor[li1, li4]*Global`FAMetricTensor[li3, li2]
    },

  (* VVVS *)
  AnalyticalCoupling[ s1 V[j1, mom1, {li1}], s2 V[j2, mom2, {li2}], s3 V[j3, mom3, {li3}], s4 S[j4, mom4] ] ==
    G[1][s1 V[j1], s2 V[j2], s3 V[j3], s4 S[j4]] . {
      Global`FAFourVector[mom3, li1]*Global`FAMetricTensor[li2, li3],
      Global`FAFourVector[mom2, li1]*Global`FAMetricTensor[li2, li3],
      Global`FAFourVector[mom1, li2]*Global`FAMetricTensor[li1, li3],
      Global`FAFourVector[mom3, li2]*Global`FAMetricTensor[li1, li3],
      Global`FAFourVector[mom2, li3]*Global`FAMetricTensor[li1, li2],
      Global`FAFourVector[mom1, li3]*Global`FAMetricTensor[li1, li2]
    },

  (* VSSS *)
  AnalyticalCoupling[ s1 V[j1, mom1, {li1}], s2 S[j2, mom2], s3 S[j3, mom3], s4 S[j4, mom4] ] ==
    G[1][s1 V[j1], s2 S[j2], s3 S[j3], s4 S[j4]] . {
      Global`FAFourVector[mom2, li1],
      Global`FAFourVector[mom3, li1],
      Global`FAFourVector[mom4, li1]
    },

  (* SVSS *)
  AnalyticalCoupling[ s1 S[j1, mom1], s2 V[j2, mom2, {li2}], s3 S[j3, mom3], s4 S[j4, mom4] ] ==
    G[1][s1 S[j1], s2 V[j2], s3 S[j3], s4 S[j4]] . {
      Global`FAFourVector[mom1, li2],
      Global`FAFourVector[mom3, li2],
      Global`FAFourVector[mom4, li2]
    },

  (* SSVS *)
  AnalyticalCoupling[ s1 S[j1, mom1], s2 S[j2, mom2], s3 V[j3, mom3, {li3}], s4 S[j4, mom4] ] ==
    G[1][s1 S[j1], s2 S[j2], s3 V[j3], s4 S[j4]] . {
      Global`FAFourVector[mom1, li3],
      Global`FAFourVector[mom2, li3],
      Global`FAFourVector[mom4, li3]
    },

  (* SSSV *)
  AnalyticalCoupling[ s1 S[j1, mom1], s2 S[j2, mom2], s3 S[j3, mom3], s4 V[j4, mom4, {li4}] ] ==
    G[1][s1 S[j1], s2 S[j2], s3 S[j3], s4 V[j4]] . {
      Global`FAFourVector[mom1, li4],
      Global`FAFourVector[mom2, li4],
      Global`FAFourVector[mom3, li4]
    },

  (* SSSS *)
  AnalyticalCoupling[ s1 S[j1, mom1], s2 S[j2, mom2], s3 S[j3, mom3], s4 S[j4, mom4] ] ==
    G[1][s1 S[j1], s2 S[j2], s3 S[j3], s4 S[j4]] . {
      -Global`FAScalarProduct[mom1, mom2],
      -Global`FAScalarProduct[mom1, mom3],
      -Global`FAScalarProduct[mom1, mom4],
      -Global`FAScalarProduct[mom2, mom3],
      -Global`FAScalarProduct[mom2, mom4],
      -Global`FAScalarProduct[mom3, mom4]
    },

  (* SSVV *)
  AnalyticalCoupling[ s1 S[j1, mom1], s2 S[j2, mom2], s3 V[j3, mom3, {li3}], s4 V[j4, mom4, {li4}] ] ==
    G[1][s1 S[j1], s2 S[j2], s3 V[j3], s4 V[j4]] . {
      Global`FAMetricTensor[li3, li4],
      Global`FAMetricTensor[li3, li4]*Global`FAScalarProduct[mom1, mom3],
      Global`FAMetricTensor[li3, li4]*Global`FAScalarProduct[mom2, mom3],
      Global`FAMetricTensor[li4, li3]*Global`FAScalarProduct[mom1, mom4],
      Global`FAMetricTensor[li4, li3]*Global`FAScalarProduct[mom2, mom4]
    },

  (* SVSV *)
  AnalyticalCoupling[ s1 S[j1, mom1], s2 V[j2, mom2, {li2}], s3 S[j3, mom3], s4 V[j4, mom4, {li4}] ] ==
    G[1][s1 S[j1], s2 V[j2], s3 S[j3], s4 V[j4]] . {
      Global`FAMetricTensor[li2, li4],
      Global`FAMetricTensor[li2, li4]*Global`FAScalarProduct[mom1, mom2],
      Global`FAMetricTensor[li2, li4]*Global`FAScalarProduct[mom3, mom2],
      Global`FAMetricTensor[li4, li2]*Global`FAScalarProduct[mom1, mom4],
      Global`FAMetricTensor[li4, li2]*Global`FAScalarProduct[mom3, mom4]
    },

  (* SVVS *)
  AnalyticalCoupling[ s1 S[j1, mom1], s2 V[j2, mom2, {li2}], s3 V[j3, mom3, {li3}], s4 S[j4, mom4] ] ==
    G[1][s1 S[j1], s2 V[j2], s3 V[j3], s4 S[j4]] . {
      Global`FAMetricTensor[li2, li3],
      Global`FAMetricTensor[li2, li3]*Global`FAScalarProduct[mom1, mom2],
      Global`FAMetricTensor[li2, li3]*Global`FAScalarProduct[mom4, mom2],
      Global`FAMetricTensor[li3, li2]*Global`FAScalarProduct[mom1, mom3],
      Global`FAMetricTensor[li3, li2]*Global`FAScalarProduct[mom4, mom3]
    },

  (* VSSV *)
  AnalyticalCoupling[ s1 V[j1, mom1, {li1}], s2 S[j2, mom2], s3 S[j3, mom3], s4 V[j4, mom4, {li4}] ] ==
    G[1][s1 V[j1], s2 S[j2], s3 S[j3], s4 V[j4]] . {
      Global`FAMetricTensor[li1, li4],
      Global`FAMetricTensor[li1, li4]*Global`FAScalarProduct[mom2, mom1],
      Global`FAMetricTensor[li1, li4]*Global`FAScalarProduct[mom3, mom1],
      Global`FAMetricTensor[li4, li1]*Global`FAScalarProduct[mom2, mom4],
      Global`FAMetricTensor[li4, li1]*Global`FAScalarProduct[mom3, mom4]
    },

  (* VSVS *)
  AnalyticalCoupling[ s1 V[j1, mom1, {li1}], s2 S[j2, mom2], s3 V[j3, mom3, {li3}], s4 S[j4, mom4] ] ==
    G[1][s1 V[j1], s2 S[j2], s3 V[j3], s4 S[j4]] . {
      Global`FAMetricTensor[li1, li3],
      Global`FAMetricTensor[li1, li3]*Global`FAScalarProduct[mom2, mom1],
      Global`FAMetricTensor[li1, li3]*Global`FAScalarProduct[mom4, mom1],
      Global`FAMetricTensor[li3, li1]*Global`FAScalarProduct[mom2, mom3],
      Global`FAMetricTensor[li3, li1]*Global`FAScalarProduct[mom4, mom3]
    },

  (* VVSS *)
  AnalyticalCoupling[ s1 V[j1, mom1, {li1}], s2 V[j2, mom2, {li2}], s3 S[j3, mom3], s4 S[j4, mom4] ] ==
    G[1][s1 V[j1], s2 V[j2], s3 S[j3], s4 S[j4]] . {
      Global`FAMetricTensor[li1, li2],
      Global`FAMetricTensor[li1, li2]*Global`FAScalarProduct[mom3, mom1],
      Global`FAMetricTensor[li1, li2]*Global`FAScalarProduct[mom4, mom1],
      Global`FAMetricTensor[li2, li1]*Global`FAScalarProduct[mom3, mom2],
      Global`FAMetricTensor[li2, li1]*Global`FAScalarProduct[mom4, mom2]
    },

  (* UUSS *)
  AnalyticalCoupling[ s1 U[j1, mom1, {li1}], s2 U[j2, mom2, {li2}], s3 S[j3, mom3], s4 S[j4, mom4] ] ==
    G[1][s1 U[j1], s2 U[j2], s3 S[j3], s4 S[j4]] . {
      Global`FAMetricTensor[li2, li1]*Global`FAScalarProduct[mom1, mom3],
      Global`FAMetricTensor[li2, li1]*Global`FAScalarProduct[mom1, mom4],
      Global`FAMetricTensor[li1, li2]*Global`FAScalarProduct[mom2, mom3],
      Global`FAMetricTensor[li1, li2]*Global`FAScalarProduct[mom2, mom4],
      Global`FAScalarProduct[mom1, mom3],
      Global`FAScalarProduct[mom1, mom4],
      Global`FAScalarProduct[mom2, mom3],
      Global`FAScalarProduct[mom2, mom4]
    },

  (* UUVS *)
  AnalyticalCoupling[ s1 U[j1, mom1, {li1}], s2 U[j2, mom2, {li2}], s3 V[j3, mom3, {li3}], s4 S[j4, mom4] ] ==
    G[1][s1 U[j1], s2 U[j2], s3 V[j3], s4 S[j4]] . {
      Global`FAFourVector[mom1, li3]*Global`FAMetricTensor[li1, li2],
      Global`FAFourVector[mom2, li3]*Global`FAMetricTensor[li1, li2],
      Global`FAFourVector[mom1, li3],
      Global`FAFourVector[mom2, li3]
    }

};

M$FlippingRules = {

  FANonCommutative[
    dm : (_Global`FADiracMatrix | _Global`FADiracSlash),
    Global`FAChiralityProjector[pm_]
  ] ->
    -FANonCommutative[
      dm, Global`FAChiralityProjector[-pm]
    ]

};

M$TruncationRules = {
  _Global`FAPolarizationVector -> 1,
  _Global`FADiracSpinor -> 1,
  _Global`MajoranaSpinor -> 1
};

M$LastGenericRules = {

  Global`FAPolarizationVector[
    p_,
    _. mom : FourMomentum[Outgoing, _],
    li_
  ] :>
    Conjugate[Global`FAPolarizationVector][p, mom, li]

};

Format[
  FermionChain[
    FANonCommutative[_[s1_. mom1_, mass1_]],
    r___,
    FANonCommutative[_[s2_. mom2_, mass2_]]
  ]
] :=
  Overscript[
    If[FreeQ[mom1, Incoming], "u", "v"],
    "_"
  ][mom1, mass1] .
  r .
  If[FreeQ[mom2, Outgoing], "u", "v"][mom2, mass2];

Format[Global`FADiracSlash] = "gs";
Format[Global`FADiracMatrix] = "ga";

Format[Global`FAChiralityProjector[1]] =
  Subscript["om", "+"];

Format[Global`FAChiralityProjector[-1]] =
  Subscript["om", "-"];

Format[FAGaugeXi[a_]] :=
  Subscript["xi", a];

Format[Global`FAPolarizationVector] = "ep";

Unprotect[Conjugate];
Format[Conjugate[a_]] = Superscript[a, "*"];
Protect[Conjugate];

Format[Global`FAMetricTensor] = "g";

Format[Global`FAScalarProduct[a__]] := Dot[a];

Format[Global`FAFourVector[a_, b_]] := a[b];
Format[Global`FAFourVector[a_]] := a;

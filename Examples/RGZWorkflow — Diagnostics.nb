                          {"#1", ",", "\"MassLimitUVIRCertified\"", ",", 
                          "False"}], "]"}], "]"}], "&&", RowBox[{"TrueQ", 
                         "[", RowBox[{"Lookup", "[", RowBox[{"#1", ",", 
                          "\"ScalelessLedgerComplete\"", ",", "False"}], 
                          "]"}], "]"}]}], "&"}]}], "]"}], ";"}]], "Input", 
            ExpressionUUID -> "e2c1b182-ab2c-4f33-ba13-4e3c9af16875"]}, 
          Open]]}, Open]], Cell[CellGroupData[
       {Cell["5 - Finite reconstruction and conditional certification", 
         "Section", ExpressionUUID -> 
          "a2765a84-2711-4267-b147-8000972a8a02"], 
        Cell[CellGroupData[{Cell[BoxData[RowBox[{RowBox[{"rgzDiagnosticRun", 
                 "[", RowBox[{"\"Finite\"", ",", RowBox[{"RGZQQFiniteAudit", 
                     "[", RowBox[{"3600", ",", RowBox[
                        {"\"CoefficientSeconds\"", "\[Rule]", "120"}]}], 
                     "]"}], ",", RowBox[{"{", "\"MSbar\"", "}"}], ",", 
                   RowBox[{RowBox[{RowBox[{"Lookup", "[", RowBox[{"#1", ",", 
                          "\"Status\"", ",", "None"}], "]"}], "===", 
                       "\"FiniteAssemblyVerified\""}], "&"}]}], "]"}], 
               ";"}]], "Input", ExpressionUUID -> 
             "788691e5-6865-4937-841f-6d7335163c2a"]}, Open]], 
        Cell["Use the gaugeFile preserved in Start Here. The fallback below \
uses the prior certificate pointer, when present; the certification command \
still independently validates source jobs, hashes and payloads. It never \
upgrades a completion flag.", "Text", ExpressionUUID -> 
          "0bb3179d-ed92-4758-9ae2-1472da541e8e"], 
        Cell[BoxData[RowBox[{RowBox[{"If", "[", RowBox[{RowBox[
                 {"!", RowBox[{"StringQ", "[", "gaugeFile", "]"}]}], ",", 
                RowBox[{RowBox[{"rgzPreviousCert", "=", RowBox[{"RGZResult", 
                      "[", "\"QQCertification\"", "]"}]}], ";", RowBox[
                   {"rgzGaugeFiles", "=", RowBox[{"If", "[", RowBox[
                       {RowBox[{"AssociationQ", "[", "rgzPreviousCert", 
                          "]"}], ",", RowBox[{"Lookup", "[", RowBox[
                          {"rgzPreviousCert", ",", "\"EvidenceFiles\"", ",", 
                          RowBox[{"{", "}"}]}], "]"}], ",", RowBox[{"{", 
                          "}"}]}], "]"}]}], ";", RowBox[{"If", "[", 
                    RowBox[{RowBox[{RowBox[{"ListQ", "[", "rgzGaugeFiles", 
                          "]"}], "&&", RowBox[{RowBox[{"Length", "[", 
                          "rgzGaugeFiles", "]"}], "===", "3"}], "&&", 
                        RowBox[{"StringQ", "[", RowBox[{"rgzGaugeFiles", 
                          "\[LeftDoubleBracket]", "2", 
                          "\[RightDoubleBracket]"}], "]"}]}], ",", RowBox[
                       {"gaugeFile", "=", RowBox[{"rgzGaugeFiles", 
                          "\[LeftDoubleBracket]", "2", 
                          "\[RightDoubleBracket]"}]}]}], "]"}]}]}], "]"}], 
            ";"}]], "Input", ExpressionUUID -> 
          "0ccc435b-4f41-4193-aa84-f6761143fc82"], 
        Cell[CellGroupData[{Cell[BoxData[RowBox[{RowBox[{"rgzDiagnosticRun", 
                 "[", RowBox[{"\"Certification\"", ",", RowBox[{"If", "[", 
                     RowBox[{RowBox[{"StringQ", "[", "gaugeFile", "]"}], ",", 
                       RowBox[{"RGZQQCertification", "[", RowBox[
                          {"\"GaugeFile\"", "\[Rule]", "gaugeFile"}], "]"}], 
                       ",", RowBox[{"RGZQQCertification", "[", "]"}]}], 
                     "]"}], ",", RowBox[{"{", RowBox[{"\"MassCompletion\"", 
                       ",", "\"Finite\""}], "}"}], ",", RowBox[
                    {RowBox[{"TrueQ", "[", RowBox[{"Lookup", "[", RowBox[

                          "\"Status\"", ",", "None"}], "]"}], "===", 
                       "\"FeynHelpersLoaded\""}], "&"}]}], "]"}], ";"}]], 
            "Input", ExpressionUUID -> 
             "6616960f-867c-4c8f-91ce-f6812a093829"]}, Open]], 
        Cell[CellGroupData[{Cell[BoxData[RowBox[{RowBox[{"rgzDiagnosticRun", 
                 "[", RowBox[{"\"UVIR\"", ",", RowBox[{"RGZQQUVIR", "[", 
                     RowBox[{"1200", ",", RowBox[{"\"IntegralSeconds\"", 
                         "\[Rule]", "30"}], ",", RowBox[
                        {"\"CoefficientSeconds\"", "\[Rule]", "30"}]}], 
                     "]"}], ",", RowBox[{"{", RowBox[{"\"LoopFF\"", ",", 
                       "\"Helpers\""}], "}"}], ",", RowBox[{RowBox[
                      {RowBox[{RowBox[{"Lookup", "[", RowBox[{"#1", ",", 
                          "\"Status\"", ",", "None"}], "]"}], "===", 
                         "\"RepresentedPoleAnalysis\""}], "&&", RowBox[
                        {"TrueQ", "[", RowBox[{"Lookup", "[", RowBox[

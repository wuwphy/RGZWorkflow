     Cell[CellGroupData[{Cell["4 - Ordered mass and graph-weighted audits", 
         "Section", ExpressionUUID -> 
          "b45c4542-f0d7-4b02-8f8e-cbae73b213ef"], Cell["Use the current \
model manifest and fixed Landau/M0 job. The unit inventory supplements the \
graph-weighted coverage check. The weighted limits are 144000 seconds \
overall, 12000 per graph and 600 per integral; they are ceilings, not \
predicted runtimes. Source-bound T/L assembly prefixes and completed \
components allow interrupted audits to resume. Supported scalar numerators \
are checked by exact full-D identities; unsupported cases retain the original \
replay.", "Text", ExpressionUUID -> "81252003-c2de-4db8-b7e3-64f360584ad7"], 
        Cell[CellGroupData[{Cell[BoxData[RowBox[{RowBox[{"matrixState", "=", 
                 RowBox[{"RGZMixedStart", "[", "]"}]}], ";", RowBox[
                {"matrixManifest", "=", RowBox[{"If", "[", RowBox[
                    {RowBox[{"AssociationQ", "[", "matrixState", "]"}], ",", 
                     RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[
                          {RowBox[{"matrixState", "[", "\"CacheDirectory\"", 
                          "]"}], ",", "\"matrix_job.wl\""}], "}"}], "]"}], 
                     ",", RowBox[{"Missing", "[", "\"MatrixRequired\"", 
                       "]"}]}], "]"}]}], ";", RowBox[{"RGZReport", "[", 
                 "matrixState", "]"}], ";", RowBox[{"fixedJobForAudit", "=", 
                 RowBox[{"RGZResult", "[", "\"QQ\"", "]"}]}], ";", RowBox[
                {"fixedJobFile", "=", RowBox[{"If", "[", RowBox[
                    {RowBox[{RowBox[{"AssociationQ", "[", "fixedJobForAudit", 
                         "]"}], "&&", RowBox[{RowBox[{"Lookup", "[", RowBox[
                          {"fixedJobForAudit", ",", "\"Gauge\"", ",", 
                          "None"}], "]"}], "===", "0"}], "&&", RowBox[
                        {RowBox[{"Lookup", "[", RowBox[{"fixedJobForAudit", 
                          ",", "\"RegulatorMass\"", ",", "None"}], "]"}], 
                         "===", "0"}], "&&", RowBox[{"StringQ", "[", RowBox[
                          {"Lookup", "[", RowBox[{"fixedJobForAudit", ",", 
                          "\"Directory\"", ",", "None"}], "]"}], "]"}]}], 
                     ",", RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[
                          {RowBox[{"fixedJobForAudit", "[", "\"Directory\"", 
                          "]"}], ",", "\"job.wxf\""}], "}"}], "]"}], ",", 
                     RowBox[{"Missing", "[", "\"FixedLandauTaskRequired\"", 
                       "]"}]}], "]"}]}], ";"}]], "Input", ExpressionUUID -> 
             "906a2042-e6d0-4bcf-9b70-9a89b7ccac82"]}, Open]], 
        Cell[CellGroupData[{Cell[BoxData[RowBox[{RowBox[{"rgzDiagnosticRun", 
                 "[", RowBox[{"\"MixedUnits\"", ",", RowBox[

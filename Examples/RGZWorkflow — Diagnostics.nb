                    {"RGZQQMassLimitLedger", "[", RowBox[{"7200", ",", 
                       RowBox[{"\"CoefficientSeconds\"", "\[Rule]", 
                         "900"}]}], "]"}], ",", RowBox[{"{", "\"MSbar\"", 
                     "}"}], ",", RowBox[{RowBox[{RowBox[{"Lookup", "[", 

     Cell[CellGroupData[
       {Cell["6 - Scalar representation, poles, finite equivalence and \
presentation", "Section", ExpressionUUID -> 
          "f439e254-8d41-4605-9e81-20643e1c0177"], Cell["This independent \
presentation can run while mass-limit audits are pending. Pole evidence must \
pass before finite equivalence; finite equivalence must pass before \
simplification. A failed prerequisite blocks dependent cells rather than \
producing a cascade of secondary errors.", "Text", ExpressionUUID -> 
          "fa87c159-5351-42ed-8d46-cbc04230c124"], 
        Cell[CellGroupData[{Cell[BoxData[RowBox[{RowBox[{"rgzDiagnosticRun", 
                 "[", RowBox[{"\"ScalarFF\"", ",", RowBox[
                    {"RGZQQScalarFormFactors", "[", RowBox[{"3600", ",", 
                       RowBox[{"\"CoefficientSeconds\"", "\[Rule]", "60"}]}], 
                     "]"}], ",", RowBox[{"{", "\"LoopFF\"", "}"}], ",", 
                   RowBox[{RowBox[{"MemberQ", "[", RowBox[{RowBox[{"{", 
                          RowBox[{"\"ScalarPVCollected\"", ",", 
                          "\"ScalarPVCollectedExactCoefficientsRetained\""}], 
                          "}"}], ",", RowBox[{"Lookup", "[", RowBox[{"#1", 
                          ",", "\"Status\"", ",", "None"}], "]"}]}], "]"}], 
                     "&"}]}], "]"}], ";"}]], "Input", ExpressionUUID -> 
             "1122ad12-7870-43a5-82e0-7633074cd1c3"]}, Open]], 
        Cell[CellGroupData[{Cell[BoxData[RowBox[{RowBox[{"rgzDiagnosticRun", 

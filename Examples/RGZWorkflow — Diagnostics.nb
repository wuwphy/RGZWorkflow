                    {"RGZQQCompleteMassLedger", "[", "]"}], ",", RowBox[
                    {"{", RowBox[{"\"MassRegions\"", ",", "\"RawMass\"", ",", 
                       "\"Weighted\""}], "}"}], ",", RowBox[{RowBox[

                    {"RGZQQScalarPoleAudit", "[", RowBox[{"3600", ",", 
                       RowBox[{"\"IntegralSeconds\"", "\[Rule]", "60"}], ",", 
                       RowBox[{"\"CoefficientSeconds\"", "\[Rule]", 
                         "120"}]}], "]"}], ",", RowBox[{"{", RowBox[
                      {"\"ScalarFF\"", ",", "\"UVIR\""}], "}"}], ",", 
                   RowBox[{RowBox[{"TrueQ", "[", RowBox[{"Lookup", "[", 
                         RowBox[{"#1", ",", 

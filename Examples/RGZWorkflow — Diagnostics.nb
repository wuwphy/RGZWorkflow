                       RowBox[{"\"CoefficientSeconds\"", "\[Rule]", 
                         "900"}]}], "]"}], ",", RowBox[{"{", 
                     "\"MassTadpoles\"", "}"}], ",", RowBox[{RowBox[
                      {RowBox[{"Lookup", "[", RowBox[{"#1", ",", 
                          "\"Status\"", ",", "None"}], "]"}], "===", 
                       "\"RegionCorrectionsCancel\""}], "&"}]}], "]"}], 
               ";"}]], "Input", ExpressionUUID -> 
             "8bdfe1f8-d6dc-4b33-aaeb-71caf7d3782e"]}, Open]], 
        Cell[CellGroupData[{Cell[BoxData[RowBox[{RowBox[{"rgzDiagnosticRun", 
                 "[", RowBox[{"\"RawMass\"", ",", RowBox[
                    {"RGZQQRawMassPoleAudit", "[", RowBox[{"7200", ",", 

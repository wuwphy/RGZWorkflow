               ";"}]], "Input", ExpressionUUID -> 
             "f7cedf76-5e2c-41e2-ba72-dc2d7eb471fe"]}, Open]], 
        Cell[CellGroupData[{Cell[BoxData[RowBox[{RowBox[{"rgzDiagnosticRun", 
                 "[", RowBox[{"\"Scaleless\"", ",", RowBox[
                    {"RGZQQScalelessLedger", "[", "1200", "]"}], ",", 

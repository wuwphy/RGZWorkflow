Notebook[
 {Cell[CellGroupData[{Cell["RGZWorkflow 1.1.2 \[LongDash] Diagnostics", 
      "Title", ExpressionUUID -> "8b08119d-d763-4a9b-b44f-645270488807"], 
     Cell["Continue in the FeynCalc kernel used by Start Here after its \
fixed-gauge restore. Run section 1, then section 3 onward. Section 2 is only \
for a fresh kernel. Valid completed checkpoints are reused; failures and \
timeouts remain incomplete evidence.", "Text", ExpressionUUID -> 
       "3534cbce-cda6-4509-a0f3-75b0b2f774fc"], 
     Cell[CellGroupData[{Cell["1 - Load the package and audit runtime", 
         "Section", ExpressionUUID -> 
          "9f5de3b6-2999-40b6-b95e-acb056267f11"], 
        Cell[BoxData[RowBox[{RowBox[{"project", "=", RowBox[{
                "ParentDirectory", "[", RowBox[{"NotebookDirectory", "[", 
                  "]"}], "]"}]}], ";", RowBox[{"If", "[", 
              RowBox[{RowBox[{"MemberQ", "[", RowBox[{"$Packages", ",", 
                    "\"RGZWorkflow`\""}], "]"}], ",", RowBox[{"Get", "[", 
                  RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[
                       {"project", ",", "\"Tools\"", ",", 
                        "\"DiagnosticsCompatibility.wl\""}], "}"}], "]"}], 
                  "]"}], ",", RowBox[{"Get", "[", RowBox[{"FileNameJoin", 
                    "[", RowBox[{"{", RowBox[{"project", ",", 
                        "\"RGZWorkflow.wl\""}], "}"}], "]"}], "]"}]}], "]"}], 
            ";", RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
                RowBox[{"{", RowBox[{"project", ",", "\"Tools\"", ",", 
                    "\"WeightedAuditResume.wl\""}], "}"}], "]"}], "]"}], ";", 
            RowBox[{"If", "[", RowBox[{RowBox[{"MemberQ", "[", RowBox[
                   {"$Packages", ",", "\"FeynCalc`\""}], "]"}], ",", 
                RowBox[{RowBox[{"initialization", "=", RowBox[
                     {"RGZInitialize", "[", RowBox[{RowBox[{"FileNameJoin", 
                          "[", RowBox[{"{", RowBox[{"project", ",", 
                          "\"Work\""}], "}"}], "]"}], ",", RowBox[
                         {"\"Display\"", "\[Rule]", "\"Compact\""}]}], 
                      "]"}]}], ";", RowBox[{"RGZReport", "[", 
                    "initialization", "]"}], ";", RowBox[{"If", "[", 
                    RowBox[{RowBox[{"FailureQ", "[", "initialization", "]"}], 
                      ",", RowBox[{"Abort", "[", "]"}]}], "]"}], ";", 
                  RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", RowBox[
                       {"{", RowBox[{"project", ",", "\"Tools\"", ",", 
                          "\"FeynCalcColourCorrection.wl\""}], "}"}], "]"}], 
                    "]"}], ";", RowBox[{"colourCheck", "=", RowBox[
                     {"rgzFeynCalcColourCorrection", "[", "]"}]}], ";", 
                  RowBox[{"If", "[", RowBox[{RowBox[{"FailureQ", "[", 
                        "colourCheck", "]"}], ",", RowBox[{RowBox[{"Print", 
                          "[", "colourCheck", "]"}], ";", RowBox[{"Abort", 
                          "[", "]"}]}]}], "]"}], ";", RowBox[{"Print", "[", 
                    "colourCheck", "]"}], ";"}]}], "]"}], ";"}]], "Input"]}, 
       Open]], Cell[CellGroupData[
       {Cell["2 - Fresh kernel only: initialize and restore", "Section", 
         ExpressionUUID -> "201c025c-8fbd-4a48-9d3d-6b9033a5a66f"], 
        Cell["Skip this section when continuing in the existing Start Here \
kernel. The root loader and runtime adapters install the guarded execution \
helper automatically.", "Text", ExpressionUUID -> 
          "d183e5a7-e0bf-485a-945b-6cbae026f9b0"], 
        Cell[CellGroupData[{Cell[BoxData[RowBox[{RowBox[{"Get", "[", 
                 RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{"project", 
                       ",", "\"Tools\"", ",", 
                       "\"DiagnosticsCompatibility.wl\""}], "}"}], "]"}], 
                 "]"}], ";", RowBox[{"initialization", "=", RowBox[
                  {"RGZInitialize", "[", RowBox[{RowBox[{"FileNameJoin", "[", 
                       RowBox[{"{", RowBox[{"project", ",", "\"Work\""}], 
                         "}"}], "]"}], ",", RowBox[{"\"Display\"", "\[Rule]", 
                       "\"Compact\""}]}], "]"}]}], ";", RowBox[{"RGZReport", 
                 "[", "initialization", "]"}], ";", RowBox[
                {RowBox[{"If", "[", RowBox[{RowBox[{"FailureQ", "[", 
                       "initialization", "]"}], ",", RowBox[{"Abort", "[", 
                       "]"}]}], "]"}], ";;", RowBox[{"RGZReport", "[", 
                   RowBox[{"RGZLoadFeynCalc", "[", "]"}], "]"}]}], ";", 
               RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", RowBox[
                    {"{", RowBox[{"project", ",", "\"Tools\"", ",", 
                       "\"FeynCalcColourCorrection.wl\""}], "}"}], "]"}], 
                 "]"}], ";", RowBox[{"colourCheck", "=", RowBox[
                  {"rgzFeynCalcColourCorrection", "[", "]"}]}], ";", RowBox[
                {"If", "[", RowBox[{RowBox[{"FailureQ", "[", "colourCheck", 
                     "]"}], ",", RowBox[{RowBox[{"Print", "[", "colourCheck", 
                       "]"}], ";", RowBox[{"Abort", "[", "]"}]}]}], "]"}], 
               ";", RowBox[{RowBox[{"Print", "[", "colourCheck", "]"}], ";;", 
                 RowBox[{"RGZReport", "[", RowBox[{"RGZRestore", "[", "]"}], 
                   "]"}]}], ";", RowBox[{"Get", "[", RowBox[{"FileNameJoin", 
                   "[", RowBox[{"{", RowBox[{"project", ",", "\"Tools\"", 
                       ",", "\"WeightedAuditResume.wl\""}], "}"}], "]"}], 
                 "]"}], ";"}]], "Input"], Cell[CellGroupData[{}, Open]]}, 
          Open]], Cell[CellGroupData[
          {Cell[BoxData[{RowBox[{RowBox[{"RGZReport", "[", RowBox[
                   {"RGZQQStart", "[", RowBox[{"600", ",", RowBox[
                       {"\"Gauge\"", "->", "0"}], ",", RowBox[
                       {"\"RegulatorMass\"", "->", "0"}]}], "]"}], "]"}], 
                ";"}], "\n", RowBox[{RowBox[{"RGZReport", "[", RowBox[
                   {"RGZQQAmplitude", "[", "]"}], "]"}], ";"}]}], "Input", 
            ExpressionUUID -> "f8ffa5e3-9682-48d7-8309-6d9b80efe891"], 
           Cell[CellGroupData[{}, Open]]}, Open]]}, Open]], 
     Cell[CellGroupData[{Cell["3 - Source form factors, UV/IR and MSbar", 
         "Section", ExpressionUUID -> 
          "ba73c9f9-3324-4ec1-8c16-c054cc99d436"], Cell["Run these cells in \
order. Valid source-bound caches are reused. The MSbar and finite results are \
representations; complete mass and graph-weighted evidence remains necessary \
for certification.", "Text", ExpressionUUID -> 
          "67f50fd3-4dd7-4f3a-a645-d309f27a0da7"], 
        Cell[CellGroupData[{Cell[BoxData[RowBox[{RowBox[{"rgzDiagnosticRun", 
                 "[", RowBox[{"\"LoopFF\"", ",", RowBox[{"RGZQQFormFactors", 
                     "[", RowBox[{"1200", ",", RowBox[{"\"LoopOrder\"", 
                         "\[Rule]", "1"}], ",", RowBox[
                        {"\"CoefficientSeconds\"", "\[Rule]", "30"}]}], 
                     "]"}], ",", RowBox[{"{", "}"}], ",", RowBox[
                    {RowBox[{RowBox[{"Lookup", "[", RowBox[{"#1", ",", 
                          "\"Status\"", ",", "None"}], "]"}], "===", 
                       "\"Complete\""}], "&"}]}], "]"}], ";"}]], "Input", 
            ExpressionUUID -> "b5d97a98-49b2-4db2-9258-a4dd835a977b"]}, 

Notebook[{Cell["RGZWorkflow 1.0.0 \[LongDash] Diagnostics", "Title"],
  Cell["Continue in the FeynCalc kernel used by Start Here after its \
fixed-gauge restore. Run section 1, then section 3 onward. Section 2 is only \
for a fresh kernel. Valid completed checkpoints are reused; failures and \
timeouts remain incomplete evidence.", "Text"],
  Cell["1 - Load the package and audit runtime", "Section"],
  Cell[BoxData[RowBox[{RowBox[{"project", "=",
        RowBox[{"ParentDirectory", "[", RowBox[{"NotebookDirectory", "[",
            "]"}], "]"}]}], ";", RowBox[{"If", "[",
        RowBox[{RowBox[{"MemberQ", "[", RowBox[{"$Packages", ",",
              "\"RGZWorkflow`\""}], "]"}], ",",
          RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", RowBox[{"{",
                RowBox[{"project", ",", "\"Tools\"", ",",
                  "\"DiagnosticsCompatibility.wl\""}], "}"}], "]"}], "]"}],
          ",", RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[",
              RowBox[{"{", RowBox[{"project", ",", "\"RGZWorkflow.wl\""}],
                "}"}], "]"}], "]"}]}], "]"}], ";",
      RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[",
          RowBox[{"{", RowBox[{"project", ",", "\"Tools\"", ",",
              "\"WeightedAuditResume.wl\""}], "}"}], "]"}], "]"}], ";"}]],
   "Input"], Cell["2 - Fresh kernel only: initialize and restore",
   "Section"], Cell["Skip this section when continuing in the existing Start \
Here kernel. The root loader and runtime adapters install the guarded \
execution helper automatically.", "Text"],
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[",
          RowBox[{"{", RowBox[{"project", ",", "\"Tools\"", ",",
              "\"DiagnosticsCompatibility.wl\""}], "}"}], "]"}], "]"}], ";",
      RowBox[{"RGZReport", "[", RowBox[{"RGZInitialize", "[",
          RowBox[{RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[
                 {"project", ",", "\"Work\""}], "}"}], "]"}], ",",
            RowBox[{"\"Display\"", "\[Rule]", "\"Compact\""}]}], "]"}],
        "]"}], ";", RowBox[{"RGZReport", "[", RowBox[{"RGZLoadFeynCalc", "[",
          "]"}], "]"}], ";", RowBox[{"RGZReport", "[",
        RowBox[{"RGZRestore", "[", "]"}], "]"}], ";",
      RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[",
          RowBox[{"{", RowBox[{"project", ",", "\"Tools\"", ",",
              "\"WeightedAuditResume.wl\""}], "}"}], "]"}], "]"}], ";"}]],
   "Input"], Cell["3 - Source form factors, UV/IR and MSbar", "Section"],
  Cell["Run these cells in order. Valid source-bound caches are reused. The \
MSbar and finite results are representations; complete mass and \
graph-weighted evidence remains necessary for certification.", "Text"],
  Cell[BoxData[RowBox[{RowBox[{"rgzDiagnosticRun", "[",
        RowBox[{"\"LoopFF\"", ",", RowBox[{"RGZQQFormFactors", "[",
            RowBox[{"1200", ",", RowBox[{"\"LoopOrder\"", "\[Rule]", "1"}],
              ",", RowBox[{"\"CoefficientSeconds\"", "\[Rule]", "30"}]}],
            "]"}], ",", RowBox[{"{", "}"}], ",",
          RowBox[{RowBox[{RowBox[{"Lookup", "[", RowBox[{"#1", ",",
                  "\"Status\"", ",", "None"}], "]"}], "===",
              "\"Complete\""}], "&"}]}], "]"}], ";"}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{"rgzDiagnosticRun", "[",
        RowBox[{"\"Helpers\"", ",", RowBox[{"RGZLoadFeynHelpers", "[", "]"}],
          ",", RowBox[{"{", "}"}], ",", RowBox[
           {RowBox[{RowBox[{"Lookup", "[", RowBox[{"#1", ",", "\"Status\"",
                  ",", "None"}], "]"}], "===", "\"FeynHelpersLoaded\""}],
            "&"}]}], "]"}], ";"}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{"rgzDiagnosticRun", "[",
        RowBox[{"\"UVIR\"", ",", RowBox[{"RGZQQUVIR", "[",
            RowBox[{"1200", ",", RowBox[{"\"IntegralSeconds\"", "\[Rule]",
                "30"}], ",", RowBox[{"\"CoefficientSeconds\"", "\[Rule]",
                "30"}]}], "]"}], ",", RowBox[{"{", RowBox[{"\"LoopFF\"", ",",
              "\"Helpers\""}], "}"}], ",", RowBox[
           {RowBox[{RowBox[{RowBox[{"Lookup", "[", RowBox[{"#1", ",",
                    "\"Status\"", ",", "None"}], "]"}], "===",
                "\"RepresentedPoleAnalysis\""}], "&&", RowBox[{"TrueQ", "[",
                RowBox[{"Lookup", "[", RowBox[{RowBox[{"Lookup", "[",
                      RowBox[{"#1", ",", "\"Statistics\"", ",", RowBox[
                         {"Association", "[", "]"}]}], "]"}], ",",
                    "\"CompleteRepresentedUV\"", ",", "False"}], "]"}],
                "]"}], "&&", RowBox[{"TrueQ", "[", RowBox[{"Lookup", "[",
                  RowBox[{RowBox[{"Lookup", "[", RowBox[{"#1", ",",
                        "\"Statistics\"", ",", RowBox[{"Association", "[",
                          "]"}]}], "]"}], ",", "\"CompleteRepresentedIR\"",
                    ",", "False"}], "]"}], "]"}]}], "&"}]}], "]"}], ";"}]],
   "Input"],
  Cell[BoxData[RowBox[{RowBox[{"rgzDiagnosticRun", "[",
        RowBox[{"\"Scaleless\"", ",", RowBox[{"RGZQQScalelessLedger", "[",
            "1200", "]"}], ",", RowBox[{"{", "\"LoopFF\"", "}"}], ",",
          RowBox[{RowBox[{RowBox[{"Lookup", "[", RowBox[{"#1", ",",
                  "\"Status\"", ",", "None"}], "]"}], "===",
              "\"RawScalelessCoreLedger\""}], "&"}]}], "]"}], ";"}]],
   "Input"],
  Cell[BoxData[RowBox[{RowBox[{"rgzDiagnosticRun", "[",
        RowBox[{"\"PVLedger\"", ",", RowBox[{"RGZQQPVUVIRLedger", "[",
            "1200", "]"}], ",", RowBox[{"{", "\"LoopFF\"", "}"}], ",",
          RowBox[{RowBox[{"AssociationQ", "[", "#1", "]"}], "&"}]}], "]"}],
      ";"}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{"RGZReport", "[",
        RowBox[{"RGZQQMSbarCounterterms", "[", "]"}], "]"}], ";"}]],
   "Input"],
  Cell[BoxData[RowBox[{RowBox[{"rgzDiagnosticRun", "[",
        RowBox[{"\"MSbar\"", ",", RowBox[{"RGZQQMSbar", "[", "1200", "]"}],
          ",", RowBox[{"{", RowBox[{"\"UVIR\"", ",", "\"Scaleless\""}],
            "}"}], ",", RowBox[{RowBox[{RowBox[{"Lookup", "[",
                RowBox[{"#1", ",", "\"Status\"", ",", "None"}], "]"}], "===",
              "\"MSbarFiniteRepresentation\""}], "&"}]}], "]"}], ";"}]],
   "Input"], Cell["4 - Ordered mass and graph-weighted audits", "Section"],
  Cell["Use the current model manifest and fixed Landau/M0 job. The unit \
inventory supplements the graph-weighted coverage check. The weighted limits \
are 144000 seconds overall, 12000 per graph and 600 per integral; they are \
ceilings, not predicted runtimes. Source-bound T/L assembly prefixes and \
completed components allow interrupted audits to resume. Supported scalar \
numerators are checked by exact full-D identities; unsupported cases retain \
the original replay.", "Text"],
  Cell[BoxData[RowBox[{RowBox[{"matrixState", "=",
        RowBox[{"RGZMixedStart", "[", "]"}]}], ";",
      RowBox[{"matrixManifest", "=", RowBox[{"If", "[",
          RowBox[{RowBox[{"AssociationQ", "[", "matrixState", "]"}], ",",
            RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[
                 {RowBox[{"matrixState", "[", "\"CacheDirectory\"", "]"}],
                  ",", "\"matrix_job.wl\""}], "}"}], "]"}], ",",
            RowBox[{"Missing", "[", "\"MatrixRequired\"", "]"}]}], "]"}]}],
      ";", RowBox[{"RGZReport", "[", "matrixState", "]"}], ";",
      RowBox[{"fixedJobForAudit", "=", RowBox[{"RGZResult", "[", "\"QQ\"",
          "]"}]}], ";", RowBox[{"fixedJobFile", "=",
        RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"AssociationQ", "[",
                "fixedJobForAudit", "]"}], "&&", RowBox[{RowBox[{"Lookup",
                  "[", RowBox[{"fixedJobForAudit", ",", "\"Gauge\"", ",",
                    "None"}], "]"}], "===", "0"}], "&&", RowBox[{
                RowBox[{"Lookup", "[", RowBox[{"fixedJobForAudit", ",",
                    "\"RegulatorMass\"", ",", "None"}], "]"}], "===", "0"}],
              "&&", RowBox[{"StringQ", "[", RowBox[{"Lookup", "[",
                  RowBox[{"fixedJobForAudit", ",", "\"Directory\"", ",",
                    "None"}], "]"}], "]"}]}], ",", RowBox[{"FileNameJoin",
              "[", RowBox[{"{", RowBox[{RowBox[{"fixedJobForAudit", "[",
                    "\"Directory\"", "]"}], ",", "\"job.wxf\""}], "}"}],
              "]"}], ",", RowBox[{"Missing", "[",
              "\"FixedLandauTaskRequired\"", "]"}]}], "]"}]}], ";"}]],
   "Input"],
  Cell[BoxData[RowBox[{RowBox[{"rgzDiagnosticRun", "[",
        RowBox[{"\"MixedUnits\"", ",", RowBox[{"RGZQQMixedUVIRLedger", "[",
            RowBox[{"3600", ",", RowBox[{"\"MatrixManifest\"", "\[Rule]",
                "matrixManifest"}], ",", RowBox[{"\"IntegralSeconds\"",
                "\[Rule]", "120"}]}], "]"}], ",",
          RowBox[{"{", "\"MSbar\"", "}"}], ",",
          RowBox[{RowBox[{"AssociationQ", "[", "#1", "]"}], "&"}]}], "]"}],
      ";"}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{"rgzDiagnosticRun", "[",
        RowBox[{"\"MassTadpoles\"", ",", RowBox[{"RGZQQMassLimitLedger", "[",
            RowBox[{"7200", ",", RowBox[{"\"CoefficientSeconds\"", "\[Rule]",
                "900"}]}], "]"}], ",", RowBox[{"{", "\"MSbar\"", "}"}], ",",
          RowBox[{RowBox[{RowBox[{"Lookup", "[", RowBox[{"#1", ",",
                  "\"Status\"", ",", "None"}], "]"}], "===",
              "\"MassLimitOrderAudit\""}], "&"}]}], "]"}], ";"}]], "Input"],
  Cell["If retrying the region cell after running mass completion, first \
rerun MassTadpoles to restore the original ledger as the active input. That \
preserves the same region checkpoint key.", "Text"],
  Cell[BoxData[RowBox[{RowBox[{"rgzDiagnosticRun", "[",
        RowBox[{"\"MassRegions\"", ",", RowBox[{"RGZQQMassRegionMatch", "[",
            RowBox[{"7200", ",", RowBox[{"\"CoefficientSeconds\"", "\[Rule]",
                "900"}]}], "]"}], ",", RowBox[{"{", "\"MassTadpoles\"",
            "}"}], ",", RowBox[{RowBox[{RowBox[{"Lookup", "[",
                RowBox[{"#1", ",", "\"Status\"", ",", "None"}], "]"}], "===",
              "\"RegionCorrectionsCancel\""}], "&"}]}], "]"}], ";"}]],
   "Input"],
  Cell[BoxData[RowBox[{RowBox[{"rgzDiagnosticRun", "[",
        RowBox[{"\"RawMass\"", ",", RowBox[{"RGZQQRawMassPoleAudit", "[",
            RowBox[{"7200", ",", RowBox[{"\"CoefficientSeconds\"", "\[Rule]",
                "900"}]}], "]"}], ",", RowBox[{"{", "\"MassTadpoles\"",
            "}"}], ",", RowBox[{RowBox[{"TrueQ", "[", RowBox[{"Lookup", "[",
                RowBox[{"#1", ",", "\"AllPairsWithinBound\"", ",", "False"}],
                "]"}], "]"}], "&"}]}], "]"}], ";"}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{"rgzDiagnosticRun", "[",
        RowBox[{"\"Weighted\"", ",", RowBox[{"RGZQQWeightedUVIRLedger", "[",
            RowBox[{"144000", ",", RowBox[{"\"JobFile\"", "\[Rule]",
                "fixedJobFile"}], ",", RowBox[{"\"MatrixManifest\"",
                "\[Rule]", "matrixManifest"}], ",", RowBox[{
                "\"IntegralSeconds\"", "\[Rule]", "600"}], ",",
              RowBox[{"\"GraphSeconds\"", "\[Rule]", "12000"}]}], "]"}], ",",
          RowBox[{"{", "\"MSbar\"", "}"}], ",",
          RowBox[{RowBox[{RowBox[{"Lookup", "[", RowBox[{"#1", ",",
                  "\"Status\"", ",", "None"}], "]"}], "===",
              "\"WeightedGraphCoverageVerified\""}], "&"}]}], "]"}], ";"}]],
   "Input"],
  Cell[BoxData[RowBox[{RowBox[{"rgzDiagnosticRun", "[",
        RowBox[{"\"MassCompletion\"", ",", RowBox[{"RGZQQCompleteMassLedger",
            "[", "]"}], ",", RowBox[{"{", RowBox[{"\"MassRegions\"", ",",
              "\"RawMass\"", ",", "\"Weighted\""}], "}"}], ",",
          RowBox[{RowBox[{RowBox[{"TrueQ", "[", RowBox[{"Lookup", "[",
                  RowBox[{"#1", ",", "\"MassLimitUVIRCertified\"", ",",
                    "False"}], "]"}], "]"}], "&&", RowBox[{"TrueQ", "[",
                RowBox[{"Lookup", "[", RowBox[{"#1", ",",
                    "\"ScalelessLedgerComplete\"", ",", "False"}], "]"}],
                "]"}]}], "&"}]}], "]"}], ";"}]], "Input"],
  Cell["5 - Finite reconstruction and conditional certification", "Section"],
  Cell[BoxData[RowBox[{RowBox[{"rgzDiagnosticRun", "[",
        RowBox[{"\"Finite\"", ",", RowBox[{"RGZQQFiniteAudit", "[",
            RowBox[{"3600", ",", RowBox[{"\"CoefficientSeconds\"", "\[Rule]",
                "120"}]}], "]"}], ",", RowBox[{"{", "\"MSbar\"", "}"}], ",",
          RowBox[{RowBox[{RowBox[{"Lookup", "[", RowBox[{"#1", ",",
                  "\"Status\"", ",", "None"}], "]"}], "===",
              "\"FiniteAssemblyVerified\""}], "&"}]}], "]"}], ";"}]],
   "Input"], Cell["Use the gaugeFile preserved in Start Here. The fallback \
below uses the prior certificate pointer, when present; the certification \
command still independently validates source jobs, hashes and payloads. It \
never upgrades a completion flag.", "Text"],
  Cell[BoxData[RowBox[
     {RowBox[{"If", "[", RowBox[{RowBox[{"!", RowBox[{"StringQ", "[",
              "gaugeFile", "]"}]}], ",", RowBox[
           {RowBox[{"rgzPreviousCert", "=", RowBox[{"RGZResult", "[",
                "\"QQCertification\"", "]"}]}], ";",
            RowBox[{"rgzGaugeFiles", "=", RowBox[{"If", "[", RowBox[
                 {RowBox[{"AssociationQ", "[", "rgzPreviousCert", "]"}], ",",
                  RowBox[{"Lookup", "[", RowBox[{"rgzPreviousCert", ",",
                      "\"EvidenceFiles\"", ",", RowBox[{"{", "}"}]}], "]"}],
                  ",", RowBox[{"{", "}"}]}], "]"}]}], ";",
            RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"ListQ", "[",
                    "rgzGaugeFiles", "]"}], "&&", RowBox[{RowBox[{"Length",
                      "[", "rgzGaugeFiles", "]"}], "===", "3"}], "&&",
                  RowBox[{"StringQ", "[", RowBox[{"rgzGaugeFiles",
                      "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}],
                    "]"}]}], ",", RowBox[{"gaugeFile", "=", RowBox[
                   {"rgzGaugeFiles", "\[LeftDoubleBracket]", "2",
                    "\[RightDoubleBracket]"}]}]}], "]"}]}]}], "]"}], ";"}]],
   "Input"],
  Cell[BoxData[RowBox[{RowBox[{"rgzDiagnosticRun", "[",
        RowBox[{"\"Certification\"", ",", RowBox[{"If", "[",
            RowBox[{RowBox[{"StringQ", "[", "gaugeFile", "]"}], ",",
              RowBox[{"RGZQQCertification", "[", RowBox[{"\"GaugeFile\"",
                  "\[Rule]", "gaugeFile"}], "]"}], ",", RowBox[{
                "RGZQQCertification", "[", "]"}]}], "]"}], ",",
          RowBox[{"{", RowBox[{"\"MassCompletion\"", ",", "\"Finite\""}],
            "}"}], ",", RowBox[{RowBox[{"TrueQ", "[", RowBox[{"Lookup", "[",
                RowBox[{"#1", ",", "\"FullSMatrixVerified\"", ",", "False"}],
                "]"}], "]"}], "&"}]}], "]"}], ";"}]], "Input"],
  Cell["6 - Scalar representation, poles, finite equivalence and \
presentation", "Section"], Cell["This independent presentation can run while \
mass-limit audits are pending. Pole evidence must pass before finite \
equivalence; finite equivalence must pass before simplification. A failed \
prerequisite blocks dependent cells rather than producing a cascade of \
secondary errors.", "Text"],
  Cell[BoxData[RowBox[{RowBox[{"rgzDiagnosticRun", "[",
        RowBox[{"\"ScalarFF\"", ",", RowBox[{"RGZQQScalarFormFactors", "[",
            RowBox[{"3600", ",", RowBox[{"\"CoefficientSeconds\"", "\[Rule]",
                "60"}]}], "]"}], ",", RowBox[{"{", "\"LoopFF\"", "}"}], ",",
          RowBox[{RowBox[{"MemberQ", "[", RowBox[{RowBox[{"{", RowBox[
                   {"\"ScalarPVCollected\"", ",",
                    "\"ScalarPVCollectedExactCoefficientsRetained\""}],
                  "}"}], ",", RowBox[{"Lookup", "[", RowBox[{"#1", ",",
                    "\"Status\"", ",", "None"}], "]"}]}], "]"}], "&"}]}],
        "]"}], ";"}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{"rgzDiagnosticRun", "[",
        RowBox[{"\"ScalarPole\"", ",", RowBox[{"RGZQQScalarPoleAudit", "[",
            RowBox[{"3600", ",", RowBox[{"\"IntegralSeconds\"", "\[Rule]",
                "60"}], ",", RowBox[{"\"CoefficientSeconds\"", "\[Rule]",
                "120"}]}], "]"}], ",", RowBox[
           {"{", RowBox[{"\"ScalarFF\"", ",", "\"UVIR\""}], "}"}], ",",
          RowBox[{RowBox[{"TrueQ", "[", RowBox[{"Lookup", "[",
                RowBox[{"#1", ",", "\"CommonRegulatorPolesVerified\"", ",",
                  "False"}], "]"}], "]"}], "&"}]}], "]"}], ";"}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{"rgzDiagnosticRun", "[",
        RowBox[{"\"ScalarBasis\"", ",", RowBox[{"RGZQQScalarBasisAudit", "[",
            "1200", "]"}], ",", RowBox[{"{", "\"ScalarFF\"", "}"}], ",",
          RowBox[{RowBox[{"AssociationQ", "[", "#1", "]"}], "&"}]}], "]"}],
      ";"}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{"rgzDiagnosticRun", "[",
        RowBox[{"\"ScalarFinite\"", ",", RowBox[{"RGZQQScalarFiniteAudit",
            "[", RowBox[{"7200", ",", RowBox[{"\"CoefficientSeconds\"",
                "\[Rule]", "180"}]}], "]"}], ",",
          RowBox[{"{", RowBox[{"\"ScalarPole\"", ",", "\"MSbar\"", ",",
              "\"Finite\""}], "}"}], ",", RowBox[
           {RowBox[{"TrueQ", "[", RowBox[{"Lookup", "[", RowBox[{"#1", ",",
                  "\"FiniteAmplitudeEquivalenceVerified\"", ",", "False"}],
                "]"}], "]"}], "&"}]}], "]"}], ";"}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{"rgzDiagnosticRun", "[",
        RowBox[{"\"ScalarCompact\"", ",", RowBox[
           {"RGZQQScalarFiniteSimplify", "[", RowBox[{"3600", ",",
              RowBox[{"\"CoefficientSeconds\"", "\[Rule]", "120"}]}], "]"}],
          ",", RowBox[{"{", "\"ScalarFinite\"", "}"}], ",",
          RowBox[{RowBox[{"TrueQ", "[", RowBox[{"Lookup", "[",
                RowBox[{"#1", ",", "\"ExactCoefficientEquivalenceVerified\"",
                  ",", "False"}], "]"}], "]"}], "&"}]}], "]"}], ";"}]],
   "Input"],
  Cell[BoxData[RowBox[{RowBox[{"rgzDiagnosticRun", "[",
        RowBox[{"\"ScalarColor\"", ",", RowBox[{"RGZQQScalarColorSimplify",
            "[", RowBox[{"3600", ",", RowBox[{"\"CoefficientSeconds\"",
                "\[Rule]", "120"}]}], "]"}], ",",
          RowBox[{"{", "\"ScalarCompact\"", "}"}], ",",
          RowBox[{RowBox[{"TrueQ", "[", RowBox[{"Lookup", "[",
                RowBox[{"#1", ",", "\"ColorReconstructionVerified\"", ",",
                  "False"}], "]"}], "]"}], "&"}]}], "]"}], ";"}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{"rgzDiagnosticRun", "[",
        RowBox[{"\"ScalarRows\"", ",", RowBox[{"RGZQQScalarFactorRows", "[",
            RowBox[{"3600", ",", RowBox[{"\"RowSeconds\"", "\[Rule]",
                "180"}]}], "]"}], ",", RowBox[{"{", "\"ScalarColor\"", "}"}],
          ",", RowBox[{RowBox[{"AssociationQ", "[", "#1", "]"}], "&"}]}],
        "]"}], ";"}]], "Input"], Cell["7 - Final state and save", "Section"],
  Cell[BoxData[RowBox[{RowBox[{"RGZReport", "[",
        RowBox[{"RGZIdentityRequirements", "[", "]"}], "]"}], ";",
      "rgzDiagnosticState"}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{"rgzDiagnosticRun", "[",
        RowBox[{"\"SMatrix\"", ",", RowBox[{"RGZQQSMatrix", "[", "]"}], ",",
          RowBox[{"{", "\"Certification\"", "}"}], ",",
          RowBox[{RowBox[{RowBox[{"Lookup", "[", RowBox[{"#1", ",",
                  "\"Status\"", ",", "None"}], "]"}], "===",
              "\"CertifiedWithinDeclaredDomain\""}], "&"}]}], "]"}], ";"}]],
   "Input"], Cell["Save also after an incomplete or timed-out audit. \
Completed checkpoints remain reusable. An incomplete certificate remains \
incomplete, with its outstanding checks and domain visible.", "Text"],
  Cell[BoxData[RowBox[{RowBox[{"RGZReport", "[",
        RowBox[{"RGZSave", "[", "]"}], "]"}], ";"}]], "Input"]},
 StyleDefinitions -> "Default.nb", WindowTitle ->
  "RGZWorkflow \[LongDash] Diagnostics"]
                          RowBox[{"0.43817405905`", " ", "\[ImaginaryI]"}]}], 
                          ")"}]}], "]"}], "<", FractionBox["1", 
                      SuperscriptBox["10", "9"]]}]}], "]"}], ";", RowBox[
                {"Print", "[", RowBox[{"\"C0(0,rootPlus,0) = \"", ",", 
                   RowBox[{"N", "[", RowBox[{"cPlus", ",", "12"}], "]"}]}], 
                 "]"}], ";"}]], "Input", CellLabel -> "In[16]:=", 
            ExpressionUUID -> "3a364a74-2ce4-4d65-8766-97b663f7096b"], 
           Cell[CellGroupData[{}, Open]]}, Open]], 

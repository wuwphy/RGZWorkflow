     Cell[CellGroupData[
       {Cell["4 \[LongDash] Complex-pole triangle and its branch", "Section", 
         ExpressionUUID -> "42c0d882-897f-44a1-94d2-098e2b887893"], 
        Cell["For spacelike external momenta, both RGZ squared masses have \
positive real part. Evaluate C0 using a one-dimensional logarithmic \
representation and an independent two-dimensional parameter integral. The \
conjugate mass must give the conjugate value. This fixes the \
Euclidean-connected branch; it does not establish a Minkowski real-axis \
contour equivalence.", "Text", ExpressionUUID -> 
          "b73fb373-5755-479b-8bc7-6599e72e02ef"], 
        Cell[BoxData[RowBox[{RowBox[{RowBox[{"{", RowBox[{"xm", ",", "um", 
                  ",", "zm"}], "}"}], "=", RowBox[{"SetPrecision", "[", 
                RowBox[{RowBox[{"Rationalize", "[", RowBox[{RowBox[{"Lookup", 
                        "[", RowBox[{"fixed", ",", RowBox[{"{", RowBox[
                          {"\"m2\"", ",", "\"mu2\"", ",", "\"mG4\""}], 
                          "}"}]}], "]"}], ",", "0"}], "]"}], ",", "40"}], 
                "]"}]}], ";", RowBox[{"rootPlus", "=", RowBox[{FractionBox[
                 "1", "2"], " ", RowBox[{"(", RowBox[{"xm", "+", "um", "+", 
                    SqrtBox[RowBox[{SuperscriptBox[RowBox[{"(", RowBox[
                          {"xm", "-", "um"}], ")"}], "2"], "-", RowBox[
                        {"4", " ", "zm"}]}]]}], ")"}]}]}], ";", 
            RowBox[{"rootMinus", "=", RowBox[{"Conjugate", "[", "rootPlus", 
                "]"}]}], ";"}]], "Input", CellLabel -> "In[14]:=", 
         ExpressionUUID -> "d0388804-0bd9-436c-b4a8-b94d3bfe9051"], 
        Cell[BoxData[RowBox[{RowBox[{RowBox[{"c0One", "[", "mass_", "]"}], 
              ":=", RowBox[{"Module", "[", RowBox[{RowBox[{"{", "integrand", 
                    "}"}], ",", RowBox[{RowBox[{RowBox[{"integrand", "[", 
                        RowBox[{"v_", "?", "NumericQ"}], "]"}], ":=", 
                      RowBox[{"If", "[", RowBox[{RowBox[{"TrueQ", "[", 
                          RowBox[{"v", "\[Equal]", "0"}], "]"}], ",", "0", 
                          ",", RowBox[{"With", "[", RowBox[{RowBox[{"{", 
                          RowBox[{"tt", "=", RowBox[{"1", "-", SuperscriptBox[
                          "v", "2"]}]}], "}"}], ",", FractionBox[RowBox[
                          {"2", " ", "v", " ", RowBox[{"Log", "[", RowBox[
                          {"1", "+", FractionBox[RowBox[{FractionBox["1", 
                          "4"], "+", FractionBox[RowBox[{"3", " ", 
                          SuperscriptBox["tt", "2"]}], "4"]}], RowBox[{RowBox[
                          {"(", RowBox[{"1", "-", "tt"}], ")"}], " ", RowBox[
                          {"(", RowBox[{"mass", "+", FractionBox[RowBox[{"3", 
                          " ", "tt"}], "4"]}], ")"}]}]]}], "]"}]}], RowBox[
                          {FractionBox["1", "4"], "+", FractionBox[RowBox[
                          {"3", " ", SuperscriptBox["tt", "2"]}], "4"]}]]}], 
                          "]"}]}], "]"}]}], ";", RowBox[{"-", RowBox[
                       {"NIntegrate", "[", RowBox[{RowBox[{"integrand", "[", 
                          "v", "]"}], ",", RowBox[{"{", RowBox[{"v", ",", 
                          "0", ",", "1"}], "}"}], ",", RowBox[
                          {"WorkingPrecision", "\[Rule]", "35"}], ",", 
                          RowBox[{"AccuracyGoal", "\[Rule]", "16"}], ",", 
                          RowBox[{"PrecisionGoal", "\[Rule]", "16"}], ",", 
                          RowBox[{"Method", "\[Rule]", RowBox[{"{", RowBox[
                          {"\"GlobalAdaptive\"", ",", RowBox[
                          {"\"SymbolicProcessing\"", "\[Rule]", "0"}]}], 
                          "}"}]}]}], "]"}]}]}]}], "]"}]}], ";", 
            RowBox[{RowBox[{"c0Two", "[", "mass_", "]"}], ":=", 
              RowBox[{"Module", "[", RowBox[{RowBox[{"{", "integrand", "}"}], 
                  ",", RowBox[{RowBox[{RowBox[{"integrand", "[", RowBox[
                         {RowBox[{"v_", "?", "NumericQ"}], ",", RowBox[
                          {"w_", "?", "NumericQ"}]}], "]"}], ":=", RowBox[
                       {"If", "[", RowBox[{RowBox[{"TrueQ", "[", RowBox[
                          {RowBox[{"v", "\[Equal]", "0"}], "||", RowBox[
                          {"w", "\[Equal]", "0"}]}], "]"}], ",", "0", ",", 
                          RowBox[{"With", "[", RowBox[{RowBox[{"{", RowBox[
                          {"tt", "=", RowBox[{"1", "-", SuperscriptBox["v", 
                          "2"]}]}], "}"}], ",", FractionBox[RowBox[{"4", " ", 
                          "v", " ", "w"}], RowBox[{RowBox[{RowBox[{"(", 
                          RowBox[{"1", "-", "tt"}], ")"}], " ", RowBox[{"(", 
                          RowBox[{"mass", "+", FractionBox[RowBox[{"3", " ", 
                          "tt"}], "4"]}], ")"}]}], "+", RowBox[
                          {SuperscriptBox["w", "2"], " ", RowBox[{"(", RowBox[
                          {FractionBox["1", "4"], "+", FractionBox[RowBox[
                          {"3", " ", SuperscriptBox["tt", "2"]}], "4"]}], 
                          ")"}]}]}]]}], "]"}]}], "]"}]}], ";", RowBox[
                     {"-", RowBox[{"NIntegrate", "[", RowBox[{RowBox[
                          {"integrand", "[", RowBox[{"v", ",", "w"}], "]"}], 
                          ",", RowBox[{"{", RowBox[{"v", ",", "0", ",", 
                          "1"}], "}"}], ",", RowBox[{"{", RowBox[{"w", ",", 
                          "0", ",", "1"}], "}"}], ",", RowBox[
                          {"WorkingPrecision", "\[Rule]", "35"}], ",", 
                          RowBox[{"AccuracyGoal", "\[Rule]", "12"}], ",", 
                          RowBox[{"PrecisionGoal", "\[Rule]", "12"}], ",", 
                          RowBox[{"MaxRecursion", "\[Rule]", "16"}], ",", 
                          RowBox[{"Method", "\[Rule]", RowBox[{"{", RowBox[
                          {"\"GlobalAdaptive\"", ",", RowBox[
                          {"\"SymbolicProcessing\"", "\[Rule]", "0"}]}], 
                          "}"}]}]}], "]"}]}]}]}], "]"}]}], ";"}]], "Input", 
         CellLabel -> "In[15]:=", ExpressionUUID -> 
          "e20df118-2656-4bae-9139-a1b5ff32350d"], 
        Cell[CellGroupData[{Cell[BoxData[RowBox[{RowBox[{"cPlus", "=", 
                 RowBox[{"c0One", "[", "rootPlus", "]"}]}], ";", RowBox[
                {"cMinus", "=", RowBox[{"c0One", "[", "rootMinus", "]"}]}], 
               ";", RowBox[{"cTwo", "=", RowBox[{"c0Two", "[", "rootPlus", 
                   "]"}]}], ";", RowBox[{"record", "[", RowBox[
                  {"\"ComplexSquaredMassPositiveRealPart\"", ",", 
                   RowBox[{RowBox[{"Re", "[", "rootPlus", "]"}], ">", 

Notebook[
 {Cell[CellGroupData[{Cell["RGZWorkflow \[LongDash] PT and Ward Benchmarks", 
      "Title", ExpressionUUID -> "3b06bc8c-03fe-4fe3-bff6-75fc934dec66"], 
     Cell["A stage example for the PT/background-field research. Start with a \
fresh kernel and evaluate the cells in order. This notebook uses only Wolfram \
Language and the package: no FeynRules, FeynCalc, existing Work directory, or \
local research archive is required.", "Text", ExpressionUUID -> 
       "f5171240-70ed-4ff9-9cfb-844278cf3818"], Cell["Sections 1\[Dash]4 \
recompute the displayed analytic checks. Section 5 is explicitly a frozen \
research snapshot dated 2026-11-24. Its larger mixed-loop values are not \
recomputed here. The complete mixed three-point Ward/PT correspondence \
remains unfinished.", "Text", ExpressionUUID -> 
       "b6fbd0ef-d04a-49a1-8c44-c486eead9bb1"], 
     Cell[CellGroupData[
       {Cell["0 \[LongDash] Load the package and create temporary work", 
         "Section", ExpressionUUID -> 
          "d1723434-8bba-4807-bc4f-1dc078c974f7"], 
        Cell[BoxData[RowBox[{RowBox[{"project", "=", RowBox[{
                "ParentDirectory", "[", RowBox[{"NotebookDirectory", "[", 
                  "]"}], "]"}]}], ";", RowBox[{"Get", "[", 
              RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{"project", 
                    ",", "\"RGZWorkflow.wl\""}], "}"}], "]"}], "]"}], ";"}]], 
         "Input", CellLabel -> "In[1]:=", ExpressionUUID -> 
          "2a21e862-2f61-45b1-acfa-7422efeff6e2"], 
        Cell[BoxData[RowBox[{RowBox[{"work", "=", RowBox[{"CreateDirectory", 
                "[", "]"}]}], ";", RowBox[{RowBox[{"require", "[", "x_", 
                "]"}], ":=", RowBox[{"If", "[", RowBox[{RowBox[{"FailureQ", 
                    "[", "x", "]"}], ",", RowBox[{RowBox[{"Print", "[", "x", 
                      "]"}], ";", RowBox[{"Abort", "[", "]"}]}], ",", "x"}], 
                "]"}]}], ";", RowBox[{"require", "[", RowBox[{
                "RGZInitialize", "[", RowBox[{"work", ",", RowBox[
                   {"\"Display\"", "\[Rule]", "\"Quiet\""}]}], "]"}], "]"}], 
            ";", RowBox[{"checks", "=", RowBox[{"Association", "[", "]"}]}], 
            ";", RowBox[{RowBox[{"record", "[", RowBox[{"name_", ",", 
                  "value_"}], "]"}], ":=", RowBox[{"(", RowBox[
                 {RowBox[{"AssociateTo", "[", RowBox[{"checks", ",", 
                      RowBox[{"name", "\[Rule]", RowBox[{"TrueQ", "[", 
                          "value", "]"}]}]}], "]"}], ";", RowBox[{"Print", 
                    "[", RowBox[{"name", ",", "\": \"", ",", RowBox[{"TrueQ", 
                        "[", "value", "]"}]}], "]"}]}], ")"}]}], ";", 
            RowBox[{RowBox[{"zero", "[", "x_", "]"}], ":=", RowBox[{"And", 
                "@@", RowBox[{RowBox[{"(", RowBox[{RowBox[{"TrueQ", "[", 
                        RowBox[{RowBox[{"Cancel", "[", RowBox[{"Together", 
                          "[", "#1", "]"}], "]"}], "===", "0"}], "]"}], 
                      "&"}], ")"}], "/@", RowBox[{"Flatten", "[", RowBox[
                     {"{", "x", "}"}], "]"}]}]}]}], ";"}]], "Input", 
         CellLabel -> "In[2]:=", ExpressionUUID -> 
          "ee57c3b8-d5d2-404a-8e2a-c884548bf95d"], Cell["The temporary \
directory is printed when results are saved. The production Work directory is \
not used. No cell quits the kernel.", "Text", ExpressionUUID -> 
          "7f2b18ca-3729-4367-b3a4-ae7636a4bd84"]}, Open]], 
     Cell[CellGroupData[
       {Cell["1 \[LongDash] Tree mixing and Schur reduction", "Section", 
         ExpressionUUID -> "d85d4338-7f43-4354-be95-a4b8c3dce807"], 
        Cell["K is the action Hessian and D0 = i K^-1. Keep A, phi, phibar, \
beta and betabar in the transverse block. The package supplies an independent \
explicit tree benchmark; this cell does not rerun a FeynRules export.", 
         "Text", ExpressionUUID -> "e421da75-2e62-4ec6-a000-2d9adbdc4fde"], 
        Cell[BoxData[RowBox[{RowBox[{"require", "[", RowBox[{
                "RGZTreeBenchmark", "[", "60", "]"}], "]"}], ";", 
            RowBox[{"tree", "=", RowBox[{"RGZResult", "[", 
                "\"TreeBenchmark\"", "]"}]}], ";", RowBox[{"parameters", "=", 
              RowBox[{"tree", "[", "\"Parameters\"", "]"}]}], ";", 
            RowBox[{"K", "=", RowBox[{RowBox[{"tree", "[", "\"KT\"", "]"}], 
                "/.", "\[VeryThinSpace]", RowBox[{"Thread", "[", 
                  RowBox[{RowBox[{"Lookup", "[", RowBox[{"parameters", ",", 
                        RowBox[{"{", RowBox[{"\"s\"", ",", "\"m\"", ",", 
                          "\"mu\"", ",", "\"mG\""}], "}"}]}], "]"}], 
                    "\[Rule]", RowBox[{"{", RowBox[{"s", ",", SqrtBox["m2"], 
                        ",", SqrtBox["u2"], ",", SuperscriptBox["z", RowBox[
                          {"1", "/", "4"}]]}], "}"}]}], "]"}]}]}], ";"}]], 
         "Input", CellLabel -> "In[3]:=", ExpressionUUID -> 
          "ab06721e-9786-459a-9351-9f5ff32e1154"], 
        Cell[CellGroupData[{Cell[BoxData[RowBox[{RowBox[{"B", "=", 
                 RowBox[{"K", "\[LeftDoubleBracket]", RowBox[
                    {RowBox[{"2", ";;", "5"}], ",", RowBox[{"2", ";;", 
                       "5"}]}], "\[RightDoubleBracket]"}]}], ";", RowBox[
                {"CL", "=", RowBox[{"K", "\[LeftDoubleBracket]", RowBox[
                    {"1", ",", RowBox[{"2", ";;", "5"}]}], 
                   "\[RightDoubleBracket]"}]}], ";", RowBox[{"CR", "=", 
                 RowBox[{"K", "\[LeftDoubleBracket]", RowBox[
                    {RowBox[{"2", ";;", "5"}], ",", "1"}], 
                   "\[RightDoubleBracket]"}]}], ";", RowBox[{"Binv", "=", 
                 RowBox[{"Inverse", "[", "B", "]"}]}], ";", RowBox[
                {"zL", "=", RowBox[{"-", RowBox[{"CL", ".", "Binv"}]}]}], 
               ";", RowBox[{"zR", "=", RowBox[{"-", RowBox[{"Binv", ".", 
                     "CR"}]}]}], ";", RowBox[{"uL", "=", RowBox[{"Prepend", 
                   "[", RowBox[{"zL", ",", "1"}], "]"}]}], ";", RowBox[
                {"uR", "=", RowBox[{"Prepend", "[", RowBox[{"zR", ",", "1"}], 
                   "]"}]}], ";", RowBox[{"expected", "=", RowBox[
                  {"{", RowBox[{"1", ",", RowBox[{"-", FractionBox[SqrtBox[
                         "z"], RowBox[{"2", " ", RowBox[{"(", RowBox[{"s", 
                          "-", "u2"}], ")"}]}]]}], ",", RowBox[{"-", 
                       FractionBox[SqrtBox["z"], RowBox[{"2", " ", RowBox[
                          {"(", RowBox[{"s", "-", "u2"}], ")"}]}]]}], ",", 
                     FractionBox[SqrtBox["z"], RowBox[{"2", " ", RowBox[
                         {"(", RowBox[{"s", "-", "u2"}], ")"}]}]], ",", 
                     FractionBox[SqrtBox["z"], RowBox[{"2", " ", RowBox[
                         {"(", RowBox[{"s", "-", "u2"}], ")"}]}]]}], "}"}]}], 
               ";", RowBox[{"record", "[", RowBox[
                  {"\"BenchmarkTreeStationaryColumns\"", ",", RowBox[
                    {RowBox[{"zero", "[", RowBox[{"uL", "-", "expected"}], 
                       "]"}], "&&", RowBox[{"zero", "[", RowBox[{"uR", "-", 
                         "expected"}], "]"}]}]}], "]"}], ";", RowBox[
                {"Schur", "=", RowBox[{"Cancel", "[", RowBox[{"Together", 
                     "[", RowBox[{RowBox[{"K", "\[LeftDoubleBracket]", 
                         RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], 
                       "-", RowBox[{"CL", ".", "Binv", ".", "CR"}]}], "]"}], 
                   "]"}]}], ";", RowBox[{"record", "[", RowBox[
                  {"\"MinkowskiSchurInverseSign\"", ",", RowBox[{"zero", "[", 
                     RowBox[{"Schur", "+", "s", "-", "m2", "+", FractionBox[
                        "z", RowBox[{"s", "-", "u2"}]]}], "]"}]}], "]"}], 
               ";"}]], "Input", CellLabel -> "In[4]:=", ExpressionUUID -> 
             "4eb8567c-ac86-45ca-8b74-e4e783b1823c"], 
           Cell[CellGroupData[{}, Open]]}, Open]], 
        Cell[CellGroupData[{Cell[BoxData[TagBox["K", Function[BoxForm`e$, 
               MatrixForm[BoxForm`e$]]]], "Input", CellLabel -> "In[5]:=", 
            ExpressionUUID -> "8f46a175-55ab-4b24-9bd6-8898b9e00150"]}, 
          Open]], Cell[CellGroupData[{Cell[BoxData["uR"], "Input", 
            CellLabel -> "In[6]:=", ExpressionUUID -> 
             "0419b4fd-77bb-4f5e-bcfe-b177c7f7ffea"]}, Open]]}, Open]], 
     Cell[CellGroupData[
       {Cell["2 \[LongDash] One-loop stationary hard-leg terms", "Section", 
         ExpressionUUID -> "afba2f22-0160-4291-a55e-0b909ebcb0c0"], 
        Cell["Pi below is an arbitrary one-loop action-Hessian insertion, not \
a fitted physical self-energy. The stationary auxiliary response changes at \
one loop. Both left and right hard-leg terms are needed before comparing a \
mixed vertex with the reduced inverse.", "Text", ExpressionUUID -> 
          "5ce9aa07-f65b-4501-a1fa-d75449c4524a"], 
        Cell[CellGroupData[{Cell[BoxData[RowBox[{RowBox[{"PiMatrix", "=", 
                 RowBox[{"Array", "[", RowBox[{"loopPi", ",", RowBox[
                      {"{", RowBox[{"5", ",", "5"}], "}"}]}], "]"}]}], ";", 
               RowBox[{"PiAZ", "=", RowBox[{"PiMatrix", 
                   "\[LeftDoubleBracket]", RowBox[{"1", ",", RowBox[
                      {"2", ";;", "5"}]}], "\[RightDoubleBracket]"}]}], ";", 
               RowBox[{"PiZA", "=", RowBox[{"PiMatrix", 
                   "\[LeftDoubleBracket]", RowBox[{RowBox[{"2", ";;", "5"}], 
                     ",", "1"}], "\[RightDoubleBracket]"}]}], ";", RowBox[
                {"PiZZ", "=", RowBox[{"PiMatrix", "\[LeftDoubleBracket]", 
                   RowBox[{RowBox[{"2", ";;", "5"}], ",", RowBox[{"2", ";;", 
                       "5"}]}], "\[RightDoubleBracket]"}]}], ";", RowBox[
                {"deltaZR", "=", RowBox[{"-", RowBox[{"Binv", ".", RowBox[
                      {"(", RowBox[{"PiZA", "+", RowBox[{"PiZZ", ".", 
                          "zR"}]}], ")"}]}]}]}], ";", RowBox[{"deltaZL", "=", 
                 RowBox[{"-", RowBox[{RowBox[{"(", RowBox[{"PiAZ", "+", 
                         RowBox[{"zL", ".", "PiZZ"}]}], ")"}], ".", 
                     "Binv"}]}]}], ";", RowBox[{"PiReduced", "=", 
                 RowBox[{"Cancel", "[", RowBox[{"Together", "[", RowBox[
                      {"uL", ".", "PiMatrix", ".", "uR"}], "]"}], "]"}]}], 
               ";", RowBox[{"FR", "=", RowBox[{RowBox[{"PiMatrix", 
                     "\[LeftDoubleBracket]", RowBox[{"1", ",", "All"}], 
                     "\[RightDoubleBracket]"}], ".", "uR"}]}], ";", RowBox[
                {"FL", "=", RowBox[{"uL", ".", RowBox[{"PiMatrix", 
                     "\[LeftDoubleBracket]", RowBox[{"All", ",", "1"}], 
                     "\[RightDoubleBracket]"}]}]}], ";", RowBox[{"GR", "=", 
                 RowBox[{"CL", ".", "deltaZR"}]}], ";", RowBox[{"GL", "=", 
                 RowBox[{"deltaZL", ".", "CR"}]}], ";", RowBox[{"record", 
                 "[", RowBox[{"\"RightStationaryEquation\"", ",", 
                   RowBox[{"zero", "[", RowBox[{RowBox[{"B", ".", 
                         "deltaZR"}], "+", "PiZA", "+", RowBox[{"PiZZ", ".", 
                         "zR"}]}], "]"}]}], "]"}], ";", RowBox[{"record", 
                 "[", RowBox[{"\"LeftStationaryEquation\"", ",", RowBox[
                    {"zero", "[", RowBox[{RowBox[{"deltaZL", ".", "B"}], "+", 
                       "PiAZ", "+", RowBox[{"zL", ".", "PiZZ"}]}], "]"}]}], 
                 "]"}], ";", RowBox[{"record", "[", RowBox[
                  {"\"RightWardEndpointCompletion\"", ",", RowBox[{"zero", 
                     "[", RowBox[{"FR", "+", "GR", "-", "PiReduced"}], 
                     "]"}]}], "]"}], ";", RowBox[{"record", "[", 
                 RowBox[{"\"LeftWardEndpointCompletion\"", ",", RowBox[
                    {"zero", "[", RowBox[{"FL", "+", "GL", "-", 
                       "PiReduced"}], "]"}]}], "]"}], ";"}]], "Input", 
            CellLabel -> "In[7]:=", ExpressionUUID -> 
             "4da6e5bb-178e-4c71-9f12-d544cf04e410"], 
           Cell[CellGroupData[{}, Open]]}, Open]], 
        Cell[CellGroupData[{Cell[BoxData[RowBox[{RowBox[{"num", "=", 
                 RowBox[{"Det", "[", RowBox[{"K", "+", RowBox[{"eps", " ", 
                       "PiMatrix"}]}], "]"}]}], ";", RowBox[{"den", "=", 
                 RowBox[{"Det", "[", RowBox[{"B", "+", RowBox[{"eps", " ", 
                       "PiZZ"}]}], "]"}]}], ";", RowBox[{"directSchur", "=", 
                 RowBox[{"Cancel", "[", RowBox[{"Together", "[", RowBox[
                      {FractionBox[RowBox[{RowBox[{RowBox[{SubscriptBox[
                          "\[PartialD]", "eps"], "num"}], " ", "den"}], "-", 
                          RowBox[{"num", " ", RowBox[{SubscriptBox[
                          "\[PartialD]", "eps"], "den"}]}]}], SuperscriptBox[
                         "den", "2"]], "/.", "\[VeryThinSpace]", RowBox[
                        {"eps", "\[Rule]", "0"}]}], "]"}], "]"}]}], ";", 
               RowBox[{"record", "[", RowBox[
                  {"\"IndependentSchurDeterminantDerivative\"", ",", 
                   RowBox[{"zero", "[", RowBox[{"directSchur", "-", 
                       "PiReduced"}], "]"}]}], "]"}], ";", RowBox[
                {"onlyAA", "=", RowBox[{"Thread", "[", RowBox[
                    {RowBox[{"Flatten", "[", "PiMatrix", "]"}], "\[Rule]", 
                     RowBox[{"Flatten", "[", RowBox[{"Table", "[", RowBox[
                          {RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"i", 
                          "\[Equal]", "1"}], "&&", RowBox[{"j", "\[Equal]", 
                          "1"}]}], ",", "loopAA", ",", "0"}], "]"}], ",", 
                          RowBox[{"{", RowBox[{"i", ",", "5"}], "}"}], ",", 
                          RowBox[{"{", RowBox[{"j", ",", "5"}], "}"}]}], 
                         "]"}], "]"}]}], "]"}]}], ";", RowBox[{"record", "[", 
                 RowBox[
                  {"\"YMYMInsertionNeedsNoAuxiliaryHardLegCorrection\"", ",", 
                   RowBox[{"zero", "[", RowBox[{RowBox[{"{", RowBox[{"GR", 
                          ",", "GL"}], "}"}], "/.", "\[VeryThinSpace]", 
                       "onlyAA"}], "]"}]}], "]"}], ";", RowBox[{"Print", "[", 
                 "\"PiReduced = uL.Pi.uR; quantum hard-leg terms are required \
for general Pi.\"", "]"}], ";"}]], "Input", CellLabel -> "In[8]:=", 
            ExpressionUUID -> "c4e1921f-e02b-4eee-8e60-0f1f98324a1f"], 
           Cell[CellGroupData[{}, Open]]}, Open]], 
        Cell[CellGroupData[{Cell[BoxData[TagBox["deltaZR", 
              Function[BoxForm`e$, MatrixForm[BoxForm`e$]]]], "Input", 
            CellLabel -> "In[9]:=", ExpressionUUID -> 
             "a2affe0e-0930-4d54-8374-f33a4272f0d7"]}, Open]], 
        Cell[CellGroupData[
          {Cell["Which Ward relation contains the two-A source?", 
            "Subsection", ExpressionUUID -> 
             "a882c331-3290-43a8-9632-bf1c936d4bd0"], Cell["Differentiate \
Rxi(loop) Gamma_xi(tree) with respect to the hard A fields. At the stationary \
vacuum, the two-A source multiplies a zero xi tadpole in the three-point \
relation. Its first nonzero tree attachment is Gamma_xiA in a four-point \
relation.", "Text", ExpressionUUID -> 
             "a748226b-abbc-4497-a318-33d01bc8d3af"], 
           Cell[CellGroupData[{Cell[BoxData[RowBox[{RowBox[
                   {"sourcePolynomial", "=", RowBox[{"rr0", "+", RowBox[
                       {"rr1", " ", "xa"}], "+", RowBox[{"rr2", " ", "xb"}], 
                      "+", RowBox[{"rr3", " ", "xc"}], "+", RowBox[{"rr12", 
                        " ", "xa", " ", "xb"}], "+", RowBox[{"rr13", " ", 
                        "xa", " ", "xc"}], "+", RowBox[{"rr23", " ", "xb", 
                        " ", "xc"}]}]}], ";", RowBox[{"xiDerivative", "=", 
                    RowBox[{"tt0", "+", RowBox[{"tt1", " ", "xa"}], "+", 
                      RowBox[{"tt2", " ", "xb"}], "+", RowBox[{"tt3", " ", 
                        "xc"}], "+", RowBox[{"tt12", " ", "xa", " ", "xb"}], 
                      "+", RowBox[{"tt13", " ", "xa", " ", "xc"}], "+", 
                      RowBox[{"tt23", " ", "xb", " ", "xc"}], "+", RowBox[
                       {"tt123", " ", "xa", " ", "xb", " ", "xc"}]}]}], ";", 
                  RowBox[{"wardThree", "=", RowBox[{"Expand", "[", RowBox[
                       {RowBox[{SubscriptBox["\[PartialD]", RowBox[{"xa", 
                          ",", "xb"}]], RowBox[{"(", RowBox[
                          {"sourcePolynomial", " ", "xiDerivative"}], 
                          ")"}]}], "/.", "\[VeryThinSpace]", RowBox[{"{", 
                          RowBox[{RowBox[{"xa", "\[Rule]", "0"}], ",", 
                          RowBox[{"xb", "\[Rule]", "0"}], ",", RowBox[{"xc", 
                          "\[Rule]", "0"}]}], "}"}]}], "]"}]}], ";", 
                  RowBox[{"wardFour", "=", RowBox[{"Expand", "[", RowBox[
                       {RowBox[{SubscriptBox["\[PartialD]", RowBox[{"xa", 
                          ",", "xb", ",", "xc"}]], RowBox[{"(", RowBox[
                          {"sourcePolynomial", " ", "xiDerivative"}], 
                          ")"}]}], "/.", "\[VeryThinSpace]", RowBox[{"{", 
                          RowBox[{RowBox[{"xa", "\[Rule]", "0"}], ",", 
                          RowBox[{"xb", "\[Rule]", "0"}], ",", RowBox[{"xc", 
                          "\[Rule]", "0"}]}], "}"}]}], "]"}]}], ";", 
                  RowBox[{"record", "[", RowBox[
                     {"\"AASourceAbsentFromThreePointAtStationaryVacuum\"", 
                      ",", RowBox[{RowBox[{RowBox[{"Coefficient", "[", 
                          RowBox[{"wardThree", ",", "rr12"}], "]"}], "===", 
                          "tt0"}], "&&", RowBox[{"FreeQ", "[", RowBox[
                          {RowBox[{"wardThree", "/.", "\[VeryThinSpace]", 
                          RowBox[{"tt0", "\[Rule]", "0"}]}], ",", "rr12"}], 
                          "]"}]}]}], "]"}], ";", RowBox[{"record", "[", 
                    RowBox[{"\"AASourceFirstAttachesToXiAAtFourPoints\"", 
                      ",", RowBox[{RowBox[{RowBox[{"Coefficient", "[", 
                          RowBox[{"wardFour", ",", "rr12"}], "]"}], "===", 
                          "tt3"}], "&&", RowBox[{RowBox[{"Coefficient", "[", 
                          RowBox[{"wardFour", ",", "rr13"}], "]"}], "===", 
                          "tt2"}], "&&", RowBox[{RowBox[{"Coefficient", "[", 
                          RowBox[{"wardFour", ",", "rr23"}], "]"}], "===", 
                          "tt1"}]}]}], "]"}], ";"}]], "Input", CellLabel -> 
                "In[10]:=", ExpressionUUID -> 
                "43d71dcc-c266-4ca0-854f-f26a5cc46ab6"], Cell[CellGroupData[
                {}, Open]]}, Open]]}, Open]], 
        Cell[CellGroupData[{Cell["Fixed comparison parameters", "Subsection", 
            ExpressionUUID -> "988dc897-79ab-4422-9072-643c7e1701d8"], 
           Cell["Squared masses and virtualities are in GeV^2; mG4 is in \
GeV^4. This is a comparison point, not a new lattice fit.", "Text", 
            ExpressionUUID -> "b1713bb9-6823-4aea-9c7d-e057b6d7bde8"], 
           Cell[BoxData[RowBox[{RowBox[{"fixed", "=", RowBox[{"Association", 
                   "[", RowBox[{RowBox[{"\"m2\"", "\[Rule]", RowBox[{"-", 
                         "0.8254322989767313`"}]}], ",", RowBox[{"\"mu2\"", 
                       "\[Rule]", "1.9477145813064896`"}], ",", RowBox[
                      {"\"mG4\"", "\[Rule]", "2.0801942208358764`"}], ",", 
                     RowBox[{"\"MuR2\"", "\[Rule]", SuperscriptBox["3.61`", 
                        "2"]}], ",", RowBox[{"\"k2\"", "\[Rule]", RowBox[
                        {"-", FractionBox["1", "4"]}]}], ",", RowBox[
                      {"\"r2\"", "\[Rule]", RowBox[{"-", FractionBox["3", 
                          "4"]}]}], ",", RowBox[{"\"kDotR\"", "\[Rule]", 
                       "0"}], ",", RowBox[{"\"alpha\"", "\[Rule]", "1"}], 
                     ",", RowBox[{"\"CA\"", "\[Rule]", "3"}], ",", RowBox[
                      {"\"Nf\"", "\[Rule]", "2"}]}], "]"}]}], ";"}]], 
            "Input", CellLabel -> "In[11]:=", ExpressionUUID -> 
             "c0551330-4f29-4040-ae13-1949c555d0e8"]}, Open]]}, Open]], 
     Cell[CellGroupData[
       {Cell[
         "3 \[LongDash] Closed massless sectors and dimensional finite terms"\
, "Section", ExpressionUUID -> "f44e6a3b-9654-48b2-95fb-74138d93d903"], 
        Cell["Normalize the Ward coefficients by i gs t CA f, with t = \
gs^2/(16 pi^2). Keep D until finite extraction: c(4) I_fin \[Minus] 2 \
c\[Prime](4) I_pole. These cells recompute the scalar projections; they do \
not regenerate diagrams or independently repeat their earlier tensor checks."\
, "Text", ExpressionUUID -> "0e1918a1-307e-4f7d-8766-2484f49f6921"], 
        Cell[CellGroupData[{Cell[BoxData[RowBox[{RowBox[
                {RowBox[{"bubbleFinite", "[", "ss_", "]"}], ":=", 
                 RowBox[{"2", "-", RowBox[{"Log", "[", RowBox[{"-", 
                       FractionBox["ss", RowBox[{"fixed", "[", "\"MuR2\"", 
                          "]"}]]}], "]"}]}]}], ";", RowBox[{"fp", "=", 
                 FractionBox[RowBox[{RowBox[{RowBox[{"-", "3"}], " ", 
                      RowBox[{"pvB", "[", RowBox[{"-", FractionBox["3", 
                          "4"]}], "]"}]}], "+", RowBox[{"pvB", "[", 
                      RowBox[{"-", FractionBox["1", "4"]}], "]"}]}], 
                  RowBox[{"16", " ", RowBox[{"(", RowBox[{"dim", "-", "1"}], 
                      ")"}]}]]}], ";", RowBox[{"quark", "=", RowBox[
                  {"-", FractionBox[RowBox[{"2", " ", RowBox[{"(", RowBox[
                         {"dim", "-", "2"}], ")"}], " ", RowBox[{"(", 
                        RowBox[{RowBox[{RowBox[{"-", FractionBox["3", "4"]}], 
                          " ", RowBox[{"pvB", "[", RowBox[{"-", FractionBox[
                          "3", "4"]}], "]"}]}], "+", RowBox[{FractionBox["1", 
                          "4"], " ", RowBox[{"pvB", "[", RowBox[{"-", 
                          FractionBox["1", "4"]}], "]"}]}]}], ")"}]}], 
                    RowBox[{"3", " ", RowBox[{"(", RowBox[{"dim", "-", "1"}], 
                        ")"}]}]]}]}], ";", RowBox[{RowBox[{"finite", "[", 
                   "expr_", "]"}], ":=", RowBox[{"Module", "[", RowBox[
                    {RowBox[{"{", "pole", "}"}], ",", RowBox[{RowBox[{"pole", 
                         "=", RowBox[{"expr", "/.", "\[VeryThinSpace]", 
                          RowBox[{RowBox[{"pvB", "[", "_", "]"}], "\[Rule]", 
                          "1"}]}]}], ";", RowBox[{RowBox[{"(", RowBox[
                          {RowBox[{"expr", "/.", "\[VeryThinSpace]", RowBox[
                          {"dim", "\[Rule]", "4"}]}], "/.", 
                          "\[VeryThinSpace]", RowBox[{RowBox[{"pvB", "[", 
                          "v_", "]"}], "\[RuleDelayed]", RowBox[
                          {"bubbleFinite", "[", "v", "]"}]}]}], ")"}], "-", 
                         RowBox[{"2", " ", RowBox[{"(", RowBox[{RowBox[
                          {SubscriptBox["\[PartialD]", "dim"], "pole"}], 
                          "/.", "\[VeryThinSpace]", RowBox[{"dim", "\[Rule]", 
                          "4"}]}], ")"}]}]}]}]}], "]"}]}], ";", RowBox[
                {"fpValue", "=", RowBox[{"N", "[", RowBox[{RowBox[{"finite", 
                       "[", "fp", "]"}], ",", "16"}], "]"}]}], ";", RowBox[
                {"quarkValue", "=", RowBox[{"N", "[", RowBox[
                    {RowBox[{"finite", "[", "quark", "]"}], ",", "16"}], 
                   "]"}]}], ";", RowBox[{"closed", "=", RowBox[
                  {"Association", "[", RowBox[{RowBox[{"\"TwoFlavourQuark\"", 
                       "\[Rule]", "quarkValue"}], ",", RowBox[
                      {"\"PrincipalFP\"", "\[Rule]", "fpValue"}], ",", 
                     RowBox[{"\"ConstraintEta\"", "\[Rule]", "fpValue"}]}], 
                   "]"}]}], ";", RowBox[{"record", "[", RowBox[

Notebook[{Cell["RGZWorkflow 1.0.0 \[LongDash] Start Here", "Title"],
  Cell["Version 1.0.0. The default model includes eta ghosts and two \
dynamical quark flavours, with distinct-flavour massless external quarks. \
This notebook includes no computed results. Earlier probe-model checks do not \
validate the current model. Use a fresh Work directory.", "Text"],
  Cell["1 - FeynRules: export the actual model", "Section"],
  Cell["Run in a fresh kernel. Install FeynRules externally and set \
RGZ_FEYNRULES_DIRECTORY if needed. Keep FeynCalc in a separate kernel.",
   "Text"],
  Cell[BoxData[RowBox[{RowBox[{"project", "=",
        RowBox[{"ParentDirectory", "[", RowBox[{"NotebookDirectory", "[",
            "]"}], "]"}]}], ";", RowBox[{"Get", "[",
        RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{"project", ",",
              "\"RGZWorkflow.wl\""}], "}"}], "]"}], "]"}], ";"}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{"RGZReport", "[",
        RowBox[{"RGZInitialize", "[", RowBox[{RowBox[{"FileNameJoin", "[",
              RowBox[{"{", RowBox[{"project", ",", "\"Work\""}], "}"}],
              "]"}], ",", RowBox[{"\"Display\"", "\[Rule]",
              "\"Compact\""}]}], "]"}], "]"}], ";"}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{"FR$Parallel", "=", "False"}], ";",
      RowBox[{"RGZReport", "[", RowBox[{"RGZLoadFeynRules", "[", "]"}],
        "]"}], ";"}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{"RGZReport", "[",
        RowBox[{"RGZTreeBenchmark", "[", "60", "]"}], "]"}], ";"}]],
   "Input"],
  Cell[BoxData[RowBox[{RowBox[{"RGZReport", "[",
        RowBox[{"RGZExtractTree", "[", "300", "]"}], "]"}], ";"}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{"RGZReport", "[",
        RowBox[{"RGZExportVertices", "[", "300", "]"}], "]"}], ";"}]],
   "Input"],
  Cell[BoxData[RowBox[{RowBox[{"RGZReport", "[",
        RowBox[{"RGZExtraTreeAudit", "[", "120", "]"}], "]"}], ";"}]],
   "Input"],
  Cell[BoxData[RowBox[{RowBox[{"RGZReport", "[",
        RowBox[{"RGZOneLoopCoverage", "[", "300", "]"}], "]"}], ";"}]],
   "Input"], Cell["2 - Restart the kernel: FeynCalc and tree checks",
   "Section"], Cell["Quit the kernel using the menu, then reload below. The \
69-entry report covers the original mixed matrix and FP connections; it does \
not independently validate every free propagator. All vertices includes eta \
and quark interactions.", "Text"],
  Cell[BoxData[RowBox[{RowBox[{"project", "=",
        RowBox[{"ParentDirectory", "[", RowBox[{"NotebookDirectory", "[",
            "]"}], "]"}]}], ";", RowBox[{"Get", "[",
        RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{"project", ",",
              "\"RGZWorkflow.wl\""}], "}"}], "]"}], "]"}], ";"}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{"RGZReport", "[",
        RowBox[{"RGZInitialize", "[", RowBox[{RowBox[{"FileNameJoin", "[",
              RowBox[{"{", RowBox[{"project", ",", "\"Work\""}], "}"}],
              "]"}], ",", RowBox[{"\"Display\"", "\[Rule]",
              "\"Compact\""}]}], "]"}], "]"}], ";"}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{"RGZReport", "[",
        RowBox[{"RGZLoadFeynCalc", "[", "]"}], "]"}], ";"}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{"RGZReport", "[",
        RowBox[{"RGZCheckPropagators", "[", "300", "]"}], "]"}], ";"}]],
   "Input"],
  Cell[BoxData[RowBox[{RowBox[{"RGZReport", "[",
        RowBox[{"RGZCheckExtraPropagators", "[", "]"}], "]"}], ";",
      RowBox[{"RGZReport", "[", RowBox[{"RGZCheckOneLoopCoverage", "[",
          "]"}], "]"}], ";"}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{"RGZReport", "[",
        RowBox[{"RGZCheckVertices", "[", RowBox[{"60", ",",
            RowBox[{"\"IDs\"", "\[Rule]", "All"}]}], "]"}], "]"}], ";"}]],
   "Input"],
  Cell[BoxData[RowBox[{RowBox[{"RGZReport", "[",
        RowBox[{"RGZCheckOrders", "[", RowBox[{"60", ",",
            RowBox[{"\"IDs\"", "\[Rule]", "All"}], ",",
            RowBox[{"\"Mode\"", "\[Rule]", "\"Compare\""}]}], "]"}], "]"}],
      ";"}]], "Input"], Cell["3 - Complete mixed matrix", "Section"],
  Cell["This step may take a long time. Model enumeration includes bosons, \
all ghost families and two closed quark flavours. Do not add another eta \
loop. After interruption, reuse only completed checkpoints with matching \
fingerprints.", "Text"],
  Cell[BoxData[RowBox[{RowBox[{"RGZReport", "[",
        RowBox[{"RGZMonitor", "[", RowBox[{"RGZMixedComputeAll", "[",
            "12000", "]"}], "]"}], "]"}], ";"}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{"RGZReport", "[",
        RowBox[{"RGZMixedResult", "[", "1200", "]"}], "]"}], ";",
      RowBox[{"RGZReport", "[", RowBox[{"RGZSave", "[", "]"}], "]"}], ";"}]],
   "Input"], Cell["4 - Complete bare amplitude", "Section"],
  Cell["Continue only after all stages succeed. A bare amplitude alone is not \
a finite, verified S matrix.", "Text"],
  Cell[BoxData[RowBox[{RowBox[{"RGZReport", "[",
        RowBox[{"RGZQQStart", "[", RowBox[{"600", ",",
            RowBox[{"\"Gauge\"", "\[Rule]", "0"}], ",",
            RowBox[{"\"RegulatorMass\"", "\[Rule]", "0"}]}], "]"}], "]"}],
      ";"}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{"RGZReport", "[",
        RowBox[{"RGZQQPrepareSelf", "[", RowBox[{"1800", ",",
            RowBox[{"\"TotalSeconds\"", "\[Rule]", "3600"}]}], "]"}], "]"}],
      ";"}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{"RGZReport", "[",
        RowBox[{"RGZQQRunPart", "[", RowBox[{"\"AV1\"", ",", "1800"}], "]"}],
        "]"}], ";"}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{"RGZReport", "[",
        RowBox[{"RGZQQRunPart", "[", RowBox[{"\"AV2\"", ",", "1800"}], "]"}],
        "]"}], ";"}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{"RGZReport", "[",
        RowBox[{"RGZQQRunPart", "[", RowBox[{"\"Box1\"", ",", "1800"}],
          "]"}], "]"}], ";"}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{"RGZReport", "[",
        RowBox[{"RGZQQRunPart", "[", RowBox[{"\"Box2\"", ",", "1800"}],
          "]"}], "]"}], ";"}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{"RGZReport", "[",
        RowBox[{"RGZQQRunPart", "[", RowBox[{"\"NAV1\"", ",", "1800"}],
          "]"}], "]"}], ";"}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{"RGZReport", "[",
        RowBox[{"RGZQQRunPart", "[", RowBox[{"\"NAV2\"", ",", "1800"}],
          "]"}], "]"}], ";"}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{"qqSummary", "=",
        RowBox[{"RGZQQAmplitude", "[", "]"}]}], ";",
      RowBox[{"RGZReport", "[", "qqSummary", "]"}], ";",
      RowBox[{"If", "[", RowBox[{RowBox[{"!", RowBox[{"FailureQ", "[",
              "qqSummary", "]"}]}], ",", RowBox[{"qqResult", "=",
            RowBox[{"RGZResult", "[", "\"QQAmplitude\"", "]"}]}]}], "]"}],
      ";"}]], "Input"], Cell["5 - Tree and pure one-loop form factors",
   "Section"], Cell["Organize the D-dimensional color-spin structures first. \
Keep evanescent terms; do not remove them with four-dimensional Fierz \
identities. Successful reconstruction does not prove basis independence or \
minimality.", "Text"],
  Cell[BoxData[RowBox[{RowBox[{"RGZReport", "[",
        RowBox[{"RGZQQFormFactors", "[", RowBox[{"1200", ",",
            RowBox[{"\"LoopOrder\"", "\[Rule]", "0"}], ",",
            RowBox[{"\"CoefficientSeconds\"", "\[Rule]", "30"}]}], "]"}],
        "]"}], ";", RowBox[{"qqTreeFF", "=", RowBox[{"RGZResult", "[",
          "\"QQFormFactors\"", "]"}]}], ";"}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{"RGZReport", "[",
        RowBox[{"RGZQQFormFactors", "[", RowBox[{"1200", ",",
            RowBox[{"\"LoopOrder\"", "\[Rule]", "1"}], ",",
            RowBox[{"\"CoefficientSeconds\"", "\[Rule]", "30"}]}], "]"}],
        "]"}], ";", RowBox[{"qqOneLoopFF", "=",
        RowBox[{"RGZResult", "[", "\"QQFormFactors\"", "]"}]}], ";"}]],
   "Input"],
  Cell[BoxData[RowBox[{"If", "[",
      RowBox[{RowBox[{"AssociationQ", "[", "qqOneLoopFF", "]"}], ",",
        RowBox[{"KeyTake", "[", RowBox[{"qqOneLoopFF", ",",
            RowBox[{"{", RowBox[{"\"LoopOrder\"", ",",
                "\"ReconstructionVerified\"", ",",
                "\"SpinBasisIndependent\"", ",", "\"File\""}], "}"}]}],
          "]"}]}], "]"}]], "Input"],
  Cell["6 - General gauge difference for the current model", "Section"],
  Cell["Recompute this check without assuming a zero result. Compare symbolic \
alpha with reference gauge 1. See the documentation for parameter domains and \
IR prescriptions. Nonzero redundant coefficients, unreduced integrals and \
timeouts need further diagnosis.", "Text"],
  Cell[BoxData[RowBox[{RowBox[{"RGZReport", "[",
        RowBox[{"RGZQQGaugeStart", "[", "600", "]"}], "]"}], ";"}]],
   "Input"],
  Cell[BoxData[RowBox[{RowBox[{"RGZReport", "[",
        RowBox[{"RGZQQGaugePrepareSelf", "[", RowBox[{"1800", ",",
            RowBox[{"\"TotalSeconds\"", "\[Rule]", "3600"}]}], "]"}], "]"}],
      ";"}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{"RGZReport", "[",
        RowBox[{"RGZQQGaugeEarlyPrepare", "[", RowBox[{"600", ",",
            RowBox[{"\"ReferenceGauge\"", "\[Rule]", "1"}]}], "]"}], "]"}],
      ";"}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{"RGZReport", "[",
        RowBox[{"RGZQQGaugeEarlyCheck", "[", RowBox[{"12000", ",",
            RowBox[{"\"ReferenceGauge\"", "\[Rule]", "1"}], ",",
            RowBox[{"\"TensorSeconds\"", "\[Rule]", "600"}], ",",
            RowBox[{"\"CoefficientSeconds\"", "\[Rule]", "120"}], ",",
            RowBox[{"\"ReduceTensorIntegrals\"", "\[Rule]", "True"}]}],
          "]"}], "]"}], ";"}]], "Input"],
  Cell[BoxData[RowBox[{RowBox[{"gaugePacket", "=",
        RowBox[{"RGZResult", "[", "\"QQGaugeEarly\"", "]"}]}], ";",
      RowBox[{"gaugeFile", "=", RowBox[{"If", "[",
          RowBox[{RowBox[{"AssociationQ", "[", "gaugePacket", "]"}], ",",
            RowBox[{"Lookup", "[", RowBox[{"gaugePacket", ",", "\"File\"",
                ",", RowBox[{"Missing", "[", "\"NotComputed\"", "]"}]}],
              "]"}], ",", RowBox[{"Missing", "[", "\"NotComputed\"", "]"}]}],
          "]"}]}], ";"}]], "Input"],
  Cell["7 - Restore the fixed-gauge job and save", "Section"],
  Cell[BoxData[RowBox[{RowBox[{"RGZReport", "[",
        RowBox[{"RGZQQGaugeRestore", "[", "]"}], "]"}], ";",
      RowBox[{"RGZReport", "[", RowBox[{"RGZSave", "[", "]"}], "]"}], ";"}]],
   "Input"], Cell["The restore invalidates derived diagnostics. Keep \
gaugeFile and pass it explicitly to certification. Continue with section 3 of \
Diagnostics in this kernel, or save and restore the compatible fixed-gauge \
job. Rebuild UV/IR and MSbar after restoring. RGZSave saves a workflow packet \
rather than the entire kernel.", "Text"],
  Cell["8 - Author electronic reference", "Section"],
  Cell["This independently readable table is reference data. It does not \
certify this Work directory. See Paper/provenance.json and \
Documentation/Reproducibility.md.", "Text"],
  Cell[BoxData[RowBox[{RowBox[{"paperReference", "=",
        RowBox[{"RGZPaperResult", "[", "]"}]}], ";",
      RowBox[{"If", "[", RowBox[{RowBox[{"AssociationQ", "[",
            "paperReference", "]"}], ",", RowBox[{"KeyTake", "[",
            RowBox[{"paperReference", ",", RowBox[{"{", RowBox[{"\"Schema\"",
                  ",", "\"CheckedCoefficients\"", ",", "\"ReferenceOnly\"",
                  ",", "\"CurrentTaskCertified\""}], "}"}]}], "]"}], ",",
          "paperReference"}], "]"}]}]], "Input"]},
 StyleDefinitions -> "Default.nb", WindowTitle ->
  "RGZWorkflow \[LongDash] Start Here"]
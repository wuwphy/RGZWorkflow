(* Audit I/O compatibility. Deliberately outside Kernel: physical calculation
   sources and their fingerprint remain unchanged. No verification flag is set.
   Safe to load in an existing initialized FeynCalc kernel. *)
Begin["RGZWorkflow`Private`"];
$diagnosticsCompatibilitySHA256=FileHash[$InputFileName,"SHA256"];
qqDiagnosticsManifest[m_] := Module[{one,many},
 If[!AssociationQ[m],Return[m]];
 one=Lookup[m,"Record",Missing["Absent"]];many=Lookup[m,"Records",Missing["Absent"]];
 If[AssociationQ[one]&&AssociationQ[many]&&one=!=many,
  Return[Failure["ConflictingMatrixManifestRecords",<|"Action"->"Use an unmodified matrix_job.wl generated by this workflow."|>]]];
 If[AssociationQ[one],Join[m,<|"Records"->one|>],m]];
qqDiagnosticsFFPacketQ[p_] := Module[{file},
 If[TrueQ[qqFFPacketQ[p]],Return[True]];
 If[!AssociationQ[p]||!MemberQ[{"ScalarPVCollected","ScalarPVCollectedExactCoefficientsRetained"},Lookup[p,"Status",None]]||
 Lookup[p,"AlgorithmSHA256",None]=!=$scalarFFSourceSHA256||
 !ListQ[Lookup[p,"PVIdentities",None]]||!TrueQ[Lookup[p,"ReconstructionVerified",False]],Return[False]];
 file=Lookup[p,"SourceFormFactorsFile",None];
 StringQ[file]&&FileExistsQ[file]&&Lookup[p,"SourceFormFactorsSHA256",None]===FileHash[file,"SHA256"]&&
 TrueQ[qqFFPacketQ[Join[p,<|"Status"->"Complete"|>]]]];
qqDiagnosticsManifestGet[f_] := qqDiagnosticsManifest[Get[f]];
qqDiagnosticsWeightedRead[f_] := qqDiagnosticsManifest[qqWeightedRead[f]];
(* Save native definitions once, so reloading is idempotent. *)
If[!TrueQ[$diagnosticsCompatibilityInstalled],
 $diagnosticsMixedNative=DownValues[RGZWorkflow`RGZQQMixedUVIRLedger];
 $diagnosticsWeightedNative=DownValues[RGZWorkflow`RGZQQWeightedUVIRLedger];
 $diagnosticsFFReaderNative=DownValues[qqUVIRReadFF];
 $diagnosticsWeightedSourceSHA256=$weightedLedgerSHA256;
 $diagnosticsCompatibilityInstalled=True];
DownValues[RGZWorkflow`RGZQQMixedUVIRLedger]=$diagnosticsMixedNative/.
 HoldPattern[Get]->qqDiagnosticsManifestGet;
DownValues[RGZWorkflow`RGZQQWeightedUVIRLedger]=$diagnosticsWeightedNative/.
 HoldPattern[qqWeightedRead]->qqDiagnosticsWeightedRead;
DownValues[qqUVIRReadFF]=$diagnosticsFFReaderNative/.
 HoldPattern[qqFFPacketQ]->qqDiagnosticsFFPacketQ;
(* The weighted audit has its own versioned algorithm identity. Existing mass,
   scalar, finite and physical source identities are not relabelled. *)
$weightedLedgerSHA256=Hash[{$diagnosticsWeightedSourceSHA256,$diagnosticsCompatibilitySHA256},"SHA256"];
RGZWorkflow`RGZReport[x_] := Which[FailureQ[x],reportFailure[x],AssociationQ[x],
 Print[With[{summary=KeyTake[x,{"Status","Name","Schema","Dimensions","Rows","Statistics","File","LoopOrder","Mode","ReferenceGauge",
 "PTStatus","InvalidatedResults","KernelVersion","CalculationScope","FullNAVIncluded","Description","Scheme","Gauge","ClosedQuarkFlavors","ParameterCounterterms",
 "OutstandingChecks","MissingEvidence","RecordsAudited","GraphsAudited","SourceGraphCoverageVerified","AllWeightedTransfersZero","InputIntegralCount","OutputIntegralCount",
 "ScalarIntegralCounts","CoefficientTimeouts","ReconstructionVerified","PrimitivePoleChecks","FiniteAmplitudeEquivalenceVerified","FullSMatrixVerified"}]},
 If[Length[summary]>0,summary,<|"AvailableFields"->Keys[x]|>]]],True,Print["Result head: ",Head[x]]];
(* Notebook execution must be available even when the optional definition
   cell was skipped. This state controls UI sequencing, not physical proofs. *)
If[!AssociationQ[Global`rgzDiagnosticState],Global`rgzDiagnosticState=<||>];
SetAttributes[Global`rgzDiagnosticRun,HoldRest];
Global`rgzDiagnosticRun[name_,expression_,dependencies_List:{},accept_:(AssociationQ[#]&)]:=Module[{missing,r,ok},
 missing=Select[dependencies,!TrueQ[Lookup[Global`rgzDiagnosticState,#,False]]&];
 If[missing=!={},AssociateTo[Global`rgzDiagnosticState,name->False];
 r=Failure["DiagnosticPrerequisites",<|"Action"->"Complete the listed preceding cells before retrying.","Parts"->missing|>];RGZWorkflow`RGZReport[r];Return[r]];
 r=CheckAbort[expression,Failure["DiagnosticAborted",<|"Action"->"Rerun this cell to reuse completed checkpoints."|>]];
 ok=!FailureQ[r]&&TrueQ[accept[r]];AssociateTo[Global`rgzDiagnosticState,name->ok];RGZWorkflow`RGZReport[r];
 If[!ok&&!FailureQ[r],Print["This stage is incomplete; dependent cells remain blocked."]];r];

End[];
